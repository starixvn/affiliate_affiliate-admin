@{
    ViewBag.Title = Lang.AffiliateAdminLogin;
    Layout = "~/Views/Shared/_LayoutNoHeader.cshtml";
}

@model Fanex.AffiliateAdmin.Models.LoginViewModel

@section css{
    @Styles.Render("~/bundles/login")
}

@using (Html.BeginForm())
{
<div class="login">
    <div id="header">
    	<div class="logo">
        </div>
        <div class="seperator">
        </div>
    </div>
    
    <div id="container">
        <div class="panel">
            <div class="control-group">
                <div class="input-prepend">
                    @Html.TextBoxFor(m => m.Username, new { placeholder = "Username", @class = "span4"})
                </div>
            </div>
            <div class="control-group">
                <div class="input-prepend">
                    @Html.PasswordFor(m => m.Password, new { placeholder = "Password", @class = "span4" })
                </div>
            </div>
            <div class="control-group">
                <input class="btn btn-primary" type="button" id="btnlogin" value="Submit">
            </div>
        </div>
        <div class="browser">
            @Lang.BestViewIn
            <a target="_blank" href="http://www.microsoft.com/uk/windows/internet-explorer/default.aspx"><span class="ie">&nbsp;</span></a>
            <a target="_blank" href="http://www.mozilla.com/en-US/products/download.html"><span class="firefox">&nbsp;</span></a>
            <a target="_blank" href="https://www.google.com/intl/en/chrome/browser"><span class="chrome">&nbsp;</span></a>
        </div>
    </div>
</div>
}
@section scripts{    
    @Scripts.Render("~/bundles/loginJs")
}