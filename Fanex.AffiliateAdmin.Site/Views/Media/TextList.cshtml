@using Fanex.AffiliateAdmin.Models
@using Fanex.AffiliateAdmin.Core.Services.Impl
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Utilities
@{
    ViewBag.Title = Lang.TextList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model TextListViewModel
@section iconcss{
marketing-tools
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Media, 1, "media")
}
<div class="search-panel search-textList">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", "Information text", false, false)
    @using (Html.BeginForm("TextDataList", "Media", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {
        <div class="span12 search-form">
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    @Html.LabelFor(m => m.Currency, Lang.Category)
                    @Html.DropDownListFor(m => m.Category, Model.BannerCategoryOptionList, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.Currency, Lang.Language)
                    @Html.DropDownListFor(m => m.Language, Model.MemberSiteSupportedLanguageOptionList, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.Currency, Lang.Currency)
                    @Html.DropDownListFor(m => m.Currency, Model.PlayerCurrencyOptionList, new { @class = "width-140 dropdownchecklist single-select", @disabled = "disabled" })
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" class="btn btn-default" id="btnSubmit">
                        @Lang.Submit
                    </button>
                </div>
            </div>
        </div>
    }
</div>
<div id="gridId" class="freegrid content-grid">
</div>
@section scripts{
    <script type="text/javascript">
        var MSG = {
            AddText: "@Lang.AddText",
            EditText: "@Lang.EditText",
            InvalidText: "@Lang.InvalidText",
            DeleteTextMsg: "@Lang.DeleteTextMsg"
        };

        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.TextList",
                showButtonsWhenNoData: true,
                customButtons: '<input type="button" name="btnAdd" value="" title="@Lang.AddText" class="btnAdd icon-add-banner">'
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Content",
                    Width: 570,
                    Name: "Content",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return $('<div />').html(cell.Value).text();
                    }
                },
                { HeaderText: "@Lang.Category", Width: 70, Name: "Category", HeaderAlign: "center" },
                { HeaderText: "@Lang.Language", Width: 70, Name: "Language", HeaderAlign: "center" },
                { HeaderText: "@Lang.Currency", Width: 120, Name: "Currency", HeaderAlign: "center" },
                { HeaderText: "@Lang.TotalRequest", Width: 60, Name: "TotalRequest", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.LastRequest", Width: 90, Name: "LastRequestStr", HeaderAlign: "center", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Action",
                    Width: 70,
                    Name: "BannerID",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        var removeClass = 'icon-remove';

                        if (record.TotalRequest > 0) {
                            removeClass += ' icon-white';
                        }

                        return "<a href='javascript:TextList.editText({0})'><i class='icon-edit'></i></a>&nbsp;&nbsp;<a title='Remove' href='javascript:TextList.deleteText({0}, {1});'><i class='{2}'></i></a>".format(record.BannerID, record.TotalRequest, removeClass);
                    }
                }
            ],
            showPager: true,
            customPager: true,
            allowTruncate: true,
            gridExpandHeight: 360,
            indexNumberColumn: 0
        };

    </script>
    @Scripts.Render("~/scripts/textlist")
}
