<appSettings>
  <add key="CompanyIPRange" value="^(116\.193\.67\.(1(1[4-8]))|120\.72\.83\.(1(3[0-4])))$" />
  <add key="Layout" value="aoncash" />
  <add key="PiwikSiteId" value="16"/>
  <add key="PageSize" value="20"/>  
  <add key="DefaultLanguage" value="en-US" />
  <add key="AffiliateName" value="Aoncash"/>
  <add key="Environment" value="Production"/>
  <add key="TransferDay" value=""/> <!--nth day of month can transfer manually.-->
  <add key="TestMonthlyTransfer" value=""/> <!--0: disable monthly transfer; 1: enable monthly transfer-->
  <!--Used to determine which month is transfer, default value: 1 (last month). 0: Current month; 1: last month; 2: past 2nd month;-->
  <add key="PastNthMonth" value=""/>

  <add key="MaxImageSize" value="3000000"/>
  <add key="ThumbnailHeight" value="200"/>
  <add key="ThumbnailWidth" value="300"/>

  <add key="EmailHeaderBgColor" value="#a30003"/>
  <add key="EmailHeaderFontColor" value="#fff"/>
  <add key="EmailContentBgColor" value="#fff"/>
  <add key="EmailContentFontColor" value="#000"/>
  <add key="EmailCopyrightBgColor" value="#d7d7d7"/>
  <add key="EmailCopyrightFontColor" value="#333"/>
  <add key="EmailFooterBgColor" value="#a30003"/>
  <add key="EmailFooterFontColor" value="#eba6a6"/>

  <add key="ViewLogBackMonth" value="-3"/>
  <add key="LeftString" value="20"/>
  
  <!--Config Mail-->
  <add key="app_mail_id" value="9" />
  <add key="MailContact" value="alice.anastacia.ng@gmail.com"/>
  <!--End Config Mail-->
  
  <!--For hardcode undermaintenance format: dd MMM yyyy hh:mm PM or AM-->
  <add key="SkipCheckUMTime" value="0"/>
  <add key="UM_StartTime" value="01 May 2013 02:30 PM"/>
    <add key="UM_EndTime" value="02 Jun 2013 04:00 PM"/>

  <add key="SiteCheckerURL" value="http://anonym.to/?{0}"/>
  <add key="IPCheckerURL" value="http://anonym.to/?http://legacytools.dnsstuff.com/tools/ipall.ch?tool_id=67&amp;token=&amp;toolhandler_redirect=0&amp;ip={0}&amp;j=1"/>
  <add key="InternalURL" value="http://affiliate.aoncash.com"/>
  <add key="InternalURL_Kiosk" value="http://affiliate.aoncash.com"/>

  <!--RnG Casino-->
  <add key="IsDisableRngCasino" value="false" />
  <add key="CasinoNo" value="01" />
  <add key="LoggingServiceUrl" value="tcp://10.40.40.127:9099/LoggingService" />
  <!--End RnG Casino-->

  <!-- SSO -->
  <add key="SSOKeyPath" value="Integration/PrivateKey/12bet.snk" />
</appSettings>
