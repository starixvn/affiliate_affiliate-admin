@using Fanex.AffiliateAdmin.Core.Configurations
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>@ViewBag.Title</title>
        <link href="@Url.RenderLink(string.Format("~/www/dist/style/{0}/assets/static/favicon.jpg", AppSetting.Instance.Layout))" rel="shortcut icon" type="image/jpg" />
        <meta name="viewport" content="width=device-width" />
        <meta http-equiv="refresh" content="60" />
        @RenderSection("css", required: false)
    </head>
    <body>
        <!--content html-->
        @RenderBody()

        @Scripts.Render("~/bundles/headjs")
        @RenderSection("scripts", required: false)
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-93927620-2"></script>
        <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'UA-93927620-2');
        </script>
    </body>
</html>