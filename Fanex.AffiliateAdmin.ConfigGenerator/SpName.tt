<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ output extension=".txt" #>
<#@ import namespace="Fanex.AffiliateAdmin.ConfigGenerator.ConfigModelReaders" #>
<#@ parameter name="Site" type="Fanex.AffiliateAdmin.ConfigGenerator.ConfigModelReaders.SiteInfo" #>
<#
if(Site != null)
{
	var reader = new WebConfigModelReader 
				{
					Environment = Site.Environment,
					XmlFile = Host.ResolvePath(Site.WebConnectionStringModel)
				};
	reader.LoadXml();  
	var dbDict = reader.GetSettingsOfNode("connectionstrings");
#>
