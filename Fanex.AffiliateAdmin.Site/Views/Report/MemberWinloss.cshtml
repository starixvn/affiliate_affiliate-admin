@{
    ViewBag.Title = Lang.MemberWinloss;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section iconcss{
report
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Reports, 3, "Reports")
}

@{
    var now = SystemTimeService.GetSystemDateTime();
    var fromDate = Model.FromDate.HasValue ? Model.FromDate.Value : new DateTime(now.Year, now.Month, 1).AddMonths(-1);
    var toDate = Model.ToDate.HasValue ? Model.ToDate.Value : now;

    if (fromDate < AppSettings.SystemStartDate)
    {
        fromDate = AppSettings.SystemStartDate;
    }

    if (toDate < AppSettings.SystemStartDate)
    {
        toDate = AppSettings.SystemStartDate;
    }

    if (fromDate > now)
    {
        fromDate = new DateTime(now.Year, now.Month, 1).AddMonths(-1);
    }

    if (toDate > now)
    {
        toDate = now;
    }
}

@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Enumerations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Services
@model Fanex.AffiliateAdmin.Models.MemberWinlossViewModel
<div class="search-panel search-company-winloss">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", Common.GetReportInfo(ReportType.MemberWinLoss), false, true)
    @using (Html.BeginForm("MemberWinloss", "Report", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {            
        <div class="span12 search-form">
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="AffName" class="txt">@Lang.Affiliate</label>
                    @Html.TextBoxFor(m => m.AffName, new { @class = "form-control width-140", placeholder = Lang.All, maxlength = "100" })
                </div>
                <div class="cell">
                    <label for="AffTypes" class="txt">@Lang.AffType</label>
                    @Html.DropDownCheckList("AffTypes", Model.AffTypeOptionList, true, false, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="CommGroups" class="txt" title="@Lang.CommissionGroup">@Lang.CommGroup</label>
                    @Html.DropDownCheckList("CommGroups", Model.CommissionGroupOptionList, true, false, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="PreferLanguages" class="txt">@Lang.Language</label>
                    @Html.DropDownCheckList("PreferLanguages", Model.PreferLanguageOptionList, true, false, new { @class = "width-140" })
                </div>
            </div>
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="PlayerName" class="txt">@Lang.Member</label>
                    <input type="text" class="form-control width-140" id="PlayerName" name="PlayerName" placeholder="@Lang.All" maxlength="100"/>
                </div>
                <div class="cell">
                    <label for="GroupBy" class="txt">@Lang.GroupBy</label>
                    @Html.DropDownCheckList("GroupBy", Model.GroupByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="FromDate" class="txt">@Lang.From</label>
                    @Html.DatePicker("FromDate", fromDate, AppSettings.SystemStartDate, now, false)
                </div>
                <div class="cell">
                    <label for="ToDate" class="txt">@Lang.To</label>
                    @Html.DatePicker("ToDate", toDate, AppSettings.SystemStartDate, now, false)
                </div>
            </div>
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    <label for="PlayerCurrencies" class="txt">@Lang.Currency</label>
                    @Html.DropDownCheckList("PlayerCurrencies", Model.PlayerCurrencyOptionList, true, false, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.BaseCurrency</label>
                    @Html.DropDownCheckList("BaseCurrency", Model.BaseCurrencyOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.DrawFilter</label>
                    @Html.DropDownCheckList("DrawFilter", Model.DrawFilterOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="Products" class="txt">@Lang.Product</label>
                    @Html.DropDownCheckList("Products", Model.ProductOptionList, true, false, new { @class = "width-140" })
                </div>
                <div class="cell width-140">
                    @Html.CheckBoxFor(m => m.ExcludeTest)
                    <label for="ExcludeTest">
                        @Lang.ExcludeTestAccounts
                    </label>
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button id="btnSubmit" type="button" class="btn btn-default">@Lang.Submit</button>
                    <input type="hidden" name="ViewMode" id="ViewMode" value="@Model.ViewMode" />
                </div>
            </div>
        </div>
    }
</div>

<div id="gridId" class="freegrid" data-colheight="200" data-expheight="350" />

