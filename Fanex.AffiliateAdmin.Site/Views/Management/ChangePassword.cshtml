@using Fanex.AffiliateAdmin.Models

@{
    ViewBag.Title = Lang.ChangePassword;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@model Fanex.AffiliateAdmin.Models.PasswordViewModel

@using (Html.BeginForm("ChangePassword", "Management", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    <fieldset>
        <div class="clearfix"></div>
         <div class="control-group">
            <label class="control-label" for="Password">@Lang.Username</label>
            <div class="controls">
                <label class="label-text bold">
                    @Model.UserName
                </label>
            </div>
        </div>
         <div class="control-group">
            <label class="control-label" for="Password">@Lang.Password</label>
            <div class="controls">
                @Html.PasswordFor(m => m.Password)
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="LastName">@Lang.ConfirmPass</label>
            <div class="controls">
                @Html.PasswordFor(m => m.ConfirmPass, new { Name = "ConfirmPassword" })
            </div>
        </div>
         <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnSubmit" class="btn">@Lang.Submit</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </fieldset>
    @Html.HiddenFor(m => m.CustId)
    @Html.HiddenFor(m => m.UserName)
}
@section scripts{
    <script src="~/Scripts/site/UserManagement.js" type="text/javascript"></script>
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", null);
        </script>
    }
}