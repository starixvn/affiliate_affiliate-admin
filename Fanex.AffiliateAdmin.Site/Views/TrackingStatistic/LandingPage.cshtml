@{
    ViewBag.Title = Lang.LandingPages;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}

@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities

@model Fanex.AffiliateAdmin.Models.TrackingStatisticViewModel

@section iconcss{
    report
}

@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 5, string.Empty, 1)
    <div class="line line-statement">
        <div class="ic-open-window" title="@Lang.FullScreen"></div>
        <div class="ic-reload" title="@Lang.RefreshPage"></div>
    </div>
}

<div class="search-panel search-statement no-border">
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    <div class="span12 search-form">
        <div class="row-fluid row-form end-search">
            <div class="cell">
                @Html.LabelFor(m => m.CustomerPage, new { @class = "txt" })
                @Html.DropDownCheckList("CustomerPage", Model.CustomerPageListItem, true, true, new { @class = "width-140" })
            </div>
            <div class="cell">
                @Html.LabelFor(m => m.BaseLanguage, new { @class = "txt" })
                @Html.DropDownCheckList("BaseLanguage", new SelectList(AppSettings.AffSupportLanguages, "LanguageID", "LanguageName"), true, true, new { @class = "width-140" })
            </div>
            <div class="cell width-140">
                @Html.LabelFor(m => m.FromDate)
                @Html.DatePicker("FromDate", new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1), AppSettings.SystemStartDate, DateTime.Now)
            </div>
            <div class="cell width-140">
                @Html.LabelFor(m => m.ToDate)
                @Html.DatePicker("ToDate", DateTime.Now, AppSettings.SystemStartDate, DateTime.Now)
            </div>
        </div>
        <div class="row-fluid row-form btn-action">
            <div class="span12">
                <button type="submit" class="btn" id="btnSubmit">
                    @Lang.Submit
                </button>
            </div>
        </div>
    </div>
</div>
<div class="w-space"></div>

<div id="gridId" class="freegrid" colheight="200" expheight="350"></div>

@section scripts{
    <script type="text/javascript">
        var MSG = {
            NoInfo: "@Lang.NoInfo",
            Title: "@Lang.LandingPagesStatistics",
            LandingPagesStatisticDetails: "@Lang.LandingPagesStatisticDetails",
            ReferrersStatisticDetails: "@Lang.ReferrersStatisticDetails"
        };

        var gridOption = {
            columns: [
                        { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                        { HeaderText: "@Lang.Page", Width: 230, Name: "SportCode", HeaderAlign: "center", 
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return "<a href=\"javascript:STATISTIC.showLandingPageDetail('{0}', '{1}')\">{0}</a>".format(rowData.SportCode, rowData.LanguageCode);
                            }
                        },
                        { HeaderText: "@Lang.Language", Width: 155, Name: "LanguageName", HeaderAlign: "center" },
                        { HeaderText: "@Lang.TotalClicks", Width: 130, Name: "TotalClick", HeaderAlign: "center", CellAlign: "right" },
                        { HeaderText: "@Lang.UniqueClicks", Width: 130, Name: "UniqueClick", HeaderAlign: "center", CellAlign: "right" },
                        { HeaderText: "@Lang.Signups", Width: 130, Name: "Signups", HeaderAlign: "center", CellAlign: "right" },
                        { HeaderText: "@Lang.FDM", Width: 130, Name: "FDM", HeaderAlign: "center", CellAlign: "right" }
                   ],
            gridExpandHeight: 290,
            showNumberColumn: true,
            showTitle: true,
            titleInfo:
            {
                text: "@Lang.LandingPagesStatistics"
            }
        }
    </script>
    <script src="@Url.Content("~/Scripts/site/TrackingStatistic.js")" type="text/javascript"></script>
}