@{
    ViewBag.Title = Lang.ChangeAccountType;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Models 
@model Fanex.AffiliateAdmin.Models.ChangeAccountTypeViewModel

@using (Html.BeginForm("ChangeAccountType", "Affiliate", FormMethod.Post, new { @class = "form-horizontal" }))
{
     @Html.ValidationSummary()
     @Html.HiddenFor(m => m.AffIds)
     @Html.HiddenFor(m => m.Usernames)
    <fieldset>
        <legend>@Lang.Assignee</legend>
        <div class="row-fluid">
            <div class="controls-row" style="word-wrap: break-word; display: inline-block; padding: 4px 6px;">
                @Model.Usernames
            </div>
        </div>
    </fieldset>
    <fieldset>
        <legend>@Lang.AccountType</legend>
        <div class="row-fluid">
            <div class="controls-row span4" style="display: inline-block; padding: 4px 6px;">
                @Lang.AccountType
            </div>
            <div class="bold">
                @Html.DropDownCheckList("TestLevel", Model.AccountTypeOptionList, false, false)
            </div>
        </div>
    </fieldset>
    <div class="popup-footer">
        <div class="row-fluid">
            <button type="submit" id="btnUpdate" class="btn">@Lang.Update</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
        </div>
    </div>
}

@section scripts{
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel) ViewBag.Result;
        <script type="text/javascript">
            if(top.location.href.toLowerCase().indexOf("affiliateinfo") >= 0)
            {
                AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", top.document.getElementById("ifAffInfo").contentWindow.location.reload(false));
            } else {
                AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.AffiliateList.ReRenderAfterPaged);
            }
        </script>
    }
}

