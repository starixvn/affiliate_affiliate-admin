@using Fanex.AffiliateAdmin.Core.Configurations
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="@Url.Content(string.Format("~/Content/_Sites/{0}/images/favicon.jpg?{1}", AppSettings.Layout, DateTime.Now.Ticks))" rel="shortcut icon" type="image/jpg" />
    <meta name="viewport" content="width=device-width" />
    @Styles.Render("~/bundles/css")
    @RenderSection("css", required: false)
    @Scripts.Render("~/bundles/jquery")
    @StackExchange.Profiling.MiniProfiler.RenderIncludes()
</head>
<body>
    
    <div class="container">
        <div class="row-fulid">
            @Html.Partial("_Header")
            <div class="span12 content">
                <!--Submenu box-->
                <div class="row-fluid submenu">
                    <div class="span12 menu">
                        <div class="span1 icon-submenu @RenderSection("iconcss", required: false)">
                        </div>
                        @RenderSection("submenu", required: false)
                    </div>
                </div>
                <!--content html-->
                <div class="row-fluid main-content">
                    <div class="span12">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/js")

    <script type="text/javascript">
        var System = {
            Currency: '@AppSettings.BaseExchange.Code',
            Prefix: '@AppSettings.BaseExchange.Prefix',
            CurrencyId: '@AppSettings.BaseExchange.ExchangeID'
        };

        var Lang = {
            NoDataInfo: '@Html.Raw(Lang.NoInfo)',
            SubTotal: '@Lang.SubTotal',
            Total: '@Lang.Total',
            TotalBaseCurrency: '@Lang.Total (@AppSettings.BaseExchange.Prefix)',
            All: "@Lang.All",
            Uncheck: "@Lang.Uncheck",
            Selected: "@Lang.Selected",
            SelectAnOption: "@Lang.SelectAnOption",
            ChangePassword: "@Lang.ChangePassword",
            CollapseExpandDataRows: "@Lang.CollapseExpandDataRows",
            Close: "@Lang.Close"
        };

        var piwikSiteId = '@AppSettings.PiwikSiteId';

        $(document).ready(function () {
            $.unblockUI();
            
            AFFILIATE.getAbsoluteUrl = function (relativeUrl) {
                return '@Url.Content("~/")' + relativeUrl;
            };

            AFFILIATE.baseUrl = '@Url.Content("~/")';

            AFFILIATE.TimeZone = '@AppSettings.ServerTimeZone';
        });

        var _paq = _paq || [];
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function () {
            var u = "https://pw.detecas.com/";
            _paq.push(['setTrackerUrl', u + 'piwik.php']);
            _paq.push(['setSiteId', piwikSiteId]);            
            var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
            g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
        })();

    </script>    

    <noscript><p><img src="https://pw.detecas.com/piwik.php?idsite=@(AppSettings.PiwikSiteId)'  style="border:0;" alt="" /></p></noscript>

    @RenderSection("scripts", required: false)  
</body>
</html>
