@{
    ViewBag.Title = Lang.Statistics;
    Layout = null;
}
@using System.Globalization
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Services

@model Fanex.AffiliateAdmin.Models.AffiliateStatisticViewModel

@{
    var now = SystemTimeService.GetSystemDateTime();
    var lastDay = Model.FullDateTime.AddMonths(1).AddDays(-1);
    var fromDate = Model.FullDateTime > AppSettings.SystemStartDate ? Model.FullDateTime.ToString("MMM dd yyyy", CultureInfo.InvariantCulture) : AppSettings.SystemStartDate.ToString("MMM dd yyyy", CultureInfo.InvariantCulture);
    var toDate = lastDay < now ? lastDay.ToString("MMM dd yyyy", CultureInfo.InvariantCulture) : now.ToString("MMM dd yyyy", CultureInfo.InvariantCulture);
}

<table id="top_panel" class="top_panel">
    <colgroup>
        <col style="width: 40%;"/>
        <col style="width: 30%;" />
        <col style="width: 30%;" />
    </colgroup>
    <thead>
        <tr>
            <td class="top_colexp"><span id="spStatistic" class="statistic-show"></span>@Lang.Statistics</td>
            <td class="col-data">
                @Html.MonthPicker("monthyear", Model.FullDateTime, AppSettings.SystemStartDate, now, new { @class = "width-ex-90" })
            </td>
            <td class="col-data">@Lang.UpToNow</td>
        </tr>
    </thead>
    <tbody id="stContent">
        <tr>
            <td class="col-label">@Lang.NewSignup/@Lang.FDM</td>
            <td class="col-data">
                @Html.ActionLink(Model.Statistic.NewSignUp.ToString(), "MemberListByAffiliate", "Affiliate", new { DateOption = 1, FromDate = fromDate, ToDate = toDate, TimeStamp = now.Ticks }, new { @class = "link" })/@Html.ActionLink(Model.Statistic.NewSignUpDep.ToString(), "MemberListByAffiliate", "Affiliate", new { DateOption = 2, FromDate = fromDate, ToDate = toDate, TimeStamp = DateTime.Now.Ticks }, new { @class = "link" })
            </td>
            <td class="col-data">
                @Html.ActionLink(Model.Statistic.TotalPlayer.ToString(), "MemberListByAffiliate", "Affiliate", new { DateOption = 0, TimeStamp = now.Ticks }, new { @class = "link" })/@Model.Statistic.TotalPlayerDepUp
            </td>
        </tr>
        @if (Model.Statistic.TotalActivePlayer != 0 && Model.FullDateTime.CompareTo(AppSettings.SystemStartDate) >= 0)
        {
        <tr>
            <td class="col-label">@Lang.TotalActive</td>
            <td class="col-data">
                @Html.ActionLink(Model.Statistic.TotalActivePlayer.ToString(), "MemberWinlossByAffiliate", "Report", new { GroupBy = 1, FromDate = fromDate, ToDate = toDate, BaseCurrency = 2, TimeStamp = now.Ticks  }, new { @class = "link" })
            </td>
            <td class="col-data">@Lang.NotAvaliable</td>
        </tr>
        }
        @if (Model.Products.Any())
        {
        <tr>
            <td class="col-label">@Lang.TotalQualifiedMembers
                (<span class="link-box-active nopadding" id="spProduct">@Model.Products.FirstOrDefault().ProductName</span><select id="slProduct" name="slProduct" style="display: none;" class="width-ex-100 nopadding">
                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.ProductName" data-qualified="@product.TotalQualifiedMembers" data-product="@product.ProductID">@product.ProductName</option>
                    }
                </select>)
            </td>
            <td class="col-data" id="dataqualified">
                @{
                    const string hideClass = "class='qm hidden'";
                    const string noHideClass = "class='qm'";
                }
                <a @Html.Raw(Model.Products.FirstOrDefault().TotalQualifiedMembers > 0 ? noHideClass : hideClass) href="javascript:void(0)" data-date="@Model.FullDateTime.ToString("MMM yyyy", CultureInfo.InvariantCulture)" 
                   data-affid="@Model.AffId" data-affname="@Model.AffName"  data-basecurrency="2" 
                   data-currency="@Model.AffCurrency"  data-product="@Model.Products.FirstOrDefault().ProductID" 
                   data-groupid="@Model.CommGroupInfo.GroupID" data-commgroup="@Model.CommGroupInfo.GroupName">
                    @Model.Products.FirstOrDefault().TotalQualifiedMembers
                </a>
                <span @Html.Raw(Model.Products.FirstOrDefault().TotalQualifiedMembers > 0 ? hideClass : noHideClass)>0</span>
            </td>
            <td class="col-data">@Lang.NotAvaliable</td>
        </tr>
        }
        <tr>
            <td class="col-label">@Lang.TotalDeposit</td>
            <td class="col-data">
                @Html.ActionLinkForRawLinkText(FormaterCurrency.Format(Model.Statistic.TotalDeposit), "MemberWinlossByAffiliate", "Report", new { GroupBy = 0, FromDate = fromDate, ToDate = toDate, BaseCurrency = 2, TimeStamp = now.Ticks  }, new { @class = "link" })
            </td>
            <td class="col-data">@MvcHtmlString.Create(FormaterCurrency.Format(Model.Statistic.TotalDepositUp))</td>
        </tr>
        <tr>
            <td class="col-label">@Lang.TotalTurnover</td>
            <td class="col-data">
                @Html.ActionLinkForRawLinkText(FormaterCurrency.Format(Model.Statistic.TotalTurnover), "MemberWinlossByAffiliate", "Report", new { GroupBy = 0, FromDate = fromDate, ToDate = toDate, BaseCurrency = 2, TimeStamp = now.Ticks  }, new { @class = "link" })
            </td>
            <td class="col-data">@MvcHtmlString.Create(FormaterCurrency.Format(Model.Statistic.TotalTurnoverUp))</td>
        </tr>
        <tr>
            <td class="col-label">@Lang.TotalWinlost</td>
            <td class="col-data">
                <a href="@Url.Action("MemberWinlossByAffiliate", "Report", new { GroupBy = 0, FromDate = fromDate, ToDate = toDate, BaseCurrency = 2, TimeStamp = now.Ticks  })" class="link">@Html.Raw(FormaterCurrency.Format(Model.Statistic.TotalWinlost))</a>
            </td>
            <td class="col-data">@Html.Raw(FormaterCurrency.Format(Model.Statistic.TotalWinlostUp))</td>
        </tr>
        <tr>
            <td class="col-label">@Lang.TrackingRate</td>
            <td class="col-data">
                @Html.ActionLink(Model.Statistic.TotalUniqueClicks.ToString(), "Referrer", "TrackingStatistic", new { FromDate = fromDate, ToDate = toDate, TimeStamp = now.Ticks }, new { @class = "link" })/@Html.ActionLink(Model.Statistic.TotalClicks.ToString(), "Referrer", "TrackingStatistic", new { FromDate = fromDate, ToDate = toDate, TimeStamp = DateTime.Now.Ticks }, new { @class = "link" })
            </td>
            <td class="col-data">@Lang.NotAvaliable</td>
        </tr>
    </tbody>
</table>