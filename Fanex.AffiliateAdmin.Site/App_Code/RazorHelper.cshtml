}
@helper RenderDatePicker(DateTime date, DateTime minDate, DateTime maxDate, string id = "FromDate",
    string className = "", int inputWidth = 3)
    {
        var url = new System.Web.Mvc.UrlHelper(Context.Request.RequestContext);
    <div class="date-picker-wrapper span@(inputWidth) filter-input">
        <input type="text" readonly="readonly" data-original="@date.ToString("MM/dd/yyyy")" name="@(id)" id="@(id)" class="@(className)" />
        <script type="text/javascript">
            var langDatePicker = {
                Today: "@Lang.Today",
                Yesterday: "@Lang.Yesterday",
                Currentweek: "Current Week",
                Lastweek: "Last Week",
                Currentmonth: "Current month",
                Lastmonth: "Last month",
                Sincelastmonth: "Since last month",
                SpecificDate: "SpecificDate",
                DateRange: "DateRange",
                Fromdate: "Fromdate",
                Todate: "Todate",
                Next: "Next",
                Prev: "Prev",
                OK: "OK",
                EndDate: "EndDate"
            };

            $(document).ready(function () {
                var monthShort = ['@Lang.Jan', '@Lang.Feb', '@Lang.Mar', '@Lang.Apr', '@Lang.May', '@Lang.Jun', '@Lang.Jul', '@Lang.Aug', '@Lang.Sep', '@Lang.Oct', '@Lang.Nov', '@Lang.Dec']
                var dayMin = ['@Lang.Su', '@Lang.Mo', '@Lang.Tu', '@Lang.We', '@Lang.Th', '@Lang.Fr', '@Lang.Sa'];

                $("#@(id)").datepicker({
                    showOn: "both",
                    buttonImage: '@url.Content("~/Content/Themes/Theme1/images/calendar.gif")',
                    buttonText: "Show Date Picker",
                    buttonImageOnly: true,
                    showOtherMonths: true,
                    changeMonth: true,
                    changeYear: true,
                    selectOtherMonths: true,
                    closeText: 'OK',
                    dateFormat: 'mm/dd/yy',
                    monthNamesShort: monthShort,
                    dayNamesMin: dayMin,
                    minDate: '@(minDate.ToString("MM/dd/yyyy"))',
                    maxDate: '@(maxDate.ToString("MM/dd/yyyy"))'
                });
                $('#@(id)').datepicker('setDate', '@(date.ToString("MM/dd/yyyy"))');
            });
        </script>
    </div>

}
@helper ListPopupMenu(List<Menu> list, int selectedMenu, IDictionary<string, object> queryStrings = null)
    {
        var url = new System.Web.Mvc.UrlHelper(Context.Request.RequestContext);
        string queryUrl = string.Empty;

        if (queryStrings != null)
        {
            foreach (var queryItem in queryStrings)
            {
                if (!string.IsNullOrEmpty(queryUrl))
                {
                    queryUrl += "&";
                }
                else
                {
                    queryUrl += "?";
                }
                queryUrl += string.Format("{0}={1}", queryItem.Key, queryItem.Value);
            }
        }
    <div class="popmenu menu">
        <ul>
            @for (var i = 0; i < list.Count; i++)
            {
                var item = list[i];
                string activeText = (i == selectedMenu ? "class=\"popcurrent\"" : string.Empty);
                <li @(new HtmlString(activeText))><a href="@(url.Content(item.Link + queryUrl))"><span>@item.Text</span></a></li>
            }
        </ul>
    </div>
}
@helper SearchPanel(string contentSelector, string information, bool hasExport = true, bool hasInfo = true)
    {
    <div class="span12 search-title" data-selector="@contentSelector"  title="@Lang.CollapseExpand">
        <div class="expand collapse">&nbsp;</div><label>@Lang.Search</label>
        <div class="more">
        @if (hasExport)
        {
            <span id="excel" title="Export Excel" class="excel"></span>
        }
        @if (hasInfo)
        {
            <span id="info" title="Information" class="info"></span>
        }
        </div>
        <div id="info-dialog">
            <p id="info-close">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>
            @MvcHtmlString.Create(information)
        </div>
    </div>
}

@helper FormatCurrencyNumber(decimal number, int dec = 2)
    {
        if (number < 0)
        {
            <span style="color: red">
                (@decimal.Round(number, dec))
            </span>
        }
        else
        {
            decimal.Round(number, dec).ToString();
        }
}
@helper GetAffiiateStatus(string status)
    {
        if (status.Equals(AffiliateStatus.Disapproved.ToString(), StringComparison.CurrentCultureIgnoreCase))
        {
            @Lang.Disapproved
        }
        else
        {
            @Lang.Pending
        }
}
