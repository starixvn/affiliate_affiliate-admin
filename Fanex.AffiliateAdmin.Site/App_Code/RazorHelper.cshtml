@helper GetMoreUrls(string moreSiteUrls)
    {
        if (!string.IsNullOrEmpty(moreSiteUrls))
        {
            var lastIndex = moreSiteUrls.Length - 1;

            moreSiteUrls = (moreSiteUrls.LastIndexOf(';') == lastIndex) ? moreSiteUrls.Remove(lastIndex) : moreSiteUrls;

            var sites = moreSiteUrls.Split(';');

            for (int index = 0; index < sites.Count(); index++)
            {
                <tr id="site_@(index + 2)">
                    <td><label class = "control-label" for="Affiliate_SiteURL_@(index + 2)">@(Lang.SiteUrl + " " + (index + 2).ToString())</label></td>
                    <td></td>
                    <td><input type="text" class="sites more-site control-text valid" id="Affiliate_SiteURL_@(index + 2)" value="@sites[index]" /></td>
                     <td><button type="button" class="btn btn-default" onclick="AFFEDIT.delUrl(this);" style="vertical-align: top">@Lang.Delete</button></td>
                </tr>
            }
        }        
}
