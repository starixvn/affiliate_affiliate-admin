@using Fanex.AffiliateAdmin.Core.Enumerations
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Models
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@model AffiliateCommissionViewModel
@{
    ViewBag.Title = Lang.AffiliateCommission;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section iconcss{
report
}

@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Reports, 4, "report")
}

@{
    var now = DateTime.Now;
}

<div class="search-panel search-processing-commission">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", Common.GetReportInfo(ReportType.AffiliateCommission), false, true)
    @using (Html.BeginForm("AffiliateCommission", "Report", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {
        <div class="span12 search-form">
            <div class="row-fluid row-form">
                <div class="cell">
                    @Html.LabelFor(m => m.Username, new {@class = "txt"})
                    <input type="text" placeholder="All" name="AffName" maxlength="100" id="Username" class="width-140">
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.AffType, new { @class = "txt", @for = "AffTypes"})
                    
                    @Html.DropDownCheckList("AffTypes", new SelectList(AppSettings.AffTypes, "TypeID", "Name"), true, true, new {@class = "width-140"})
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.CommGroup, new { @class = "txt", @for = "CommGroups" })
                    @Html.DropDownCheckList("CommGroups", Model.CommissionGroupOptionList, true, true, new {@class = "width-140"})
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.Language, new { @class = "txt", @for = "PreferLanguages" })
                    @Html.DropDownCheckList("PreferLanguages", Model.PreferLanguageOptionList, true, true, new {@class = "width-140"})
                </div>
            </div>
            <div class="row-fluid row-form">
                <div class="cell">
                    @Html.LabelFor(m => m.Currency, new { @class = "txt", @for = "Currencies" })
                    @Html.DropDownCheckList("Currencies", Model.AffiliateCurrencyOptionList, true, true, new {@class = "width-140"})
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.BaseCurrency, new {@class = "txt"})
                    @Html.DropDownCheckList("BaseCurrency", Model.BaseCurrencyOptionList, false, false, new {@class = "width-140"})
                </div>
                <div class="cell">
                    <label for="SortBy" class="txt">@Lang.SortBy</label>
                    @Html.DropDownCheckList("SortBy", Model.SortByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="Products" class="txt">@Lang.Product</label>
                    @Html.DropDownCheckList("Products", Model.ProductOptionList, true, false, new { @class = "width-140" })
                </div>
                <div class="cell checkbox width-160">
                    @Html.CheckBoxFor(m => m.ExcludeTest)
                    @Html.LabelFor(m => m.ExcludeTest)
                </div>
            </div>
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    @Html.LabelFor(m => m.TransferStatus, new { @class = "txt", @for = "TransferStatus" })
                    @Html.DropDownCheckList("TransferStatus", Model.TransferStatusOptionList, false, false, new { @class = "width-140" })
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.GroupBy, new {@class = "txt"})
                    @Html.DropDownCheckList("GroupBy", Model.GroupByOptionList, false, false, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="FromDate" class="txt">@Lang.From</label>
                    @*@Html.MonthPicker("FromDate", now, AppSettings.SystemStartDate, now, false)*@
                    @Html.MonthPicker("FromDate", new DateTime(2014, 1, 1), AppSettings.SystemStartDate, now, false)
                </div>
                <div class="cell">
                    <label for="ToDate" class="txt">@Lang.To</label>
                    @*@Html.MonthPicker("ToDate", now, AppSettings.SystemStartDate, now, false)*@
                    @Html.MonthPicker("ToDate", new DateTime(2014, 3, 1), AppSettings.SystemStartDate, now, false)
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" class="btn" id="btnSubmit">
                        @Lang.Submit
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<div id="gridId" class="freegrid">
</div>
@section scripts{
    <script type="text/javascript">
        var MSG = {
            ActivePlayers: "@Lang.ActiveMembers",
            BetCount: "@Lang.BetCount",
            Turnover: "@Lang.Turnover",
            NetWinloss: "@Lang.NetWinloss",
            Commission: "@Lang.Commission",
            SubTotalIn: "@Lang.SubTotalIn",
            Total: "@Lang.Total",
            TotalAll: "@Lang.TotalAll",
            Sportsbook: "@Lang.Sportsbook",
            NumberGame: "@Lang.NumberGame",
            LiveCasino: "@Lang.LiveCasino",
            RNGCasino: "@Lang.RNGCasino",
            PlaytechCasino: "@Lang.PlaytechCasino",
            VirtualSport: "@Lang.VirtualSport",
            SubTotal: "@Lang.SubTotal",
            CommPercent: "@Lang.CommPercent",
            QM: "@Lang.QM",
            CommGroupSettingFor: "@Lang.CommGroupSettingFor",
            AffQualifiedMemReportDetailFor: "@Html.Raw(Lang.AffQualifiedMemReportDetailFor)",
            Currency: "@Lang.Currency",
            Cashback: "@Lang.Cashback",
            DeductionPercent: "@Lang.DeductionPercent",
            Amount: "@Lang.Amount",
            CommissionTitle: "@Lang.Commission",
            DoYouWantToTransferAll: "@Lang.DoYouWantToTransferAll",
            CommissionGroup: "@Lang.CommGroup",
            AffiliateCommissionTitle: "@Lang.AffiliateCommission",
            OccurMonthlyTransferError: "@Lang.OccurMonthlyTransferError",
            ChooseAtLeastOneProduct: '@Lang.ChooseAtLeastOneProduct',
            QualifiedMembers: "@Lang.QualifiedMembers"
            
        };

        var PRODUCTS = @(Html.Raw(ViewBag.Products));

        var sampleGridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.AffiliateCommission"
            },
            groupHeaderRows: [
                {
                    Columns: [
                        { HeaderText: "#", Name: "No", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Affiliate", Name: "Username", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Month", Name: "WinlostDate", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.CommGroup", Name: "GroupName", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Currency", Name: "Currency", MergeRowNumber: 2 }
                    ]
                }
            ],
            columns: [
                { HeaderText: "#", Width: 40, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Affiliate", Width: 80, Name: "Username", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Month", Width: 80, Name: "WinlostDate", HeaderAlign: "center", CellAlign: "center", FormatDateTime: AFFILIATE.DATE_FORMAT_MONTH },
                {
                    HeaderText: "@Lang.CommGroup",
                    Width: 90,
                    Name: "GroupName",
                    HeaderAlign: "center",
                    CellAlign: "left",
                    Formatter: function(rIndex, record) {
                        return '<a href="javascript:void(0)" data-groupid={0} data-date="{1}" class="commgroup">{2}</a>'.format(record.GroupID, moment(record.WinlostDate).format(AFFILIATE.DATE_FORMAT_MONTH), record.GroupName);
                    }
                },
                { HeaderText: "@Lang.Currency", Width: 90, Name: "Currency", HeaderAlign: "center", CellAlign: "center" }
            ],
            allowTruncate: true,
            gridExpandHeight: 360,
            customizeHeader: true,
            indexNumberColumn: 0
        };

        var totalPaymentHeader = { HeaderCaption: "@Lang.TotalPayment", HeaderText: "@Lang.TotalPayment", IsCurrency: true, Name: "Commission", NameCache: "Commission", MergeRowNumber: 2 };
        
        var totalPaymentCol = { HeaderCaption: "@Lang.TotalPayment", HeaderText: "@Lang.TotalPayment", IsCurrency: true, Width: 110, Name: "Commission", NameCache: "Commission", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)', IsAbs: true };
        
        var samplePShareCol = { 
            HeaderCaption: "<span title='@Lang.ProgressiveShare'>@Lang.PShare</span>", 
            HeaderText: "<span title='@Lang.ProgressiveShare'>@Lang.PShare</span>", 
            IsCurrency: true, Width: 110, Name: "PShare", NameCache: "PShare", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)',  IsAbs: true };
        var samplePWinCol= { 
            HeaderCaption: "<span title='@Lang.ProgressiveWin'>@Lang.PWin</span>", 
            HeaderText: "<span title='@Lang.ProgressiveWin'>@Lang.PWin</span>", 
            IsCurrency: true, Width: 110, Name: "PWin", NameCache: "PWin", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)',  IsAbs: true };
        var sampleNetGamingCol = { 
            HeaderCaption: "<span title='@Lang.PlaytechCasinoNetGaming'>@Lang.PCNetGaming</span>", 
            HeaderText: "<span title='@Lang.PlaytechCasinoNetGaming'>@Lang.PCNetGaming</span>", 
            IsCurrency: true, Width: 110, Name: "NetGaming", NameCache: "NetGaming", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)',  IsAbs: true };

    </script>
    @Scripts.Render("~/scripts/affiliatecommissionreport")
}
