<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ output extension=".txt" #>
<#@ import namespace="Fanex.AffiliateAdmin.Core.ConfigModelReaders" #>
<#@ parameter name="Site" type="Fanex.AffiliateAdmin.Core.ConfigModelReaders.SiteInfo" #>
<# 
if(Site != null)
{
  var reader = new WebAppSettingsModelReader
  {
      Environment = Site.Environment,
      XmlFile = Host.ResolvePath(Site.WebAppSettingModel)
  };

  reader.LoadXml();
  var siteSettings = reader.GetSettingsOfSite();
#>
<appSettings>
  <add key="Layout" value="<#= siteSettings.GetValue("Layout") #>" />
  <add key="PageSize" value="20"/>  
  <add key="DefaultLanguage" value="<#= siteSettings.GetValue("DefaultLanguage") #>" />
  <add key="AffiliateName" value="<#= siteSettings.GetValue("AffiliateName") #>"/>
  <add key="Environment" value="<#= siteSettings.GetValue("Environment") #>"/>
  <add key="TransferDay" value="<#= siteSettings.GetValue("TransferDay") #>"/> <!--nth day of month can transfer manually.-->
  <add key="TestMonthlyTransfer" value="<#= siteSettings.GetValue("TestMonthlyTransfer") #>"/> <!--0: disable monthly transfer; 1: enable monthly transfer-->
  <!--Used to determine which month is transfer, default value: 1 (last month). 0: Current month; 1: last month; 2: past 2nd month;-->
  <add key="PastNthMonth" value="<#= siteSettings.GetValue("PastNthMonth") #>"/>

  <add key="MaxImageSize" value="3000000"/>
  <add key="ThumbnailHeight" value="200"/>
  <add key="ThumbnailWidth" value="300"/>

  <add key="EmailHeaderBgColor" value="<#= siteSettings.GetValue("EmailHeaderBgColor") #>"/>
  <add key="EmailHeaderFontColor" value="<#= siteSettings.GetValue("EmailHeaderFontColor") #>"/>
  <add key="EmailContentBgColor" value="<#= siteSettings.GetValue("EmailContentBgColor") #>"/>
  <add key="EmailContentFontColor" value="<#= siteSettings.GetValue("EmailContentFontColor") #>"/>
  <add key="EmailCopyrightBgColor" value="<#= siteSettings.GetValue("EmailCopyrightBgColor") #>"/>
  <add key="EmailCopyrightFontColor" value="<#= siteSettings.GetValue("EmailCopyrightFontColor") #>"/>
  <add key="EmailFooterBgColor" value="<#= siteSettings.GetValue("EmailFooterBgColor") #>"/>
  <add key="EmailFooterFontColor" value="<#= siteSettings.GetValue("EmailFooterFontColor") #>"/>

  <add key="ViewLogBackMonth" value="-3"/>
  <add key="LeftString" value="20"/>
  
  <!--Config Mail-->
  <add key="app_mail_id" value="<#= siteSettings.GetValue("app_mail_id") #>" />
  <add key="MailContact" value="<#= siteSettings.GetValue("MailContact") #>"/>
  <!--End Config Mail-->
  
  <!--For hardcode undermaintenance format: dd MMM yyyy hh:mm PM or AM-->
  <add key="SkipCheckUMTime" value="<#= siteSettings.GetValue("SkipCheckUMTime") #>"/>
  <add key="UM_StartTime" value="<#= siteSettings.GetValue("UM_StartTime") #>"/>
    <add key="UM_EndTime" value="<#= siteSettings.GetValue("UM_EndTime") #>"/>

  <add key="IPCheckerURL" value="http://anonym.to/?http://legacytools.dnsstuff.com/tools/ipall.ch?tool_id=67&amp;token=&amp;toolhandler_redirect=0&amp;ip={0}&amp;j=1"/>
  <add key="InternalURL" value="<#= siteSettings.GetValue("InternalURL") #>"/>
  <add key="InternalURL_Kiosk" value="<#= siteSettings.GetValue("InternalURL_Kiosk") #>"/>
</appSettings>
<#
}
#>