@{
    ViewBag.Title = Lang.AddNewConfiguration;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@model Fanex.AffiliateAdmin.Models.AddConfigurationViewModel
@using (Html.BeginForm("AddConfiguration", "Configuration", FormMethod.Post, new { @class = "form-horizontal form-popup"  }))
{
    @Html.ValidationSummary()
    <div class="popup-content">
        <div class="control-group">
            @Html.LabelFor(m => m.Key, Lang.Key, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.Key, new { @class = "form-control" })
                <span class="required">*</span>
            </div>
        </div>
        <div class="control-group">
            @Html.Label("Type", Lang.Type, new { @class = "control-label" })
            <div class="controls">
                @Html.DropDownList("Type", Model.TypeOptionList, new { @class = "width-140 dropdownchecklist single-select" })
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Description, Lang.Description, new { @class = "control-label" })
            <div class="controls">
                @Html.TextAreaFor(m => m.Description, new { @class = "small-textarea" })
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Environment, Lang.Environment, new { @class = "control-label" })
            <div class="controls">
                @Html.DropDownList("Environment", Model.EnvironmentOptionList, new { @class = "width-140 dropdownchecklist single-select" })
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Value, Lang.Value, new { @class = "control-label" })
            <div class="controls">
                @Html.TextAreaFor(m => m.Value, new { @class = "large-textarea" })
                <span class="required">*</span>
            </div>
        </div>
    </div>
    <div class="popup-footer">
        <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnUpdate" class="btn">@Lang.Add</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </div>
}
@section scripts{
    @if (ViewBag.Result != null)
    {
        var result = (Fanex.AffiliateAdmin.Models.ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus( @result.ErrorCode, "@result.Message", parent.Configuration.ReRenderAfterPaged );
        </script>
    }
    @Scripts.Render("~/scripts/configuration")
}
