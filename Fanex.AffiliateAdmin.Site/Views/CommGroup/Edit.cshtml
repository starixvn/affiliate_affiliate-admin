@{
    ViewBag.Title = Lang.AddCommissionGroup;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using System.Linq
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.DbConstants

@model CommGroupInfo
@{
    long MAXAM = 100000000000000;
    var isNoCommissionGroup = false;
    var currencyDropDownAttr = new Dictionary<string, object>();
    currencyDropDownAttr.Add("class", "width-140 dropdownchecklist single-select");

    if (Model != null)
    {
        currencyDropDownAttr.Add("disabled", "disabled");
        if (Model.Currency == 0)
        {
            isNoCommissionGroup = true;
        }
    }

    var productList = ViewBag.ProductList as IEnumerable<Product>;
}

@using (Html.BeginForm("Edit", "CommGroup", FormMethod.Post, new { @class = "form-horizontal", id = "CommGroupSettingsForm" }))
{
    @Html.ValidationSummary()
    <div class="popup-content" style="min-width:800px">
        @Html.HiddenFor(m => m.GroupID)
        <div class="control-group">
            @Html.LabelFor(m => m.GroupName, Lang.GroupName, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.GroupName, new { maxlength = "100", @class = "form-control" }.DisabledIf(isNoCommissionGroup))<span style="color: red"> *</span>
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Description, Lang.Description, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.Description, new { maxlength = "100", @class = "form-control" })
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.QualifiedAmount, Lang.QualifiedAmount, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBox("QualifiedAmount", Model.QualifiedAmount.ToString("#,0"), new { maxlength = "20", @class = "form-control" })<span style="color: red"> *</span>
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Currency, Lang.Currency, new { @class = "control-label" })
            <div class="controls">
                @if (isNoCommissionGroup)
                {
                    @Html.DropDownListFor(m => m.Currency, new SelectList(new List<Currency>(){ new Currency(){
                CurrencyCode = Lang.All, CurrencyID = 0 }}, "CurrencyID", "CurrencyCode"),
            currencyDropDownAttr)
                }
                else
                {
                    @Html.DropDownListFor(m => m.Currency, new SelectList(SessionManager.CurrentSession.CurrencyList, "CurrencyID", "CurrencyCode"), currencyDropDownAttr)
                }
            </div>
        </div>
        <div class="control-group">
            @Html.Label("ActiveAll", @Lang.ActiveAll, new { @class = "control-label" })
            <div class="controls">
                @Html.CheckBox("ActiveAll")
            </div>
        </div>

        <div class="control-group red" id="currNotify" style="display:none;margin: 5px 5px 15px 25px">
        </div>
        @foreach (var product in productList)
        {
            var hasTier = Model.GroupSettings.Count(x => x.ProductID == product.ProductID) > 0;
            var headerIcon = hasTier ? "icon-ok-circle" : "icon-ban-circle";
            var colorClass = hasTier ? "enabled" : "disabled";
            var toggleClass = hasTier ? "show" : "hide";
            var productName = @Lang.ResourceManager.GetString(product.ProductName.Replace(" ", string.Empty));
            productName = string.IsNullOrEmpty(productName) ? product.ProductName : productName;

            <div class="control-group product">
                <div id="tab_header@(product.ProductID)" @(hasTier ? string.Empty : "data-disabled='true'") data-productid="@(product.ProductID)" class="tab_header" data-productname="@product.ProductName">
                    <div class="pull-left tab_title">
                        <div class="expand">
                            <span>
                                <span id="product_header@(product.ProductID)" class="product_header @colorClass" style="cursor: pointer">
                                    <i id="header_icon@(product.ProductID)" class="header_icon @headerIcon"></i>
                                    @productName
                                </span>
                            </span>
                        </div>
                    </div>
                    <div class="pull-right textcopy">
                        <label for="@(product.ProductID)">
                            <input type="checkbox" class="copy" id="@(product.ProductID)" @(hasTier ? string.Empty : "disabled") />
                            @string.Format(@Lang.CopyTierSettingFor, productName)
                        </label>
                    </div>
                </div>
                <div class="tab_content @toggleClass" id="tab_content@(product.ProductID)">
                    @{
                        var deductions = AppSettings.DeductionTypes.Where(x => x.ProductID == product.ProductID).ToList();

                        if (deductions.Any())
                        {
                            <!--Deduction-->
                            <div class="fieldset">
                                <div class="legend">@Lang.SharingFee</div>
                                <div class="clear"></div>
                                <!--DeductionOption-->
                                <div class="row-fluid row-form deductions">
                                    @RazorHelper.SharingFeeInfoPanel(product.ProductName)
                                    <table>
                                        @foreach (var item in deductions)
                                        {
                                            var check = Model.DeductionSettings.Any(x => x.DeductionID == item.DTypeID);
                                            var percentChecking = check ? Model.DeductionSettings.FirstOrDefault(x => x.DeductionID == item.DTypeID) : null;
                                            var percent = percentChecking == null ? (decimal)item.DeductedPercentage : percentChecking.DeductedPercentage;

                                            var className = item.DTypeName.Equals("PSP", StringComparison.OrdinalIgnoreCase) ? "deductionlist nopadding psp-deduction" : "deductionlist nopadding";
                                            <tr>
                                                @if (item.DTypeID == DeductionTypeConstant.CashOutWinLossShare)
                                                {
                                                    var nextPercent = percentChecking == null ? null : percentChecking.NextDeductedPercentage;
                                                    var currentPercent = percentChecking == null || percent == null ? 0 : percent;
                                                    <td style="text-align: left;">
                                                        <input type="checkbox" class="deduction" data-id="@item.DTypeID" data-percent="@currentPercent" @(check && percent != null ? "checked" : string.Empty) disabled />
                                                        <label title="@(Lang.ResourceManager.GetString("Deduction" + item.DTypeName.Replace(" ", string.Empty)))">
                                                            @(Lang.ResourceManager.GetString(item.DTypeName.Replace(" ", string.Empty)))
                                                        </label>
                                                    </td>
                                                    <td style="text-align: left;">
                                                        = <label style="margin-left: 15px; width: 70px">@string.Format("{0:0.00}", currentPercent)</label>
                                                    </td>
                                                    <td style="text-align: left;">
                                                        @CommGroupRazorHelper.AdditionalSharingFee(item.DTypeID, (decimal)Model.DepositPercent, (decimal)Model.WithdrawalPercent, check ? string.Empty : "disabled")
                                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                        <input type="checkbox" data-id="-@item.DTypeID" class="deduction" @(nextPercent != null ? "checked" : string.Empty) />
                                                        <label>
                                                            @Lang.NextMonthSetting
                                                        </label>
                                                        : @CommGroupRazorHelper.PercentageDropDownList(nextPercent ?? (decimal)item.DeductedPercentage, (decimal)0.01, "nextdeductionlist nopadding", nextPercent != null ? string.Empty : "disabled")
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td style="text-align: left;">
                                                        <input type="checkbox" class="deduction" data-id="@item.DTypeID" data-percent="@item.DeductedPercentage" @(check ? "checked" : string.Empty) />
                                                        <label title="@(Lang.ResourceManager.GetString("Deduction" + item.DTypeName.Replace(" ", string.Empty)))">
                                                            @(Lang.ResourceManager.GetString(item.DTypeName.Replace(" ", string.Empty)))
                                                        </label>
                                                    </td>
                                                    <td style="text-align: left;">
                                                        = @CommGroupRazorHelper.PercentageDropDownList(percent ?? 0, (decimal)0.01, className, check ? string.Empty : "disabled")
                                                    </td>
                                                    <td style="text-align: left;">
                                                        @CommGroupRazorHelper.AdditionalSharingFee(item.DTypeID, (decimal)Model.DepositPercent, (decimal)Model.WithdrawalPercent, check ? string.Empty : "disabled")
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </table>
                                </div>
                                <!--/DeductionOption-->
                            </div>
                            <!--/Deduction-->
                        }
                    }
                    <div class="fieldset" id="fieldsetTier@(product.ProductID)">
                        <div class="legend">@Lang.TierSetting</div>
                        <div style="clear:left;"></div>
                        <table id="tblTier@(product.ProductID)">
                            <thead>
                                <tr>
                                    <td style="width: 55px;" class="theader">@Lang.Tier</td>
                                    <td style="width: 110px;" title="@Lang.MinimumWinlossAmount" class="theader">@Lang.MinAmount</td>
                                    <td style="width: 165px;" title="@Lang.MaximumWinlossAmount" class="theader">@Lang.MaxAmount</td>
                                    <td style="width: 110px;" title="@Lang.MinimumQualifiedMembers" class="theader">@Lang.MinQM</td>
                                    <td style="width: 165px;" title="@Lang.MaximumQualifiedMembers" class="theader">@Lang.MaxQM</td>
                                    <td style="width: 80px;" class="theader">@Lang.Commission</td>
                                    <td style="width: 80px;" class="theader">@Lang.Action</td>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!hasTier)
                                {
                                    <tr class="rnormal"><td class="c" colspan="7">@Lang.NoInfo</td></tr>
                                }
                                else
                                {
                                    var settings = Model.GroupSettings.Where(x => x.ProductID == product.ProductID).ToList();
                                    var count = settings.Count();

                                    for (int j = 0; j < count; j++)
                                    {
                                        var tier = settings.ElementAt(j);
                                        var ismax = tier.MaxAmount == MAXAM;
                                        var isLast = j == count - 1;
                                        <tr class="tier">
                                            <td>@(j + 1)</td>
                                            <td>
                                                <input type="text" disabled class="minAM" value="@(((long)tier.MinAmount).ToString("#,0"))" maxlength="19" />
                                            </td>
                                            <td class="for_form">
                                                <input type="text" @(ismax ? "disabled" : null) class="maxAM" value="@(ismax ? "∞" : ((long)tier.MaxAmount).ToString("#,0"))" maxlength="19" />
                                                <input type="checkbox" @(!isLast ? "disabled" : null) @(ismax ? "checked" : null) />∞
                                            </td>
                                            <td>
                                                <input type="text" disabled class="minQM" value="@tier.MinQM.ToString("#,0")" maxlength="13" />
                                            </td>
                                            <td class="for_form">
                                                <input type="text" @(ismax ? "disabled" : null) class="maxQM" value="@(ismax ? "∞" : tier.MaxQM.ToString("#,0"))" maxlength="13" />
                                                <input type="checkbox" @(!isLast ? "disabled" : null) @(ismax ? "checked" : null) />∞
                                            </td>
                                            <td style="max-width: 100px">
                                                @CommGroupRazorHelper.PercentageDropDownList(tier.Commission, (decimal)0.01, "commission", string.Empty)
                                            </td>
                                            <td>
                                                <a href="javascript:void(0);" class="icon-remove  @(!isLast ? "icon-white" : string.Empty)"></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <button id="btnAddTier@(product.ProductID)" @(hasTier ? "disabled" : string.Empty) style="margin-top: 5px; vertical-align: top;" type="button" class="btn btn-default addtier" data-productid="@product.ProductID">@Lang.AddTier</button>
                    </div>
                </div>
            </div>
           }
    </div>
    <div class="clear"></div>
    <div class="row-fluid row-form btn-action" style="margin: 10px">
        <div class="span12">
            <button class="btn btn-default" id="btnSubmit" type="button">@Lang.Update</button>
            <button class="btn btn-default" id="btnCancel" type="button">@Lang.Cancel</button>
        </div>
    </div>
}

<div id="sampleCommissionList" class="hide">
    <select style="margin-left: 10px; width: 70px" class="commission single-select">
        @for (int i = 0; i < 100; i++)
        {
            var val = string.Format("{0:0.00}", Convert.ToDecimal(i) / 100);
            <option value="@val">@val</option>
        }
    </select>
</div>

<table id="sampleTierRow" class="hide">
    <tr class="tier">
        <td class="tierOrder">0</td>
        <td>
            <input type="text" disabled class="minAM" maxlength="19" />
        </td>
        <td>
            <input type="text" class="maxAM" maxlength="19" />
            <input type="checkbox" />∞
        </td>
        <td>
            <input type="text" disabled class="minQM" maxlength="13" />
        </td>
        <td>
            <input type="text" class="maxQM" maxlength="13" />
            <input type="checkbox" />∞
        </td>
        <td class="commissionCol"></td>
        <td>
            <a href="javascript:void(0);" class="icon-remove" title="@Lang.Remove"></a>
        </td>
    </tr>
</table>

@section css{
    @Styles.Render("~/bundles/commgroup")
}

@section scripts{
    <script type="text/javascript">
        var MAXQM = 1000000000;
        var MAXAM = 100000000000000;

        var MSG = {
            PassRequire: "@Lang.ErrNewPass",
            PassConfirm: "@Lang.PassConfirm",
            InvalidSettingFor: "@Lang.InvalidSettingFor",
            TierSettingAtLeastTier: "@Lang.TierSettingAtLeastTier",
            LastTierSettingHaveMaxValue: "@Lang.LastTierSettingHaveMaxValue",
            ConfirmRemoveFromGroup: "@Lang.ConfirmRemoveFromGroup",
            GroupNameEmpty: "@Lang.GroupNameEmpty",
            ValidQualifiedAmount: "@Lang.ValidQualifiedAmount",
            EnableProduct: "@Lang.EnableProduct",
            MaxTierAllow: "@Lang.MaxTierAllow",
            UncheckCopyAllTierSettings: "@Lang.UncheckCopyAllTierSettings"
        };

        var PRODUCTS = "@(string.Join(",", productList.Select(x => x.ProductID)))".split(',');
        var HasCashback = @(Model.HasCashback > 0 ? "true" : "false");
    </script>

    @Scripts.Render("~/scripts/commgrouppopup")
}