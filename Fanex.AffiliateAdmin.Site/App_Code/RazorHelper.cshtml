@helper FormatCurrencyNumber(decimal number, int dec = 2)
    {
        if (number < 0)
        {
    <span style="color: red">(@decimal.Round(number, dec)) </span>
        }
        else
        {
            decimal.Round(number, dec).ToString();
        }
}
@helper GetAffiiateStatus(string status)
    {
        if (status.Equals(AffiliateStatus.Disapproved.ToString(), StringComparison.CurrentCultureIgnoreCase))
        {
    @Lang.Disapproved
        }
        else
        {
    @Lang.Pending
        }
}
@helper DropDownListCountry(IEnumerable<System.Web.Mvc.SelectListItem> list, string selectedValue, IDictionary<string, object> htmlAttributies = null)
    {
        var name = string.Empty;
        var style = string.Empty;
        if (htmlAttributies != null)
        {
            name = htmlAttributies.ContainsKey("id") ? "id=\"" + htmlAttributies["id"] + "\" name=\"" + htmlAttributies["id"] + "\"" : string.Empty;
            style = htmlAttributies.ContainsKey("style") ? "style=\"" + htmlAttributies["style"] + "\"" : string.Empty;
        }
    <select @( new HtmlString(name)) @(new HtmlString(style)) class="width-140 dropdownchecklist single-select">
