@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<div>
    Kính gửi quý khách,<br />
    <br />
    Xin chúc mừng, bạn đã là hội viên chương trình liên kết @Model.SystemName.<br />
    <br />
    Để chúng tôi có thể phục vụ bạn tốt hơn, xin vui lòng cập nhật thông tin cá nhân
    mới nhất và bao gồm website mới nhất (nếu có) trong "Thông tin cá nhân" tại trang
    chương trình liên kết @Model.SystemName.<br />
    <br />
    Xin vui lòng gửi thư đến <a href="mailto:@Model.MailContact">@Model.MailContact</a>
    để thông báo cho chúng tôi chính xác website hoặc URLs mà bạn dự định đặt quảng
    cáo của @Model.SystemName. Nếu bạn có nhu cầu thay đổi về kích cỡ của biểu ngữ,
    xin liên hệ với chúng tôi, chúng tôi sẽ hỗ trợ cho bạn trong thời gian sớm nhất.<br />
    <br />
    Xin lưu ý rằng, tài khoản của bạn sẽ bị đóng nếu như website hoặc URLs mà bạn đăng
    ký không đặt quảng cáo của @Model.SystemName trong vòng 7 ngày sau khi được thông
    báo đã trở thành hội viện của chúng tôi, trừ trường hợp bạn đã gửi thư giải thích
    với chúng tôi trước.<br />
    <br />
    Chúng tôi chúc bạn nhiều may mắn, và mong rằng bạn sẽ tận dụng lưu lượng trang web
    của bạn để gặt được lợi nhuận cao nhất.<br />
    <br />
    Chân thành cảm ơn.<br />
    <br />
    Bộ phận liên kết @Model.SystemName.<br />
    <a href="mailto:@Model.MailContact">@Model.MailContact</a>
</div>