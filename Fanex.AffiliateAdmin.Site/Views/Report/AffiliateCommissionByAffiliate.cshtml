@{
    ViewBag.Title = Lang.AffiliateWinLossReport;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}

@section iconcss{
report
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 6, string.Empty, 3)
    <div class="line line-statement">
        <div class="ic-open-window" title="@Lang.FullScreen"></div>
        <div class="ic-reload" title="@Lang.RefreshPage"></div>
    </div>
}

@{
    var now = SystemTimeService.GetSystemDateTime();
    var fromDate = Model.FromDate.HasValue ? Model.FromDate.Value : new DateTime(now.Year, now.Month, 1).AddMonths(-1);
    var toDate = Model.ToDate.HasValue ? Model.ToDate.Value : now;

    if (fromDate < AppSettings.SystemStartDate)
    {
        fromDate = AppSettings.SystemStartDate;
    }

    if (toDate < AppSettings.SystemStartDate)
    {
        toDate = AppSettings.SystemStartDate;
    }

    if (fromDate > now)
    {
        fromDate = new DateTime(now.Year, now.Month, 1).AddMonths(-1);
    }

    if (toDate > now)
    {
        toDate = now;
    }
}

@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Enumerations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Services
@model Fanex.AffiliateAdmin.Models.AffiliateCommissionByAffiliateViewModel
<div class="search-panel search-company-winloss" style="min-width: 800px" >
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", Common.GetReportInfo(ReportType.AffiliateWinLoss), false, true)
    @using (Html.BeginForm("AffiliateWinLossByAffiliate", "Report", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {
        <div class="span12 search-form  end-search">
            <div class="row-fluid row-form">
                <div class="cell">
                    @Html.LabelFor(m => m.BaseCurrency, new {@class = "txt"})
                    @Html.DropDownCheckList("BaseCurrency", Model.BaseCurrencyOptionList, false, false, new {@class = "width-140"})
                </div>
                <div class="cell">
                    <label for="SortBy" class="txt">@Lang.SortBy</label>
                    @Html.DropDownCheckList("SortBy", Model.SortByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="Products" class="txt">@Lang.Product</label>
                    @Html.DropDownCheckList("Products", Model.ProductOptionList, true, false, new { @class = "width-140" })
                </div>
            </div>
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    @Html.LabelFor(m => m.TransferStatus, new { @class = "txt", @for = "TransferStatus" })
                    @Html.DropDownCheckList("TransferStatus", Model.TransferStatusOptionList, false, false, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="FromDate" class="txt">@Lang.From</label>
                    @Html.MonthPicker("FromDate", fromDate, AppSettings.SystemStartDate, now, false)
                </div>
                <div class="cell">
                    <label for="ToDate" class="txt">@Lang.To</label>
                    @Html.MonthPicker("ToDate", toDate, AppSettings.SystemStartDate, now, false)
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" class="btn" id="btnSubmit">@Lang.Submit</button>
                    <input type="hidden" name="ByAffiliate" id="ByAffiliate" value="true" />
                    <input type="hidden" name="ViewMode" id="ViewMode" value="@Model.ViewMode" />
                </div>
            </div>
        </div>
    }
</div>

<div id="gridId" class="freegrid" data-colheight="150" data-expheight="250" />

@section scripts{
    <script type="text/javascript">
        var MSG = {
            ActivePlayers: "@Lang.ActiveMembers",
            BetCount: "@Lang.BetCount",
            Turnover: "@Lang.Turnover",
            NetWinloss: "@Lang.NetWinloss",
            Commission: "@Lang.Commission",
            RangeTime3Months: "@Lang.RangeTime3Months",
            All: "@Lang.All",
            Total: "@Lang.Total",
            TotalIn: "@Lang.TotalIn",
            Sportsbook: "@Lang.Sportsbook",
            NumberGame: "@Lang.NumberGame",
            LiveCasino: "@Lang.LiveCasino",
            RNGCasino: "@Lang.RNGCasino",
            PlaytechCasino: "@Lang.PlaytechCasino",
            VirtualSport: "@Lang.VirtualSport",
            SubTotal: "@Lang.SubTotal",
            CommPercent: "@Lang.CommPercent",
            QM: "@Lang.QM",
            CommGroupSettingFor: "@Lang.CommGroupSettingFor",
            AffQualifiedMemReportDetailFor: "@Html.Raw(Lang.AffQualifiedMemReportDetailFor)",
            Currency: "@Lang.Currency",
            Cashback: "@Lang.Cashback",
            DeductionPercent: "@Lang.DeductionPercent",
            Amount: "@Lang.Amount",
            CommissionTitle: "@Lang.Commission",
            DoYouWantToTransferAll: "@Lang.DoYouWantToTransferAll",
            CommissionGroup: "@Lang.CommGroup",
            AffiliateCommissionTitle: "@Lang.AffiliateCommission",
            OccurMonthlyTransferError: "@Lang.OccurMonthlyTransferError",
            ChooseAtLeastOneProduct: '@Lang.ChooseAtLeastOneProduct',
            QualifiedMembers: "@Lang.QualifiedMembers",
            NA: "@Lang.NA",
            NATooltip: "@Lang.NATooltip"
        };

        var PRODUCTS = @(Html.Raw(ViewBag.Products));

        var sampleGridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.AffiliateCommission"
            },
            groupHeaderRows: [
                {
                    Columns: [
                        { HeaderText: "#", Name: "No", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Affiliate", Name: "Username", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Month", Name: "WinlostDateStr", MergeRowNumber: 2 },
                        { 
                            HeaderCaption: "<span title='@Lang.CommissionGroup'>@Lang.CommGroup</span>",
                            HeaderText: "<span title='@Lang.CommissionGroup'>@Lang.CommGroup</span>",
                            Name: "GroupName", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Currency", Name: "Currency", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Product", HeaderText: "@Lang.Product", Name: "ProductName", MergeRowNumber: 2 },
                        {
                            HeaderCaption: "@Lang.NetWinloss",
                            HeaderText: "@Lang.NetWinloss",
                            IsCurrency: true,
                            Name: "NetWinlost",
                            NameCache: "NetWinlost",
                            MergeRowNumber: 2
                        },
                        {
                            HeaderCaption: "@Lang.CommPercent",
                            HeaderText: "@Lang.CommPercent",
                            IsCurrency: false,
                            Name: "CommissionPercent",
                            MergeRowNumber: 2
                        },
                        {
                            HeaderCaption: "@Lang.Commission",
                            HeaderText: "@Lang.Commission",
                            IsCurrency: true,
                            Name: "Commission",
                            NameCache: "Commission",
                            MergeRowNumber: 2
                        },
                        {
                            HeaderCaption: "@Lang.TotalPayment", 
                            HeaderText: "@Lang.TotalPayment", 
                            IsCurrency: true, 
                            Name: "TotalPayment", 
                            NameCache: "TotalPayment",
                            MergeRowNumber: 2
                        }
                    ]
                }
            ],
            columns: [
                { HeaderText: "#", Width: 40, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Affiliate", Width: 80, Name: "Username", HeaderAlign: "center", CellAlign: "left",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a class='afflink' data-affname='" + record.Username + "' href='javascript:void(0)' >" + cellFormated + "</a>";
                    }
                },
                { HeaderText: "@Lang.Month", Width: 80, Name: "WinlostDateStr", HeaderAlign: "center", CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        var winlost = window.moment(record.WinlostDate).format("DD MMM YYYY");
                        return "<a class='monthlink' data-affname='" + record.Username + "' href='javascript:void(0)' data-winlostdate='{0}'>".format(winlost) + cellFormated + "</a>";
                    }
                },
                {
                    HeaderText: "@Lang.CommGroup",
                    Width: 90,
                    Name: "GroupName",
                    HeaderAlign: "center",
                    CellAlign: "left",
                    Formatter: function(rIndex, record) {
                        return '<a href="javascript:void(0)" data-groupid={0} data-date="{1}" class="commgroup">{2}</a>'.format(record.GroupID, record.WinlostDateStr, record.GroupName);
                    }
                },
                { HeaderText: "@Lang.Currency", Width: 90, Name: "Currency", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Product", Width: 110, Name: "ProductName", HeaderAlign: "center", CellAlign: "left" },
                {
                    HeaderCaption: "@Lang.NetWinloss",
                    HeaderText: "@Lang.NetWinloss",
                    IsCurrency: true,
                    Width: 110,
                    Name: "NetWinlost",
                    NameCache: "NetWinlost",
                    HeaderAlign: "center",
                    CellAlign: "right",
                    FormatNumber: AFFILIATE.FORMATNUMBER,
                    FormatNegative: '($)',
                    IsAbs: true
                },
                { 
                    HeaderCaption: '@Lang.CommPercent', 
                    HeaderText: '@Lang.CommPercent',
                    Name: "CommissionPercent", 
                    IsCurrency: false, 
                    IsNA: true,
                    IsPercent: true,
                    Width: 80, 
                    HeaderAlign: "center", CellAlign: "right",
                    FormatNumber: AFFILIATE.FORMATNUMBER
                },
                { 
                    HeaderCaption: '@Lang.Commission',
                    HeaderText: '@Lang.Commission',
                    Name: "Commission", 
                    NameCache: "Commission", 
                    IsCurrency: true,
                    Width: 100, 
                    HeaderAlign: "center",
                    CellAlign: "right", 
                    FormatNumber: AFFILIATE.FORMATNUMBER, 
                    FormatNegative: '($)', 
                    IsAbs: true
                },
                { 
                    HeaderCaption: "@Lang.TotalPayment",
                    HeaderText: "@Lang.TotalPayment",
                    IsCurrency: true,
                    Width: 110,
                    Name: "TotalPayment",
                    NameCache: "TotalPayment",
                    HeaderAlign: "center",
                    CellAlign: "right", 
                    FormatNumber: AFFILIATE.FORMATNUMBER, 
                    FormatNegative: '($)', 
                    IsAbs: true 
                }
            ],
            showPager: true,
            customPager: true,
            showFooter: true,
            allowTruncate: true,
            gridExpandHeight: 360,
            customizeHeader: true,
            indexNumberColumn: 0,
            bodyRowHeight: 27
        };
    </script>
    @Scripts.Render("~/bundles/affiliatecommission")
}

