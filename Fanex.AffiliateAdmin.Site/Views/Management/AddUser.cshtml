@using Fanex.AffiliateAdmin.Models
@{
    ViewBag.Title = Lang.AddNewAccount;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@model Fanex.AffiliateAdmin.Models.AccountViewModel

@using (Html.BeginForm("AddUser", "Management", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    <fieldset>
        <div class="clearfix"></div>
         <div class="control-group">
            <label class="control-label" for="Username">@Lang.Username</label>
            <div class="controls">
                @Html.TextBoxFor(m => m.Username, new { Name = "Username" })
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="Password">@Lang.Password</label>
            <div class="controls">
                 @Html.Password("Password", string.Empty, new { title = Lang.Password })
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="FirstName">@Lang.FirstName</label>
            <div class="controls">
                @Html.TextBoxFor(m => m.FirstName, new { Name = "FirstName" })
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="LastName">@Lang.LastName</label>
            <div class="controls">
                @Html.TextBoxFor(m => m.LastName, new { Name = "LastName" })
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="GroupId">@Lang.GroupName</label>
            <div class="controls">
                @RazorHelper.DropDownListGroup(Model.GroupList.ToList(), Model.GroupID, new Dictionary<string, object> { { "id", "GroupId" } })
            </div>
        </div>
         <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnSubmit" class="btn">@Lang.Add</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </fieldset>
}
@section scripts{
    @Scripts.Render("~/scripts/usermanagement")
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@(result.ErrorCode), "@result.Message", parent.Management.ReRenderAfterPaged);
        </script>
    }
}