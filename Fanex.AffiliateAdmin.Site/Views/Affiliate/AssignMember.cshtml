@{
    ViewBag.Title = "Assign Member To Affiliate";
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";   
}

@using Fanex.AffiliateAdmin.Models

@model AssignMemberViewModel

@{
    var result = ViewBag.Result as ResultViewModel;
}

@using (Html.BeginForm("AssignMember", "Affiliate", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    <div class="popup-content">   
   
   <div class="control-group">
        <label for="MemberName" class="control-label">@Lang.Member</label>   
        <div class="controls">
            @Html.TextBoxFor(m => m.MemberName)
        </div>
    </div>
    <div class="control-group">
        <label for="AffName" class="control-label">@Lang.Affiliate</label>   
        <div class="controls">
            @if (Model.ByAffiliate)
            {
                @Html.TextBoxFor(m => m.AffName, new { @readonly = "readonly" })
            }
            else
            {
                @Html.TextBoxFor(m => m.AffName)
            }
            @Html.HiddenFor(m => m.ByAffiliate)
        </div>
    </div>
   </div>
    <div class="popup-footer">
        <div class="control-group">
            <div class="controls">
                <button class="btn" id="btnSubmit" type="submit">@Lang.Assign</button>
                <button class="btn" id="btnCancel" type="button">@Lang.Cancel</button>
            </div>
        </div>
    </div>
}
@section scripts{
    @if (result != null)
    {        
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.CUSTOMER.ReRenderAfterPaged);
        </script>
    }
    <script type="text/javascript">
        var MSG = {
            InputMem: "@Lang.InputMem",
            InputAff: "@Lang.InputAff"
        };

        $(function(){
           POPUP.init();
        });
    </script>
    <script src="@Url.Content("~/Scripts/site/Customer.js")" type="text/javascript"></script> 
}