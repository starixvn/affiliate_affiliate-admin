@{
    ViewBag.Title = Lang.EditMemberDomain;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using Fanex.AffiliateAdmin.Models

@model Fanex.AffiliateAdmin.Models.DomainViewModel

@using (Html.BeginForm("MemDomainUpd", "Domain", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    <fieldset>
         <div class="control-group">
            @Html.LabelFor(m => m.DomainName, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.DomainName)
            </div>
        </div>

         <div class="control-group">
            <div class="controls">
                <button type="submit" class="btn">@Lang.Update</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </fieldset>
    @Html.HiddenFor(m => m.DomainID)
}


@section scripts{
    @Scripts.Render("~/scripts/domainmem")
    @if (ViewBag.Result != null){
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.ErrorMessage", parent.DOMAIN.ReRenderAfterPaged);
        </script>
    }
}
