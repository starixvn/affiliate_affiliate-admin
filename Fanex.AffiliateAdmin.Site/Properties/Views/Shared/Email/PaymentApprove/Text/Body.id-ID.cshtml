@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<div>
    Dear @(Model.FirstName),
    <br />
    <br />
    Permintaan nomor referensi adalah @(Model.TransId), tanggal @(Model.WinlostDate.ToString("MM/dd/yyyy")).
    <br />
    <br />
    Pihak kami memberitahu pihak tuan bahwa permintaan pembayaran sebesar @(Model.Amount) telah selesai dengan sukses dan wang sudah dikirim ke prosesor pembayaran Anda.
    <br />
    <br />
    Ini adalah sistem yang dihasilkan otomatis email, harap jangan balas email ini secara langsung.<br />
    Jangan ragu untuk menghubungi kami jika Anda memiliki pertanyaan di <a href="mailto:@(Model.MailContact)">@(Model.MailContact)</a>
    <br />
    <br />
    Hormat kami,
    <br />
    <br />
    Afiliasi @(Model.SystemName)
    Tim
    <br />
    <a href="mailto:@(Model.MailContact)">@(Model.MailContact)</a>
</div>