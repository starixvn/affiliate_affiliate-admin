@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Models
@model MessageDetail
@{
    ViewBag.Title = Lang.EditMessage;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";

    var systemSettings = DependencyResolver.Current.GetService<ISystemSettings>();
    var affSupportLanguages = systemSettings.AffSupportLanguages;
}

@using (Html.BeginForm("EditMessage", "Message", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    @Html.HiddenFor(m => m.MsgId)
    <div class="popup-content">
        <div class="control-group">
            <label class="control-label">@Lang.Important</label>
            <div class="controls">
                @Html.CheckBoxFor(m => m.Important)
            </div>
        </div>
        @foreach (var language in affSupportLanguages)
        {
            <div class="control-group">
                <label class="control-label">@language.LanguageName</label>
                <div class="controls">
                    @Html.TextAreaFor(m => m.LangMessages[language.LanguageID], new { @class = "small-textarea" })
                </div>
            </div>
        }
    </div>
    <div class="popup-footer">
        <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnUpdate" class="btn">@Lang.Update</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </div>
}
@section scripts{
    @Scripts.Render("~/scripts/message")
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.ErrorMessage", parent.Message.ReRenderAfterPaged);
        </script>
    }
}
