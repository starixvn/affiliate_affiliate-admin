@{
    ViewBag.Title = Lang.DomainControl;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Utilities
@section iconcss{
domain
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Domain, 2, "domain")
}
<div class="line line-domainControl">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
</div>
<div id="gridId" class="freegrid">
</div>
@section scripts{
    <script type="text/javascript">
        var gridOption = {
            showTitle: true,
            titleInfo:
            {
                text: "@Lang.DomainControl",
                customButtons: '<input type="button" name="btnAdd" value="" title="@Lang.AddDomainControl" class="btnAdd icon-add-affDomain" id="btnAddgridId">'
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", CellAlign: "center" },
                { HeaderText: "@Lang.AffDomain", Width: 220, Name: "AffDomain" },
                { HeaderText: "@Lang.MemberDomain", Width: 220, Name: "MemberDomain" },
                { HeaderText: "@Lang.Country", Width: 100, Name: "CountryName" },
                { HeaderText: "@Lang.UpdatedBy", Width: 100, Name: "Creator" },
                { HeaderText: "@Lang.CreatedDate ", Width: 100, Name: "CreateDate", CellAlign: "center", FormatDateTime: AFFILIATE.DATE_FORMAT },
                { HeaderText: "@Lang.Status ", Width: 40, Name: "Status", CellAlign: "center", Formatter: formatStatus },
                { HeaderText: "@Lang.Action", Width: 50, Name: "ID", HeaderAlign: "center", CellAlign: "center", Formatter: formatAction }
            ],
            showPager: true,
            gridExpandHeight: 290,
            showNumberColumn: true
        };
        var lang = {
            AddDomain: "@Lang.AddMemberDomain",
            EditDomain: "@Lang.EditMemberDomain",
            DeleteDomain: "@Lang.ConfirmDelDomain",
            Remove: "@Lang.Remove",
            Edit: "@Lang.Edit"
        };

        function formatStatus(rIndex, record, cell, cellFormated) {
            return "<input type='checkbox' disabled='disabled' " + (cell.Value ? "checked" : "") + " />";
        }

        function formatAction(rIndex, record, cell, cellFormated) {
            return '<a href="javascript:DOMAINCONTROL.ShowUpdate({0})" title="{1}"><i class="icon-edit"></i></a>'.format(record.ID, lang.Edit)
                + '&nbsp;&nbsp;<a href="javascript:DOMAINCONTROL.Remove({0})"  title="{1}"><i class="icon-remove"></i></a>'.format(record.ID, lang.Remove);
        }
    </script>
    <script src="~/Scripts/site/DomainControl.js" type="text/javascript"></script>
}
