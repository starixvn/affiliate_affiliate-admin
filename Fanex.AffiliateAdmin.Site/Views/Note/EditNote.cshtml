@{
    ViewBag.Title = Lang.EditNote;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}

@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Models

@model Fanex.AffiliateAdmin.Models.NoteViewModel

@using (Html.BeginForm("EditNote", "Note", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    <fieldset>
        <div class="clearfix"></div>
         <div class="control-group">
            <label class="control-label" for="Content">@Lang.Content</label>
            <div class="controls">
                @Html.TextAreaFor(m => m.Content, new { @class = "small-textarea" })
            </div>
        </div>
         <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnSubmit" class="btn">@Lang.Update</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
        @Html.HiddenFor(m=>m.NoteId)
        @Html.HiddenFor(m => m.AffId)
    </fieldset>
}
@section scripts{
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@(result.ErrorCode), "@result.Message", parent.NOTE.ReRenderAfterPaged);
        </script>
    }
}
