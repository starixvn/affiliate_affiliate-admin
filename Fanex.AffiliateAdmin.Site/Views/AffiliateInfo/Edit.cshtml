@{
    ViewBag.Title = Lang.Edit;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Models
@using System.Web

@model Fanex.AffiliateAdmin.Models.AffiliateEditViewModel

@section iconcss{
    affiliate-info
}
@section submenu{
    @if (Model.Affiliate.Status.Equals("approved", StringComparison.CurrentCultureIgnoreCase))
    {
        @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 1)
    }
    else
    {
        @RazorHelper.ListSubmenu(SubMenu.AffiliateNotApprove, 0)
    }
    <div class="line line-statement">
        <div class="ic-open-window"></div>
    </div>
}
@Html.ValidationSummary()

@using (Html.BeginForm("Edit", "AffiliateInfo", FormMethod.Post, new { @class = "iframe-content" }))
{
<div class="row-fluid">
    <div class="span6">
        <fieldset>
            <legend>@Lang.PersonalInfo</legend>
            <div class="clearfix">
            </div>
            <table>
                <colgroup>
                    <col width="100" />
                    <col width="10" />
                    <col width="*" />
                </colgroup>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.Username, Lang.Username, new { @class = "control-label" })
                    </td>
                    <td>
                    </td>
                    <td>@Html.LabelForModel(Model.Affiliate.Username)
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.FirstName, Lang.FirstName, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.FirstName, new { Name = "FirstName", @class = "control-text" })
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.LastName, Lang.LastName, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.LastName, new { Name = "LastName", @class = "control-text" })
                    </td>
                </tr>
                <tr>
                    <td>
                        <label class="control-label">@Lang.Gender</label>
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>
                        @Html.RadioButtonFor(m => m.Affiliate.Gender, "false", new { Name = "Gender" })
                        @Lang.Female
                        @Html.RadioButtonFor(m => m.Affiliate.Gender, "true", new { Name = "Gender" }) @Lang.Male
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.Email, Lang.Email, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.Email, new { Name = "Email", @class = "control-text" })
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.Phone, Lang.ContactNumber, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>
                        @Html.TextBoxFor(m => m.Affiliate.Phone, new { Name = "Phone", @class = "control-text" })
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.MobilePhone, Lang.Mobile, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.MobilePhone, new { Name = "MobilePhone", @class = "control-text" })
                    </td>
                </tr>
            </table>
        </fieldset>
    </div>

    <div class="span6">
        <fieldset>
            <legend>@Lang.AdditionalInfo</legend>
            <div class="clearfix">
            </div>
            <table>
                <colgroup>
                    <col width="100" />
                    <col width="10" />
                    <col width="*" />
                </colgroup>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.Address, Lang.Address, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.Address, new { Name = "Address", @class = "control-text" })
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.City, Lang.City, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.City, new { Name = "City", @class = "control-text" })
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.LabelFor(m => m.Affiliate.State, Lang.State, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.State, new { Name = "State", @class = "control-text" })
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.Postal, Lang.Postal, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.Postal, new { Name = "Postal", @class = "control-text" })
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.CountryId, Lang.Country, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>
                        @RazorHelper.DropDownListCountry(Model.Countries.ToList(), Model.Affiliate.CountryId, new Dictionary<string, object> { { "id", "Country" }, { "class", "dropdownchecklist single-select" } })
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.Question, Lang.Securequestion, new { @class = "control-label" })</td>
                    <td></td>
                    <td>
                        <label class = "control-label">@Html.Raw(Model.Affiliate.Question)</label>
                        
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.Answer, Lang.Answer, new { @class = "control-label" })
                    </td>
                    <td>
                    </td>
                    <td>
                        <label class = "control-label">@Html.Raw(Model.Affiliate.Answer)</label>
                    </td>
                </tr>
            </table>
        </fieldset>
    </div>
</div>
<div class="row-fluid">
    <div class="span12">
        <fieldset>
            <legend>@Lang.Preference</legend>
            <div class="clearfix">
            </div>
            <table>
                <colgroup>
                    <col width="100" />
                    <col width="10" />
                    <col width="*" />
                </colgroup>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.Currency, Lang.Currency, new { @class = "control-label" })
                    </td>
                    <td>
                    </td>
                    <td>
                        @if (Model.Affiliate.Status.Equals("approved", StringComparison.CurrentCultureIgnoreCase))
                        {
                            @Html.DropDownCheckList("Currency", new SelectList(AppSettings.AffiliateCurrencies.Where(c => c.ExchangeID == Model.Affiliate.Currency), "ExchangeId", "Code"), false, false, new { @class = "width-140" })
                        }
                        else
                        {
                            @Html.DropDownCheckList("Currency", new SelectList(AppSettings.AffiliateCurrencies, "ExchangeId", "Code", Model.Affiliate.Currency.ToString()), false, false, new { @class = "width-140" })
                        }
                    </td>
                </tr>
                <tr>
                    <td>
                        <label class="control-label">@Lang.EmailFormat</label>
                    </td>
                    <td>
                    </td>
                    <td>
                        @Html.RadioButtonFor(m => m.Affiliate.MailOption, false, new { Name = "MailOption", id = "PlainText" })
                        <label for="PlainText" >@Lang.PlainText</label>
                        @Html.RadioButtonFor(m => m.Affiliate.MailOption, true, new { Name = "MailOption", id = "HtmlFormat" })
                        <label for="HtmlFormat" >@Lang.HtmlFormat</label>
                    </td>
                </tr>
            </table>
        </fieldset>
    </div>
</div>    
<div class="row-fluid">
    <div class="span12">
        <fieldset>
            <legend>@Lang.SiteInfo</legend>
            <div class="clearfix">
            </div>
            <table id="siteinfo">
                <colgroup>
                    <col width="100" />
                    <col width="10" />
                    <col width="160" />
                    <col width="*" />
                </colgroup>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.SiteURL, Lang.SiteUrl, new { @class = "control-label" })
                    </td>
                    <td class="required">
                        *
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.SiteURL, new { Name = "SiteURL", @class = "control-text sites" })
                    </td>
                    <td>
                        <button type="button" id="btnAddSite" class="btn btn-default" style="vertical-align: top">@Lang.AddUrl</button>
                    </td>
                </tr>
                @RazorHelper.GetMoreUrls(Model.Affiliate.MoreSiteURLs)
            </table>
        </fieldset>
    </div>
</div>
<div class="row-fluid">
    <div class="span12">
        <fieldset>
            <legend>@Lang.PaymentInfo</legend>
            <div class="clearfix">
            </div>
            <table>
                <colgroup>
                    <col width="180" />
                    <col width="10" />
                    <col width="*" />
                </colgroup>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.PreferredPayment, Lang.PreferredPaymentMethod, new { @class = "control-label" })
                    </td>
                    <td>
                    </td>
                    <td>
                        @Html.DropDownCheckList("PreferredPayment", Model.PaymentMethodListItem, false, false, new { @class = "width-90 single-select dropdownchecklist" })
                    </td>
                </tr>
                <tr>
                    <td>@Html.LabelFor(m => m.Affiliate.Player_Username, Lang.PlayerUserName, new { @class = "control-label" })
                    </td>
                    <td>
                    </td>
                    <td>@Html.TextBoxFor(m => m.Affiliate.Player_Username, new { Name = "PlayerUsername", @class = "control-text" })
                    </td>
                </tr>
            </table>
        </fieldset>
    </div>
</div>
<div class="row-fluid row-form btn-action">
    <div class="span12">
        <button type="submit" id="btnSubmit" class="btn btn-default" style="vertical-align: top">@Lang.Submit</button>
    </div>
</div>
<input type="hidden" id="moreSiteUrls" name="MoreSiteURLs" />
}

@section scripts{
    <script src="~/Scripts/site/AffiliateEdit.js" type="text/javascript"></script>
    <script type="text/javascript">
        var MSG = {
            SiteUrl: "@Lang.SiteUrl",
            MoreSite: "@Lang.WebsiteUrl",
            Delete: "@Lang.Delete"
        };
    </script>
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", AFFEDIT.hideMsg);
        </script>
    }
}
