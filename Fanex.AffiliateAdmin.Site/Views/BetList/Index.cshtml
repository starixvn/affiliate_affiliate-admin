@{
    ViewBag.Title = Lang.BetList;
    Layout = "~/Views/Shared/_LayoutNoSubMenu.cshtml";
}

<link href="@Url.RenderLink("~/www/dist/style/betlist.css")" rel="stylesheet" type="text/css" />
@model Fanex.AffiliateAdmin.Models.BetListViewModel

@if (string.IsNullOrEmpty(ViewBag.Data))
{
    <p style="font-size: 12px; font-weight: bold; text-align: center; margin-top: 7px;">@Lang.NoInfo</p>
}
else
{
    <div id="betlist-title">
        @Html.Raw(string.Format(Lang.BetListTitle, Model.WinlostDate.HasValue ? Model.WinlostDate.Value.ToString("MM/dd/yyyy") : string.Empty, @Model.Username, @Model.ToCurrencyCode))
    </div>
    <div id="betlist">
        @Html.Raw(ViewBag.Data)
    </div>
}

<div style="display: none">@ViewBag.SupportedProducts</div>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.ToCurrencyId)
    @Html.HiddenFor(m => m.ToCurrencyCode)
    @Html.HiddenFor(m => m.ExchangeRate)
    @Html.HiddenFor(m => m.AffId)
}

@Scripts.Render("~/js/betlist")

<script type="text/javascript">
    var MSG = {
        Results: "@Lang.BetListResults",
        HandHistoryDetails: "@Lang.HandHistoryDetails",
        TitleRngCasinoTicketDetail: "@Lang.TitleRngCasinoTicketDetail",
        TitleAgCasinoTicketDetail: "@Lang.TitleAgCasinoTicketDetail",
        TitleCashOutTicketDetail: "@Lang.CashOutDetails",
        TitleBoughtTicketDetail: "@Lang.BoughtDetails"
    };

    $(document).ready(function () {
        setTimeout(function() {
            $("#AffiliateInfo").removeClass("active");
        }, 500);

    });
</script>

