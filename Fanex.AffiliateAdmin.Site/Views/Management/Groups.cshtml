@{
    ViewBag.Title = Lang.GroupManagement;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var ignoredGroupNames = ViewBag.IgnoredGroupNames as string;
}
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.DTO
@section iconcss{
management
}
@Html.ValidationSummary()
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Management, 1, "UserManagement")
}
<div class="line line-groupMgr">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
</div>
<div id="gridId" class="freegrid content-grid">
</div>

<input id="IgnoredGroups" type="hidden" value="@ignoredGroupNames" />

@section scripts{
    <script type="text/javascript">
        var ignoredGroups = $.parseJSON($("#IgnoredGroups").val());
        var MSG = {
            NoInfo: "@Lang.NoInfo",
            ConfirmDelGroup: "@Lang.ConfirmDelGroup",
            AddNewGroup: "@Lang.AddNewGroup",
            GroupPolicyOfGroup: "@Lang.GroupPolicyOfGroup",
            Group: "@Lang.Group"
        };
        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.GroupManagement",
                showButtonsWhenNoData: true,
                customButtons: '<input type="button" name="btnAdd" value="" title="@Lang.AddNewGroup" class="btnAdd icon-add-group" id="btnAddgridId">'
            },
            columns: [
                { HeaderText: "#", Width: 40, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.GroupName", Width: 100, Name: "GroupName" },
                {
                    HeaderText: "@Lang.NoOfUser",
                    Width: 60,
                    Name: "NoUser",
                    CellAlign: "center",
                    Formatter:
                        function (rowIndex, rowData, cell, cellFormated) {
                            if (cell.Value > 0)
                                return '<a href="javascript:Management.viewGroup(' + rowData.GroupId + ",'" + rowData.GroupName + '\')">' + cell.Value + '</a>';
                            return cell.Value;
                        }
                },
                { HeaderText: "@Lang.Description", Width: 120, Name: "GroupDesc" },
                {
                    HeaderText: "@Lang.Policy",
                    Width: 80,
                    Name: "RolePolicy",
                    CellAlign: "center",
                    Formatter:
                        function (rowIndex, rowData, cell, cellFormated) {
                            return '<a href="javascript:Management.editRolePolicy(' + rowData.GroupId + ",'" + rowData.GroupName + '\')">@Lang.GroupPolicy</a>';
                        }
                },
                {
                    HeaderText: "@Lang.Action",
                    Width: 80,
                    Name: "Update",
                    CellAlign: "center",
                    Formatter:
                        function (rowIndex, rowData, cell, cellFormated) {
                            var html = '';
                            if (!isIgnoredGroup(rowData.GroupName)) {
                                html += '<a title="@Lang.Edit" href="javascript:Management.editGroup(' + rowData.GroupId + ",'" + rowData.GroupName + '\')"><i class=\"icon-edit\"></i></a>&nbsp;&nbsp;';
                                html += "<a title='@Lang.Remove' href=\"javascript:Management.deleteGroup(" + rowData.GroupId + ",'" + rowData.GroupName + "\')\"><i class=\"icon-remove\"></i></a>";
                            }

                            return html;
                        }
                }
            ],
            showPager: true,
            gridExpandHeight: 290,
            showNumberColumn: true
        };

        function isIgnoredGroup(groupName) {
            for (var i = 0; i < ignoredGroups.length; i++) {
                if (ignoredGroups[i] === groupName) {
                    return true;
                }
            }

            return false;
        }
    </script>
    @Scripts.Render("~/scripts/groupmanagement")
}
