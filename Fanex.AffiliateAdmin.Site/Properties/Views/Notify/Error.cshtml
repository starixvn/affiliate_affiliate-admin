@{
    ViewBag.Title = Lang.Error;
    Layout = "~/Views/Shared/_LayoutNoHeader.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Configurations
@section css{
    @Styles.Render("~/bundles/notify")
    <link href='http://fonts.googleapis.com/css?family=Oswald' rel='stylesheet' type='text/css'>
}

<div class="header">
    <a href="/" class="no-underline">
        <div class="logo">ERROR</div>
    </a>
    <div class="seperator">
    </div>
</div>
<div class="content">
    <div class="icon error">
    </div>
    <div class="text">
        <ul class="notify-content">
            @for (var i = 0; i <= AppSettings.BaseLanguages.Count() - 1; i++)
            {
                var lang = AppSettings.BaseLanguages.ElementAt(i);
                <li class="@(i == (AppSettings.BaseLanguages.Count() - 1) ? "end" : string.Empty)">
                @switch (lang.LanguageID)
                {
                    case "en-US":
                        <span>
                    	    We are sorry. The system is currently unavailable.<br />
						    Please try again later or contact administrator.
                        </span>                                                                                    
                        break;
                    case "id-ID":
                        <span>
                        Mohon maaf. Saat ini sistem tidak tersedia.
					    <br />Silahkan mencoba dilain waktu atau hubungi administrator.
                        </span>
                        break;
                    case "th-TH":
                        <span>
                        ขออภัยในความไม่สะดวก ขณะนี้ระบบยังไม่สามารถใช้งานได้ชั่วคราว อีกสักครู่
					    <br />กรุณาเข้าระบบใหม่อีกครั้ง หรือติดต่อเจ้าหน้าที่เพื่อให้คำแนะนำ 
                        </span>
                        break;
                    case "vi-VN":
                        <span>
                        Chúng tôi thành thật xin lỗi ,vì hệ thống đang tiến hành bảo trì.
					    <br />Xin vui lòng thử lại trong giây lát sau hoặc liên hệ hỗ trợ trực tuyến 
                	    </span>                                                                                   
                        break;
                    case "zh-CN":
                        <span>
                        非常抱歉，本司服务器正在维护中，请稍后尝试登陆或联系在线客服。 
                        </span>
                        break;
                    case "zh-TW":
                        <span>
                        非常抱歉，本司服務器正在維護中，請稍後嘗試登陸或聯繫在線客服.
                        </span>
                        break;
                    default:
                        <span>
                    	    We are sorry. The system is currently unavailable.<br />
						    Please try again later or contact administrator.
                        </span>
                        break;
            }
            </li>
            }       
        </ul>     
    </div>    
</div>

@section scripts{    
    <script src="//ajax.googleapis.com/ajax/libs/jquery/1.10.2/jquery.min.js"></script>
    <script src="//ajax.googleapis.com/ajax/libs/jqueryui/1.10.3/jquery-ui.min.js"></script>
    @Scripts.Render("~/bundles/loginJs")
}