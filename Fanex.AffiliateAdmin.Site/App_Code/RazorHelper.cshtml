            <select id="@id" class="items-per-page" name="items-per-page" data-controller="@postAction">
                <option value="10" @(selectedPageSize == 10 ? "Selected" : string.Empty)>10</option>
                <option value="20" @(selectedPageSize == 20 ? "Selected" : string.Empty)>20</option>
                <option value="50" @(selectedPageSize == 50 ? "Selected" : string.Empty)>50</option>
                <option value="100" @(selectedPageSize == 100 ? "Selected" : string.Empty)>100</option>
                <option value="200" @(selectedPageSize == 200 ? "Selected" : string.Empty)>200</option>
            </select>
        </span>
    </div>
}
