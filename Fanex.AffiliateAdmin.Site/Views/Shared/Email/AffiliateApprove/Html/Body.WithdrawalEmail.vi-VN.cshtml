@using Fanex.AffiliateAdmin.Core.Configurations
@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminSiteUrl/Content/_Sites/@AppSettings.Layout/images/emailBg.jpg">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminSiteUrl/Content/_Sites/@AppSettings.Layout/images/emailBanner.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.HeaderBGColor" height="30">
                        &nbsp;&nbsp;<strong><font style="color: @Model.HeaderFontColor; font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">Thư hướng dẫn hội viên cách thức rút tiền.</font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.ContentBGColor">
                        <table width="100%" border="0">
                            <tr>
                                <td style="background-color:@Model.ContentBGColor !important; padding: 20px 15px;">
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Kính gửi @Model.FirstName,</strong><br />
                                        <br />
                                        Xin chúc mừng bạn đã trở thành thành viên chương trình liên kết @(Model.SystemName) của chúng tôi.<br /><br />

                                        Để đảm bảo việc thanh toán cho bạn nhanh hơn, xin vui lòng dành chút thời gian để đọc tiến trình rút tiền như sau đây:<br /><br />

                                        1. Xin vui lòng đăng ký 1 tài khoản đặt cược của @(Model.SystemName).<br /><br />
                                        2. Gửi thư đến <a href="mailto:@Model.MailContact">@Model.MailContact</a> thông báo cho chúng tôi tên tài khoản mới này và cả tên tài khoản liên kết.<br /><br />
                                        3. Sau khi gửi thư cho chúng tôi biết tài khoản @(Model.SystemName), xin đăng nhập tài khoản liên kết và chọn "Thông tin cá nhân", đổi hình thức thanh toán thành "Tài khoản đặt cược" và gửi đi.<br /><br />
                                        4. Hoa hồng sẽ được thanh toán  mỗi tháng 1 lần, sau khi đăng nhập vào tài khoản liên kết và nhấp vào "Yêu cầu rút tiền", sau đó điền số tiền và gửi đi.<br /><br />
                                        5. Nếu yêu cầu rút tiền của bạn được chấp nhận, tiền hoa hồng trong tài khoản liên kết của bạn sẽ tự động chuyển vào tài khoàn đặt cược.<br /><br />
                                        6. Bạn có thể rút số tiền hoa hồng từ tài khoản đặt cược bất cứ lúc nào mà không tốn bất kỳ chi phí nào.<br /><br />

                                        Chú ý:<br /><br />
                                        1. Tài khoản @(Model.SystemName) mới đăng ký chỉ dùng cho việc rút tiền, xin đừng sử dụng tài khoản này để gửi tiền và cá cược.<br /><br />
                                        2. Tên đăng ký trong tài khoản @(Model.SystemName) và tài khoản liên kết phải giống nhau, và phải là tên thật của bạn. <br /><br />
                                        3. Các bước trên chỉ giành cho lần rút tiền đầu tiên, từ lần thứ hai trở đi bạn chỉ cần lặp lại bước 4,5 và 6.<br /><br />

                                        Mọi thắc mắc và yêu cầu xin vui lòng liên hệ ngay với chúng tôi.<br /><br />

                                        Chân thành cảm ơn,<br /><br />
                                        Bộ phận liên kết @Model.SystemName.<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="@Model.CopyrightBGColor" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: @Model.CopyrightFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © Bản quyền @Model.CopyrightYear <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="@Model.FooterBGColor" height="40">
                        <font style="font-size: 12px; color: @Model.FooterFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            Đây là lá thư tự động do hệ thống gửi, xin vui lòng không trả lời trực tiếp lá thư này.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>