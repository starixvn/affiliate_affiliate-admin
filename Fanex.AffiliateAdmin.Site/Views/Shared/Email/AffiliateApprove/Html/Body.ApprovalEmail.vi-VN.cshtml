@using Fanex.AffiliateAdmin.Core.Configurations
@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminRootLink/Content/_Sites/@AppSettings.Layout/images/emailBg.jpg">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminRootLink/Content/_Sites/@AppSettings.Layout/images/emailBanner.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.HeaderBGColor" height="30">
                        &nbsp;&nbsp;<strong><font style="color: @Model.HeaderFontColor; font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">Xác nhận thành viên chương trình kết nối @Model.SystemName</font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.ContentBGColor">
                        <table width="100%" border="0">
                            <tr>
                                <td style="background-color:@Model.ContentBGColor !important; padding: 20px 15px;">
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Kính gửi Quý khách,</strong><br />
                                        <br />
                                        Xin chúc mừng, bạn đã là hội viên chương trình liên kết @Model.SystemName.<br />
                                        <br />
                                        Để chúng tôi có thể phục vụ bạn tốt hơn, xin vui lòng cập nhật thông tin cá nhân
                                        mới nhất và bao gồm website mới nhất (nếu có) trong "Thông tin cá nhân" tại trang
                                        chương trình liên kết @Model.SystemName.<br />
                                        <br />
                                        Xin vui lòng gửi thư đến <a href="mailto:@Model.MailContact">@Model.MailContact</a>
                                        để thông báo cho chúng tôi chính xác website hoặc URLs mà bạn dự định đặt quảng
                                        cáo của @Model.SystemName. Nếu bạn có nhu cầu thay đổi về kích cỡ của biểu ngữ,
                                        xin liên hệ với chúng tôi, chúng tôi sẽ hỗ trợ cho bạn trong thời gian sớm nhất.<br />
                                        <br />
                                        Xin lưu ý rằng, tài khoản của bạn sẽ bị đóng nếu như website hoặc URLs mà bạn đăng
                                        ký không đặt quảng cáo của @Model.SystemName trong vòng 7 ngày sau khi được thông
                                        báo đã trở thành hội viện của chúng tôi, trừ trường hợp bạn đã gửi thư giải thích
                                        với chúng tôi trước.<br />
                                        <br />
                                        Chúng tôi chúc bạn nhiều may mắn, và mong rằng bạn sẽ tận dụng lưu lượng trang web
                                        của bạn để gặt được lợi nhuận cao nhất.<br />
                                        <br />
                                        Chân thành cảm ơn.<br />
                                        <br />
                                        Bộ phận liên kết @Model.SystemName.<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="@Model.CopyrightBGColor" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: @Model.CopyrightFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © Bản quyền @Model.CopyrightYear <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="@Model.FooterBGColor" height="40">
                        <font style="font-size: 12px; color: @Model.FooterFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            Đây là lá thư tự động do hệ thống gửi, xin vui lòng không trả lời trực tiếp lá thư này.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>