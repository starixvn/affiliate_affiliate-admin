@{
    ViewBag.Title = Lang.AddAffDomain;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using Fanex.AffiliateAdmin.Models

@model Fanex.AffiliateAdmin.Models.DomainViewModel

@using (Html.BeginForm("AffDomainAdd", "Domain", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    <fieldset>
         <div class="control-group">
            @Html.LabelFor(m => m.DomainName, new { @class = "control-label" })            
            <div class="controls">
                @Html.TextBoxFor(m => m.DomainName)
            </div>
        </div>

         <div class="control-group">
            <div class="controls">
                <button type="submit" class="btn">@Lang.Add</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </fieldset>    
}


@section scripts{ 
    <script src="~/Scripts/site/DomainAff.js" type="text/javascript"></script>
    @if (ViewBag.Result != null){
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.DOMAIN.ReRenderAfterPaged);
        </script>
    }
}
