@using Fanex.AffiliateAdmin.Core.Configurations
@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminRootLink/www/dist/style/@AppSettings.Layout/assets/static/emailBg.jpg">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminRootLink/www/dist/style/@AppSettings.Layout/assets/static/emailBanner.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.HeaderBGColor" height="30">
                        &nbsp;&nbsp;<strong><font style="color: @Model.HeaderFontColor; font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">您的合作夥伴帳戶信息</font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.ContentBGColor">
                        <table width="100%" border="0">
                            <tr>
                                <td style="background-color:@Model.ContentBGColor !important; padding: 20px 15px;">
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>尊敬的 @Model.FirstName,</strong><br />
                                        <br />
                                        恭喜您,您的@(Model.SystemName)合作夥伴加盟申請已獲核准!<br /><br />

                                        歡迎您成為@(Model.SystemName)合作大家庭中的一員，並祝愿我們之間的合作能成為現代商業共贏典範.請使用以下信息登入您的@(Model.SystemName)合作夥伴帳號：:<br /><br />

                                        文字鏈接: <a href="@Model.AffiliateSiteUrl">@Model.AffiliateSiteUrl</a><br />
                                        用戶名: @Model.Username<br />
                                        密碼: @Model.Password<br /><br />

                                        您可在該帳戶內查詢到合作夥伴跟踪鏈接以及橫幅等促銷素材，無需猶豫，趕快利用您的流量開始賺錢吧！<br /><br />
  
                                        如果您遇到任何疑問需要幫助，歡迎隨時聯繫我們. <br /><br />

                                        誠摯的,<br /><br />
                                        @(Model.SystemName)合作夥伴團隊<br />
                                        <a href="mailto:@(Model.MailContact)">@(Model.MailContact)</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="@Model.CopyrightBGColor" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: @Model.CopyrightFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © 版權所有 @Model.CopyrightYear <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="@Model.FooterBGColor" height="40">
                        <font style="font-size: 12px; color: @Model.FooterFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            此郵件為系統郵件，請不要直接回复。
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>