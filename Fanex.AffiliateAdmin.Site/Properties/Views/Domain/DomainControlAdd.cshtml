@{
    ViewBag.Title = Lang.AddMemberSiteDomain;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using Fanex.AffiliateAdmin.Models

@model Fanex.AffiliateAdmin.Models.DomainControlViewModel

@using (Html.BeginForm("DomainControlAdd", "Domain", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    <fieldset>
         <div class="control-group">
            @Html.LabelFor(m => m.Country, new { @class = "control-label" })            
            <div class="controls">
                @Html.DropDownListFor(m => m.Country, Model.CountryListSelectItem)
            </div>
        </div>
         <div class="control-group">
            @Html.LabelFor(m => m.AffDomain, new { @class = "control-label" })            
            <div class="controls">
                @Html.DropDownListFor(m => m.AffDomain, Model.AffDomainListSelectItem)
            </div>
        </div>
         <div class="control-group">
            @Html.LabelFor(m => m.MemberDomain, new { @class = "control-label" })            
            <div class="controls">
                @Html.DropDownListFor(m => m.MemberDomain, Model.MemberDomainListSelectItem)
            </div>
        </div>
         <div class="control-group">
            @Html.LabelFor(m => m.Status, new { @class = "control-label" })            
            <div class="controls">
                @Html.CheckBoxFor(m => m.Status)
            </div>
        </div>

         <div class="control-group">
            <div class="controls">
                <button type="submit" class="btn">@Lang.Add</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </fieldset>    
}


@section scripts{ 
    <script src="~/Scripts/site/DomainControl.js" type="text/javascript"></script>
    @if (ViewBag.Result != null){
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.DOMAINCONTROL.ReRenderAfterPaged);
        </script>
    }
}
