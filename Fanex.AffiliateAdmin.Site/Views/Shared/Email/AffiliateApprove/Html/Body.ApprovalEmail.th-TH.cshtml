@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminSiteUrl/Content/themes/theme1/images/email_bg.png">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminSiteUrl/Content/themes/theme1/images/email_top.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="#a30003" height="25">
                        &nbsp;&nbsp; <strong style="color: #ffffff;"><font style="font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">เรื่อง ข้อมูลเพิ่มเติมเกี่ยวกับพันธมิตร </font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="#ffffff">
                        <table style="text-align: left" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td style="padding: 20px 15px">
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>เรียน @(Model.FirstName),</strong><br />
                                        <br />
                                        ขอแสดงความยินดี ตอนนี้คุณได้เป็นสมาชิกพันธมิตรกับ @Model.SystemName เรียบร้อยแล้ว<br />
                                        <br />
                                        เพื่อที่จะได้ช่วยเหลือคุณได้ดีขึ้น กรุณาเข้าไปแจ้งข้อมูลส่วนตัวปัจจุบันของท่าน ร่วมถึงเวปไซค์อื่นอื่นของคุณ
                                        (ถ้ามี)<br />
                                        <br />
                                        ในส่วนของบัญชีของฉัน กรุณาแจ้งกับเราทางอีเมลล์ได้ที่ <a href="mailto:@Model.MailContact">@Model.MailContact</a>
                                        ถึงเวบไซค์ที่คุณกำลังจะเอาแบนเนอร์เราไปวาง ถ้ามาความจำเป็นต้องการขอแบนเนอร์ในขนาดอื่นอื่น
                                        กรุณาแจ้งให้เราทราบเราจะจัดเตรียมให้คุณโดยเร็วที่สุด กรุณารับทราบว่า บัญชีของท่านจะถูกปิด
                                        หากแบนเนอร์ของ @Model.SystemName ไม่ได้ถูกนำไปวางในเวบไซค์ที่คุณสมัครสมาชิกเข้ามาภายในเวลา
                                        7 วันหลังจากใบสมัครของคุณได้รับการอนุมัติ นอกเสียจากว่าคุณได้แจ้งไว้เป็นลายลักษณ์อักษรกับทางเรา<br />
                                        <br />
                                        เราหวังเป็นอย่างยิ่งว่าคุณจะทำกำไรในการร่วมธุรกิจนี้ได้อย่างมาก
                                        <br />
                                        <br />
                                        ขอบคุณ<br />
                                        <br />
                                        ขอแสดงความนับถือ<br />
                                        <br />
                                        ทีมงานพันธมิตร @Model.SystemName<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="#d7d7d7" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © ลิขสิทธิ์ @DateTime.Now.Year <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="#a30003" height="40">
                        <font style="font-size: 12px; color: #eba6a6; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            อีเมลล์นี้เป็นการอีเมลล์ที่ถูกส่งโดยระบบ  กรุณาอย่าตอบกลับอีเมลล์นี้โดยตรง
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>