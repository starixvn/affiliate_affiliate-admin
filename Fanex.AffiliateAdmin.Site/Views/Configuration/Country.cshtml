@{
    ViewBag.Title = Lang.CountryList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Utilities
@model Fanex.AffiliateAdmin.Models.CountryViewModel
@section iconcss{
settings
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Configuration, 1, "Configurations")
}
<div class="search-panel search-country">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    @using (Html.BeginForm("GetCountryList", "Configuration", FormMethod.Post, new { id = "ConfigurationForm", @class = "row-fluid" }))
    {
        <div class="span12 search-form">
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    @Html.LabelFor(m => m.Name, Lang.SearchByName)
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control width-140", placeholder = Lang.All, maxlength = "100" })
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" class="btn btn-default" id="btnSubmit">
                        @Lang.Submit
                    </button>
                </div>
            </div>
        </div>
    }
</div>
<div id="gridId" class="freegrid content-grid">
</div>
@section scripts{
    <script type="text/javascript">
        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.CountryList",
                showButtonsWhenNoData: true,
                customButtons: '<input type="button" name="btnAdd" value="" title="@Lang.AddNewCountry" class="btnAdd icon-add-config" id="btnAddgridId">'
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Name", Width: 200, Name: "CountryName", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Description", Width: 250, Name: "Description", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Code", Width: 50, Name: "Icon", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.DisplayOrder", Width: 150, Name: "DisplayOrder", HeaderAlign: "center", CellAlign: "center" },
                {
                    HeaderText: "@Lang.IsEnabled",
                    Width: 120,
                    Name: "IsEnabled",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function formatCheckbox(rIndex, record, cell, cellFormated) {
                        var check = record.IsEnabled ? "checked=checked" : '';
                        return "<input type='checkbox' disabled='disabled'" + check + "/>";
                    }
                },
                {
                    HeaderText: "@Lang.Action",
                    Width: 70,
                    Name: "Update",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a title='@Lang.Edit' href='javascript:Country.showCountryDlg(\"" + record.CountryID + "\");'><i class='icon-edit'></i></a>"
                            + "&nbsp;&nbsp;<a title='@Lang.Remove' href='javascript:Country.deleteCountry(\"" + record.CountryID + "\");'><i class='icon-remove'></i></a>";
                    }
                }
            ],
            showPager: true,
            customPager: true,
            gridExpandHeight: 290,
            allowTruncate: false,
            indexNumberColumn: 0
        };

        var MSG =
        {
            AddNewCountry: '@Lang.AddNewCountry',
            UpdateCountry: '@Lang.UpdateCountry',
            InvalidCountry: '@Lang.InvalidCountry',
            DeleteCountryMsg: '@Lang.DeleteCountryMsg',
            NoInfo: '@Lang.NoInfo',
            Remove: '@Lang.Remove',
            Edit: '@Lang.Edit'
        };

    </script>
    @Scripts.Render("~/scripts/country")
}
