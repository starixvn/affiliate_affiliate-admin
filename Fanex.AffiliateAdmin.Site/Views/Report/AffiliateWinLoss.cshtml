@{
    ViewBag.Title = Lang.AffiliateWinLossReport;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section iconcss{
report
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Reports, 2, "report")
}
@{
    var now = SystemTimeService.GetSystemDateTime();
    var fromDate = new DateTime(now.Year, now.Month, 1).AddMonths(-1);
    var toDate = now;
}

@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Enumerations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Services
@model Fanex.AffiliateAdmin.Models.AffiliateWinLossViewModel
<div class="search-panel search-affiliate-win-loss">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", Common.GetReportInfo(ReportType.AffiliateWinLoss), false, true)
    @using (Html.BeginForm("AffiliateWinLoss", "Report", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {            
        <div class="span12 search-form search-company-winloss">
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="AffName" class="txt">@Lang.Affiliate</label>
                    <input type="text" class="form-control width-140" id="AffName" name="AffName" placeholder="@Lang.All" maxlength="100"/>
                </div>
                <div class="cell">
                    <label for="AffTypes" class="txt">@Lang.AffType</label>
                    @Html.DropDownCheckList("AffTypes", Model.AffTypeOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="CommGroups" class="txt" title="@Lang.CommissionGroup" >@Lang.CommGroup</label>
                    @Html.DropDownCheckList("CommGroups", Model.CommissionGroupOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="PreferLanguages" class="txt">@Lang.Language</label>
                    @Html.DropDownCheckList("PreferLanguages", Model.PreferLanguageOptionList, true, true, new { @class = "width-140" })
                </div>
            </div>
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="Currencies" class="txt">@Lang.Currency</label>
                    @Html.DropDownCheckList("Currencies", Model.CurrencyOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="GroupBy" class="txt">@Lang.GroupBy</label>
                    @Html.DropDownCheckList("GroupBy", Model.GroupByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="FromDate" class="txt">@Lang.From</label>
                    @Html.MonthPicker("FromDate", fromDate, AppSettings.SystemStartDate, now, false)
                </div>
                <div class="cell">
                    <label for="ToDate" class="txt">@Lang.To</label>
                    @Html.MonthPicker("ToDate", toDate, AppSettings.SystemStartDate, now, false)
                </div>
            </div>
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.BaseCurrency</label>
                    @Html.DropDownCheckList("BaseCurrency", Model.BaseCurrencyOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="DrawFilter" class="txt">@Lang.DrawFilter</label>
                    @Html.DropDownCheckList("DrawFilter", Model.DrawFilterOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    @Html.Label("SortBy", Lang.SortBy, new { @class = "txt" })
                    @Html.DropDownCheckList("SortBy", Model.SortByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="Products" class="txt">@Lang.Product</label>
                    @Html.DropDownCheckList("Products", Model.ProductOptionList, true, false, new { @class = "width-140" })
                </div>
                <div class="cell checkbox width-160">
                    @Html.CheckBoxFor(m => m.ExcludeTest)
                    <label for="ExcludeTest">
                        @Lang.ExcludeTestAccounts
                    </label>
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button id="btnSubmit" type="button" class="btn btn-default">@Lang.Submit</button>
                    <input type="hidden" name="ViewMode" id="ViewMode" value="0" />
                </div>
            </div>
        </div>
    }
</div>

<div id="gridId" class="freegrid" data-colheight="200" data-expheight="350" />

<div class="content legend">
    <div class="row-fluid">
        <ul class="unstyled inline status pull-right">
            <li><span class="approved"></span>@Lang.Approved</li>
            <li><span class="locked"></span>@Lang.LockedOut</li>
            <li><span class="closed"></span>@Lang.Closed</li>
        </ul>
    </div>
</div>

