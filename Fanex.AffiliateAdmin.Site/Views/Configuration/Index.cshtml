@{
    ViewBag.Title = Lang.ConfigurationList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Utilities
@model Fanex.AffiliateAdmin.Models.ConfigurationViewModel
@section iconcss{
settings
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Configuration, 0, "configuration")
}
<div class="search-panel search-config">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    @using (Html.BeginForm("GetSystemSettingList", "Configuration", FormMethod.Post, new { @class = "row-fluid" }))
    {
        <div class="span12 search-form">
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    @Html.LabelFor(m => m.Key, Lang.SearchByKey)
                    @Html.TextBoxFor(m => m.Key, new { @class = "form-control width-140", placeholder = Lang.All, maxlength = "100" })
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.Value, Lang.Value)
                    @Html.TextBoxFor(m => m.Value, new { @class = "form-control width-140", placeholder = Lang.All, maxlength = "100" })
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.TypeList, Lang.Type)
                    @Html.DropDownList("Type", Model.TypeOptionList, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" class="btn btn-default" id="btnSubmit">
                        @Lang.Submit
                    </button>
                </div>
            </div>
        </div>
    }
</div>
<div id="gridId" class="freegrid content-grid" colheight="200" expheight="290">
</div>
@section scripts{
    <script type="text/javascript">
        var gridOption = {
            showTitle: true,
            titleInfo:
            {
                text: "@Lang.ConfigurationList",
                showAddButton: true,
                addFunction: function() {
                    Configuration.addConfiguration();
                }
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Key", Width: 200, Name: "SName", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Type", Width: 80, Name: "Type", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Value", Width: 300, Name: "SValue", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Description", Width: 250, Name: "Description", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Environment", Width: 120, Name: "Environment", HeaderAlign: "center", CellAlign: "left" },
                {
                    HeaderText: "@Lang.Action",
                    Width: 70,
                    Name: "Update",
                    CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a title='{0}' href='javascript:Configuration.showConfigurationDlg(".format(MSG.Edit) + record.SId + ");'><i class='icon-edit'></i></a>"
                            + "&nbsp;&nbsp;<a title='{0}' href='javascript:Configuration.deleteConfiguration(".format(MSG.Remove) + record.SId + ");'><i class='icon-remove'></i></a>";
                    }
                }
            ],
            showPager: true,
            customPager: true,
            gridExpandHeight: 290,
            allowTruncate: true,
            indexNumberColumn: 0
        };

        var MSG =
        {
            AddNewConfiguration: '@Lang.AddNewConfiguration',
            UpdateConfiguration: '@Lang.UpdateConfiguration',
            InvalidConfiguration: '@Lang.InvalidConfiguration',
            DeleteConfigurationMsg: '@Lang.DeleteConfigurationMsg',
            Remove: '@Lang.Remove',
            Edit: '@Lang.Edit'
        };

    </script>
    <script src="~/Scripts/site/Configuration.js" type="text/javascript"></script>
}
