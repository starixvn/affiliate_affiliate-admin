@using Fanex.AffiliateAdmin.Core.Configurations
@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminSiteUrl/Content/_Sites/@AppSettings.Layout/images/emailBg.jpg">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminSiteUrl/Content/_Sites/@AppSettings.Layout/images/emailBanner.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.HeaderBgColor" height="30">
                        &nbsp;&nbsp;<strong><font style="color: @Model.HeaderFontColor; font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">Your Application</font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.ContentBgColor">
                        <table width="100%" border="0">
                            <tr>
                                <td style="background-color:@Model.ContentBgColor !important; padding: 20px 15px;">
                                    <font style=" color: @Model.ContentFontColor; font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Dear @Model.FirstName,</strong><br />
                                        <br />
                                        I regret to inform you that your application to join the @Model.SystemName Affiliates
                                        program has been disapproved/rejected. I apologize for any inconvenience this may
                                        have caused.<br />
                                        <br />
                                        If you have any queries regarding why your website has not met the required criteria,
                                        please feel free to contact me at <a href="mailto:@Model.MailContact">@Model.MailContact</a>.<br />
                                        <br />
                                        Sincerely,<br />
                                        <br />
                                        @Model.SystemName Affiliates Team<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="@Model.CopyrightBgColor" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: @Model.CopyrightFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © Copyright @Model.CopyrightYear <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="@Model.FooterBgColor" height="40">
                        <font style="font-size: 12px; color: @Model.FooterFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            This is a system auto generated email, please do not reply to this email directly.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>