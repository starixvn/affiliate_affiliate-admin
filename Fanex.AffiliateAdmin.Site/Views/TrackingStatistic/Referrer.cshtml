@{
    ViewBag.Title = Lang.ReferrersStatistics;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}

@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities

@model Fanex.AffiliateAdmin.Models.ReferrerViewModel

@section iconcss{
    report
}

@{
    var now = DateTime.Now;
    var fromDate = Model.FromDate.HasValue ? Model.FromDate.Value : new DateTime(now.Year, now.Month, 1);
    var toDate = Model.ToDate.HasValue ? Model.ToDate.Value : now;
}

@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 5, string.Empty, 0)
    <div class="line line-statement">
        <div class="ic-open-window" title="@Lang.FullScreen"></div>
        <div class="ic-reload" title="@Lang.RefreshPage"></div>
    </div>
}

<div class="search-panel search-statement no-border">
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    <div class="span12 search-form">
        <div class="row-fluid row-form end-search">
            <div class="cell">
                @Html.LabelFor(m => m.FromDate, new { @class = "txt", style = "min-width: 50px;" })
                @Html.DatePicker("FromDate", fromDate, AppSettings.SystemStartDate, DateTime.Now)
            </div>
            <div class="cell">
                @Html.LabelFor(m => m.ToDate, new { @class="txt", style = "min-width: 50px;" })
                @Html.DatePicker("ToDate", toDate, AppSettings.SystemStartDate, DateTime.Now)
            </div>
        </div>
        <div class="row-fluid row-form btn-action">
            <div class="span12">
                <button type="submit" class="btn" id="btnSubmit">
                    @Lang.Submit
                </button>
            </div>
        </div>
    </div>
</div>
<div class="w-space"></div>

<div id="gridId" class="freegrid"></div>

@section scripts{
    <script type="text/javascript">
        var MSG = {
            NoInfo: "@Lang.NoInfo",
            Title: "@Lang.ReferrersStatistics",
            LandingPagesStatisticDetails: "@Lang.LandingPagesStatisticDetails",
            ReferrersStatisticDetails: "@Lang.ReferrersStatisticDetails"
        };

        var gridOption = {
            language: '@AppSession.Language',
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.ReferrersStatistics"
            },
            columns: [
                        { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                        { HeaderText: "@Lang.SiteURLs", Width: 250, Name: "DomainReferrer", HeaderAlign: "center", Formatter:
                            function (rowIndex, rowData, cell, cellFormated) {
                                return "<a href=\"javascript:STATISTIC.showReferrerDetail('" + rowData.DomainReferrer + "');\">" + cell.Value + "</a>";
                            }
                        },
                        { HeaderText: "@Lang.TotalClicks", Width: 140, Name: "TotalClick", HeaderAlign: "center", CellAlign: "right" },
                        { HeaderText: "@Lang.UniqueClicks", Width: 140, Name: "UniqueClick", HeaderAlign: "center", CellAlign: "right" },
                        { HeaderText: "@Lang.Signups", Width: 140, Name: "Signups", HeaderAlign: "center", CellAlign: "right" },
                        { HeaderText: "@Lang.FDM", Width: 140, Name: "FDM", HeaderAlign: "center", CellAlign: "right" }
                   ],
            gridExpandHeight: 290,
            showNumberColumn: true,
            showTitle: true
        }
    </script>
    @Scripts.Render("~/scripts/trackingstatistic")
}