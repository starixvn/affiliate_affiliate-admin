  <appSettings file="Web.AppSetting.config">
    <!--Url use for checking downtime-->
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="app_mail_address" value="net.tcp://10.99.99.37:8585/MailService" />
    <add key="RemoteRefURL" value="tcp://10.40.40.29:8098/CallGetRefFunction" />
    <add key="ITMail" value="alex.nguyen@starixsoft.com" />
  </appSettings>
  <ONEbook.UM ServiceUris="http://10.99.99.37:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="09:00" UMTo="11:00" SiteId="32" UMPageUrl="~/Notify">
