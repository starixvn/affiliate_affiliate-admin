@{
    ViewBag.Title = Lang.AffManagement;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Services
@section iconcss {
    aff-list
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Affiliate, Model.IsFavorite ? 0 : 1, "AffManagement")
}
@{
    var now = SystemTimeService.GetSystemDateTime();
}
@model Fanex.AffiliateAdmin.Models.AffiliateListViewModel
<div class="search-panel search-afflist">
    <div class="ic-reload" title="@Lang.RefreshPage"></div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", Lang.AffiliateListInfo, false, true)
    @using (Html.BeginForm("AffiliateList", "Affiliate", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {    
        @Html.HiddenFor(t => t.IsFavorite)
        <div class="span12 search-form search-affiliate">
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="AffName" class="txt">@Lang.Affiliate</label>
                    <input type="text" class="form-control width-140" id="AffName" name="AffName" placeholder="@Lang.All" maxlength="100"/>
                </div>
                <div class="cell">
                    <label for="AffTypes" class="txt">@Lang.AffType</label>
                    @Html.DropDownCheckList("AffTypes", new SelectList(AppSettings.AffTypes, "TypeID", "Name"), true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="CommGroups" class="txt">@Lang.CommissionGroup</label>
                    @Html.DropDownCheckList("CommGroups", Model.CommissionGroupOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="PreferLanguages" class="txt">@Lang.Language</label>
                    @Html.DropDownCheckList("PreferLanguages", new SelectList(AppSettings.AffSupportLanguages, "LanguageID", "LanguageName"), true, true, new { @class = "width-140" })
                </div>
            </div>
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="Currencies" class="txt">@Lang.Currency</label>
                    @Html.DropDownCheckList("Currencies", new SelectList(SessionManager.CurrentSession.CurrencyList, "CurrencyID", "CurrencyCode"), true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="DateOption" class="txt">@Lang.DateOption</label>
                    @Html.DropDownCheckList("DateOption", Model.DateOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="FromDate" class="txt">@Lang.From</label>
                    @Html.DatePicker("FromDate", new DateTime(now.Year, now.Month, 1), AppSettings.SystemStartDate, now, true)
                </div>
                <div class="cell">
                    <label for="ToDate" class="txt">@Lang.To</label>
                    @Html.DatePicker("ToDate", now, AppSettings.SystemStartDate, now, true)
                </div>
            </div>
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.BaseCurrency</label>
                    @Html.DropDownCheckList("BaseCurrency", Model.BaseCurrencyOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="Status" class="txt">@Lang.Status</label>
                    @Html.DropDownCheckList("Status", Model.StatusOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="AffPlayer" class="txt">@Lang.AffPlayer</label>
                    <input type="text" class="form-control width-140" id="AffPlayer" name="AffPlayer" placeholder="@Lang.All" maxlength="100" />
                </div>
                <div class="cell">
                    <label for="SortBy" class="txt width-90">@Lang.SortBy</label>
                    @Html.DropDownCheckList("SortBy", Model.SortByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
            </div>
            <div class="row-fluid row-form end-search">
                <div class="cell checkbox">
                    @Html.CheckBoxFor(m => m.ExcludeTest)
                    <label for="ExcludeTest">
                        @Lang.ExcludeTestAccounts
                    </label>
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button id="btnSubmit" type="submit" class="btn btn-default">@Lang.Submit</button>
                </div>
            </div>
        </div>
    }
</div>
<div id="gridId" class="freegrid">
</div>
<div class="content legend">
    <div class="row-fluid">
        <ul class="unstyled inline status pull-right">
            <li><span class="approved"></span>@Lang.Approved</li>
            @if (!Model.IsFavorite)
            {
                <li><span class="rejected"></span>@Lang.Disapproved</li>
                <li><span class="pending"></span>@Lang.Pending</li>
            }
            <li><span class="closed"></span>@Lang.Closed</li>
            <li><span class="locked"></span>@Lang.Locked</li>
        </ul>
    </div>
</div>
@section scripts{
    <script type="text/javascript">
        var MSG = {
            SelectAffChangeGroup: "@Lang.SelectAffChangeGroup",
            SelectAtLeastOneAffiliate: '@Lang.SelectAtLeastOneAffiliate',
            ChangePassword: '@Lang.ChangePassword',
            ChangeAccountType: '@Lang.ChangeAccountType',
            ChangeComGroup: '@Lang.ChangeComGroup',
            CurrencyOfAffiliatesMustBeSame: '@Lang.CurrencyOfAffiliatesMustBeSame',
            CommissionGroup: '@Lang.CommissionGroup',
            BF: '@Lang.BF',
            AddToMyFavorite: '@Lang.AddToMyFavorite',
            RemoveFromMyFavorite: '@Lang.RemoveFromMyFavorite',
            ToggleSubTotal: '@Lang.ToggleSubTotal',
            UncheckPendingDisapprovedAffiliates: '@Lang.UncheckPendingDisapprovedAffiliates',
            Disapproved: '@Lang.Disapproved',
            Pending: '@Lang.Pending'
        };

        var customerListUrl = '@Url.Action("MemberList", "Affiliate")';
        var COLLAPSE_SUBTOTAL_STATUS = 0, EXPAND_SUBTOTAL_STATUS = 1;
        var subTotalStatus = COLLAPSE_SUBTOTAL_STATUS;

        var sampleGridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.AffList",
                showButtonsWhenNoData: true,
                customButtons: '<input type="button" title="@Lang.ChangeAccountType" class="icon-edit-account-type"> <input type="button" title="@Lang.ChangeComGroup" class="icon-edit-commission-group">'
            },
            columns: [
                {
                    HeaderText: "<input type='checkbox' id='chkAll'/>",
                    Width: 30,
                    Name: "ROW",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<input type='checkbox' class='chkItem' data-username='{0}' data-affid='{1}' data-testlevel='{2}' data-groupid='{3}' data-currency='{4}' data-status='{5}'/>".format(record.UserName, record.AffID, record.TestLevel, record.CommGroupID, record.CurrencyId, record.OriginalStatus.toLowerCase());
                    }
                },
                { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Username",
                    Width: 70,
                    Name: "UserName",
                    HeaderAlign: "center",
                    CellAlign: "left",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        var status = record.Status.toLowerCase();

                        var url = AFFILIATE.getAbsoluteUrl("AffiliateInfo?userName={0}".format(record.UserName));
                        var favorite = record.Favorite ? "favor-check" : 'favor-uncheck';
                        var title = record.Favorite ? MSG.RemoveFromMyFavorite : MSG.AddToMyFavorite;
                        var action = record.Favorite ? -1 : 1;

                        if (status === "@Lang.Disapproved" || status === "@Lang.Pending") {
                            var favorStr = "";
                        } else {
                            var favorStr = "<div onclick='javascript:AffiliateList.changeFavorite(this, {0});' class='{1}' data-action='{2}' title='{3}'>&nbsp;</div>".format(record.AffID, favorite, action, title);
                        }

                        return "<a href='{0}'>{1}</a> {2}".format(url, record.UserName, favorStr);
                    }
                },
                {
                    HeaderText: "@Lang.Password",
                    Width: 60,
                    Name: "password",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        var status = record.Status.toLowerCase();

                        if (status === "@Lang.Disapproved" || status === "@Lang.Pending") {
                            return "";
                        } else {
                            return "<a href='javascript:AffiliateList.changePassword({0}, \"{1}\")' title='{2}'><i class='icon-edit'></i></a>".format(record.AffID, record.UserName, MSG.ChangePassword);
                        }
                    }
                },
                { HeaderText: "@Lang.FirstName", Width: 80, Name: "FirstName", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.LastName", Width: 80, Name: "LastName", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.EmailAddress", Width: 150, Name: "Email", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Language", Width: 60, Name: "LanguageName", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.AffType", Width: 70, Name: "AffTypeName", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.RegisteredDate", Width: 90, Name: "RegisteredDateStr", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.ApprovalDate", Width: 80, Name: "ApprovedDateStr", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Status", Width: 70, Name: "Status", HeaderAlign: "center", CellAlign: "left",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<span style='text-transform: capitalize;'>{0}</span>".format(record.Status);
                    }
                },
                {
                    HeaderText: "@Lang.AccountType",
                    Width: 110,
                    Name: "AccountType",
                    HeaderAlign: "center",
                    CellAlign: "left",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a href='javascript:AffiliateList.changeAccountType({0}, \"{1}\", {2});' >{3}</a>".format(record.AffID, record.UserName, record.TestLevel, record.AccountType);
                    }
                },
                {
                    HeaderText: "<span title='@Lang.CommissionGroup'>@Lang.CommGroup</span>",
                    Width: 100,
                    Name: "CommGroupName",
                    HeaderAlign: "center",
                    CellAlign: "left",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a href='javascript:AffiliateList.viewCommissionGroup({0});'>{1}</a>".format(record.CommGroupID, record.CommGroupName);
                    }
                },
                { HeaderText: "@Lang.Currency", Width: 60, Name: "Currency", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.AffPlayer", Width: 120, Name: "AffPlayer", HeaderAlign: "center", CellAlign: "left" },
                {
                    HeaderCaption: "<span title='@Lang.BFTooltip'>@Lang.BF</span>",
                    HeaderText: "<span title='@Lang.BFTooltip'>@Lang.BF</span>",
                    Width: 100, Name: "BF", HeaderAlign: "center", CellAlign: "right",
                    FormatNumber: "0,0.00", FormatNegative: '($)', IsAbs: true },
                {
                    HeaderText: "@Lang.Member",
                    Width: 65,
                    Name: "TotalMembers",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        var url = customerListUrl + "?AffName={0}".format(record.UserName);
                        return "<a href='{0}' alt='{1}'>{2}</a>".format(url, record.UserName, record.TotalMembers);
                    }
                }
            ],
            showPager: true,
            customPager: true,
            allowTruncate: true,
            gridExpandHeight: 220,
            indexNumberColumn: 1,
            showFooter: true,
            rowCssClass: function(rowIndex, rowData) {
                return rowData.OriginalStatus.toLowerCase();
            }
        };
    </script>
    @Scripts.Render("~/scripts/togglemanager")
    @Scripts.Render("~/scripts/affiliatelist")
}
