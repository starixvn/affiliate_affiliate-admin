@using Fanex.AffiliateAdmin.Core.Configurations
@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
@{
    var appSetting = DependencyResolver.Current.GetService<IAppSetting>();
    var layout = appSetting.Layout;
}
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminRootLink/www/dist/style/@(layout)/assets/static/emailBg.jpg">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminRootLink/www/dist/style/@(layout)/assets/static/emailBanner.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.HeaderBGColor" height="30">
                        &nbsp;&nbsp;<strong>
                            <font style="color: @Model.HeaderFontColor; font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">Affiliate Withdrawal Guidance</font>
                        </strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.ContentBGColor">
                        <table width="100%" border="0">
                            <tr>
                                <td style="background-color:@Model.ContentBGColor !important; padding: 20px 15px;">
                                    <font style=" color: @Model.ContentFontColor; font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Dear @Model.FirstName,</strong><br />
                                        <br />
                                        To ensure for a faster payout for your affiliate, please take some time to read the following procedure for withdrawal:<br />
                                        <br />
                                        1. Please do register a new @Model.SystemName betting account.<br />
                                        <br />
                                        2. Send an email to <a href="mailto:@Model.MailContact">@Model.MailContact</a> and state your @Model.SystemName username together with your affiliate username.<br />
                                        <br />
                                        3. After sending email to us for your @Model.SystemName account, please login your affiliate account and click on "My Account", at the payment Information column, please change your payment method to @Model.SystemName Player Account, fill in your @Model.SystemName username and click submit.<br />
                                        <br />
                                        4. We will settle member's commission payout once in a month, please access your affiliate account and click on Payment request, enter the amount and request Payout.<br />
                                        <br />
                                        5. If your withdrawal request is approved, your fund will be automatically transferred to your @Model.SystemName betting account.<br />
                                        <br />
                                        6. You may request a withdrawal from your @Model.SystemName betting account anytime and there will be no additional charges.<br />
                                        <br />
                                        Please take note:<br />
                                        <br />
                                        1. Your @Model.SystemName betting account is for affiliate purpose only; please do not make any deposit or placing bet.<br />
                                        <br />
                                        2. Your @Model.SystemName betting account registered name must be the same registered name that you had registered in your affiliate account, and it must be your real name.<br />
                                        <br />
                                        3. The above procedures is for first time withdrawal affiliate members only, if request for 2nd or 3rd withdrawal, please refer to step 4, 5 and 6.<br />
                                        <br />
                                        Please do not hesitate to contact us if you have any further question.<br />
                                        <br />
                                        Sincerely,<br />
                                        <br />
                                        @Model.SystemName Affiliates Team<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a>
                                    </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="@Model.CopyrightBGColor" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: @Model.CopyrightFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © Copyright @Model.CopyrightYear <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="@Model.FooterBGColor" height="40">
                        <font style="font-size: 12px; color: @Model.FooterFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            This is a system auto generated email, please do not reply to this email directly.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>