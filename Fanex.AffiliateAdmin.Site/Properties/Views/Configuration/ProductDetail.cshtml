@{
    ViewBag.Title = Lang.UpdateCountry;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@model Product
@using (Html.BeginForm("UpdateProduct", "Configuration", FormMethod.Post, new { @class = "form-horizontal form-popup" }))
{
    @Html.ValidationSummary()
    <div class="popup-content">
        @Html.HiddenFor(m => m.ProductID)
        <div class="control-group">
            @Html.LabelFor(m => m.ProductName, Lang.Name, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control" })
                <span class="required">*</span>
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Description, Lang.Description, new { @class = "control-label" })
            <div class="controls">
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control medium-textarea" })
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.BettypeList, Lang.BettypeList, new { @class = "control-label" })
            <div class="controls">
                @Html.TextAreaFor(m => m.BettypeList, new { @class = "form-control medium-textarea" })
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.API_ProductID, Lang.APIProductID, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.API_ProductID, new { @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="popup-footer">
        <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnUpdate" class="btn">@Lang.Update</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </div>
}
@section scripts{
    @if (ViewBag.Result != null)
    {
        var result = (Fanex.AffiliateAdmin.Models.ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.Product.ReRenderAfterPaged);
        </script>
    }
    <script src="~/Scripts/site/Product.js" type="text/javascript"></script>
}
