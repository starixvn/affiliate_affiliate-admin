@{
    var currentSession = Fanex.AffiliateAdmin.Core.Session.SessionManager.CurrentSession;
}
@using Fanex.AffiliateAdmin.Core.Configurations
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="@Url.Content(string.Format("~/Content/_Sites/{0}/images/favicon.jpg?{1}", AppSettings.Layout, DateTime.Now.Ticks))" rel="shortcut icon" type="image/jpg" />
    <meta name="viewport" content="width=device-width" />
    @Styles.Render("~/bundles/css")
    @RenderSection("css", required: false)
    @Scripts.Render("~/bundles/jquery")
</head>
<body>
    @Html.Hidden("IsIT", currentSession.IsIT ? 1 : 0)
    @Html.Hidden("BaseUrl", Url.Content("~/"))
    @Html.Hidden("TimeZone", AppSettings.ServerTimeZone)
    <div class="container" style="overflow-x: hidden">
        <div class="row-fulid">
            <div class="span12 content w-none">
                <!--Submenu box-->
                <div class="row-fluid submenu">
                    <div class="span12 menu">
                        <div class="span1 icon-submenu @RenderSection("iconcss", required: false)"></div>
                        @RenderSection("submenu", required: false)
                    </div>
                </div>
                <!--content html-->
                <div class="row-fluid main-content contentIframe" id="frmBottom">
                    <div class="span12">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/js")
    @if (currentSession.ApplicationMode == Fanex.AffiliateAdmin.Core.Enumerations.AppMode.Self)
    {
        @Scripts.Render("~/Scripts/site/RecheckIn.js")
    }
    else
    {
        @Scripts.Render("~/Scripts/site/_Session.js")
    }
    <script type="text/javascript">

        var Lang = {
            NoDataInfo: '@Html.Raw(Lang.NoInfo)',
            SubTotal: '@Lang.SubTotal',
            Total: '@Lang.Total',
            TotalBaseCurrency: '@Lang.Total (@AppSettings.BaseExchange.Prefix)',
            All: "@Lang.All",
            Uncheck: "@Lang.Uncheck",
            Selected: "@Lang.Selected",
            SelectAnOption: "@Lang.SelectAnOption",
            ChangePassword: "@Lang.ChangePassword",
            CollapseExpandDataRows: "@Lang.CollapseExpandDataRows",
            Close: "@Lang.Close"
        };

        var System = {
            Currency: '@AppSettings.BaseExchange.Code',
            Prefix: '@AppSettings.BaseExchange.Prefix',
            CurrencyId: '@AppSettings.BaseExchange.ExchangeID'
        };
    </script>

     @RenderSection("scripts", required: false)
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-93927620-2"></script>
    <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'UA-93927620-2');
    </script>
</body>
</html>
