@{
    ViewBag.Title = Lang.ChangeComGroup;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Mvc

@model Fanex.AffiliateAdmin.Models.ChangeCommissionGroupViewModel

@using (Html.BeginForm("ChangeStatus", "AffiliateInfo", FormMethod.Post, new { id = "ActionBannerForm", @class = "form-horizontal form-popup", enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary()

    @Html.HiddenFor(m => m.Status)
    <span class="information">@Lang.MsgApproveAffiliate</span>
    <fieldset>
        <legend>@Lang.Assignee</legend>
        <div class="row-fluid">
            <div class="controls-row" style="word-wrap: break-word; display: inline-block; padding: 6px 6px 4px;">
                @Model.Usernames
            </div>
        </div>
    </fieldset>
    <fieldset>
        <legend>@Lang.CommissionGroup</legend>
        <div class="row-fluid">
            <div class="controls-row span4" style="display: inline-block; padding: 6px 6px 4px;">
                @Lang.ChangeGroup:
            </div>
            <div class="bold">
                @Html.DropDownCheckList("GroupId", Model.CommissionGroupOptionList, false, false)
            </div>
        </div>
    </fieldset>

    <div class="popup-footer">
        <div class="row-fluid">
            <button type="button" id="btnSave" class="btn">@Lang.Save</button>
        </div>
    </div>
    @Html.Hidden("AffId", Model.AffIds)
}

@section scripts{
    <script type="text/javascript">
        $('#btnSave').click(function () {
            parent.AFFMASTER.changeAffInfo({
                affid: $("#AffId").val(),
                groupid: $("#GroupId").val(),
                status: $("#Status").val()
            });
        });
    </script>
}