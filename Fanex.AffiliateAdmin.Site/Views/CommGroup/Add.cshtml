@{
    ViewBag.Title = Lang.AddCommissionGroup;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@model CommGroupInfo 
@{
    long MAXAM = 100000000000000;
    var currencyDropDownAttr = new Dictionary<string, object>();
    currencyDropDownAttr.Add("class", "width-140 dropdownchecklist single-select");
    var products = AppSettings.Products.Where(t => t.IsEnabled);
}

@using (Html.BeginForm("Add", "CommGroup", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    <div class="popup-content" style="min-width:800px">
   @Html.HiddenFor(m => m.GroupID)   
   <div class="control-group">
        @Html.LabelFor(m => m.GroupName, Lang.GroupName, new { @class = "control-label" })
        <div class="controls">
            @Html.TextBoxFor(m => m.GroupName, new { maxlength = "100", @class = "form-control" })<span style="color: red"> *</span>
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(m => m.Description, Lang.Description, new { @class = "control-label" })      
        <div class="controls">
            @Html.TextBoxFor(m => m.Description, new { maxlength = "100", @class = "form-control" })
        </div>
    </div>
    <div class="control-group">
        @Html.LabelFor(m => m.QualifiedAmount, Lang.QualifiedAmount, new { @class = "control-label" })      
        <div class="controls">
            @Html.TextBox("QualifiedAmount", null, new { maxlength = "20", @class = "form-control" })<span style="color: red"> *</span>
        </div>
    </div>
     <div class="control-group">
        @Html.LabelFor(m => m.Currency, Lang.Currency, new { @class = "control-label" })      
        <div class="controls">
            @Html.DropDownListFor(m => m.Currency, new SelectList(SessionManager.CurrentSession.CurrencyList, "CurrencyID", "CurrencyCode"), currencyDropDownAttr)
        </div>
    </div>
   
    <div class="control-group">
        @Html.Label("ActiveAll", @Lang.ActiveAll, new { @class = "control-label" })
        <div class="controls">
            @Html.CheckBox("ActiveAll")
        </div>
    </div>
 
    <div class="red" id="currNotify" style="display:none;margin: 5px 5px 15px 25px">    
    </div>
        @foreach (var product in products)
        {
            <div id="tab_header@(product.ProductID)" data-productid="@(product.ProductID)" class="tab_header" data-productname="@product.ProductName">
                <div class="tab_title">                   
                    <ul>
                        <li class="expand">				
                            <span>
                                <span id="product_header@(product.ProductID)" class="product_header header_hightlight" style="cursor: pointer"> 
                                    <i id="header_icon@(product.ProductID)" class="header_icon icon-ok-circle"></i>			      
                                    @product.ProductName
                                </span>
                            </span>
                        </li>
                    </ul>			
                    <div class="textcopy">
                        <div class="cell checkbox pull-right">            
                            <label for="@(product.ProductID)">
                                <input type="checkbox" class="copy" id="@(product.ProductID)">
                                @string.Format(@Lang.CopyTierSettingFor, product.ProductName)
                            </label>
                        </div>                    
                    </div>
                </div>    
            </div>
       
            <div class="tab_content" style="" id="tab_content@(product.ProductID)">
            @{
            var deductions = AppSettings.DeductionTypes.Where(x => x.ProductID == product.ProductID);

            if (deductions.Any())
            {
                        <!--Deduction-->
                        <div class="fieldset">
                            <div class="legend">@Lang.SharingFee</div>
                            <div class="clear"></div>
                            <!--DeductionOption-->
                            <div class="row-fluid row-form deductions">
                                <table>
                                @foreach (var item in deductions)
                                {
                                    <tr>
                                        <td style="text-align: left;"><input type="checkbox" class="deduction" data-id="@item.DTypeID" data-percent="@item.DeductedPercentage" />            
                                        <label title="@(Lang.ResourceManager.GetString("Deduction" + item.DTypeName.Replace(" ", string.Empty)))">
                                            @item.DTypeName
                                        </label></td>
                                        <td style="text-align: left;"> = @RazorHelper.PercentageDropDownList((decimal)item.DeductedPercentage, (decimal)0.01, "deductionlist nopadding", "disabled")
                                        </td>                                    
                                        <td style="text-align: left;">
                                            @RazorHelper.AdditionalSharingFee(item.DTypeName, (decimal)Model.DepositPercent, (decimal)Model.WithdrawalPercent, "disabled")
                                        </td>
                                    </tr>
                                }
                                </table>                    
                            </div>          
                            <!--/DeductionOption--></div>
                        <!--/Deduction-->
            }
                }
                <div class="fieldset">
                    <div class="legend">@Lang.TierSetting</div>
                    <div style="clear:left;"></div>
                    <table id="tblTier@(product.ProductID)">
                        <thead><tr>
                                   <td style="width: 55px;" class="theader">Tier</td>
                                   <td style="width: 110px;" title="@Lang.MinimumWinlossAmount" class="theader">@Lang.MinAmount</td>
                                   <td style="width: 165px;" title="@Lang.MaximumWinlossAmount" class="theader">@Lang.MaxAmount</td>
                                   <td style="width: 110px;" title="@Lang.MinimumQualifiedMembers" class="theader">@Lang.MinQM</td>
                                   <td style="width: 165px;" title="@Lang.MaximumQualifiedMembers" class="theader">@Lang.MaxQM</td>
                                   <td style="width: 80px;" class="theader">@Lang.Commission</td>
                                   <td style="width: 80px;" class="theader">@Lang.Action</td>
                               </tr>
                        </thead>
                        <tbody>   
                            <tr class="rnormal"><td class="c" colspan="7">@Lang.NoInfo</td></tr>
                        </tbody>
                    </table>
                    <button id="btnAddTier@(product.ProductID)" style="margin-top: 5px; vertical-align: top;" type="button" class="btn btn-default addtier" data-productid="@product.ProductID" >@Lang.AddTier</button>
                </div>
                </div>
        }
    </div>
   <div class="clear"></div>
    <div class="row-fluid row-form btn-action" style="margin: 10px">
        <div class="span12">            
            <button class="btn btn-default" id="btnSubmit" type="button">@(Model == null ? Lang.Add : Lang.Update)</button>
            <button class="btn btn-default" id="btnCancel" type="button" >@Lang.Cancel</button>
        </div>
    </div>
}


@section css{
    @Styles.Render("~/bundles/commgroup")
}


@section scripts{
    <script type="text/javascript">
        var MAXQM = 1000000000;
        var MAXAM = 100000000000000;

        var MSG = {
            PassRequire: "@Lang.ErrNewPass",
            PassConfirm: "@Lang.PassConfirm",
            InvalidSettingFor: "@Lang.InvalidSettingFor",
            TierSettingAtLeastTier: "@Lang.TierSettingAtLeastTier",            
            LastTierSettingHaveMaxValue: "@Lang.LastTierSettingHaveMaxValue",
            ConfirmRemoveFromGroup: "@Lang.ConfirmRemoveFromGroup",
            GroupNameEmpty: "@Lang.GroupNameEmpty",
            ValidQualifiedAmount: "@Lang.ValidQualifiedAmount",
            EnableProduct: "@Lang.EnableProduct",
            MaxTierAllow: "@Lang.MaxTierAllow"
        };

        var PRODUCTS = JSON.parse("@(ViewBag.ProductIDList)");
        var HasCashbackDeduction = @(ViewBag.HasCashbackDeduction ? "true" : "false");

        $(function(){
            CommGroupPopup.init();
        });
    </script>

    @Scripts.Render("~/scripts/addcommgroup")
}