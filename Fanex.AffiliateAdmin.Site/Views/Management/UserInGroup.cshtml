@{
    ViewBag.Title = Lang.UserManagement;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}

@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.DTO

@model Fanex.AffiliateAdmin.Models.UserManagementViewModel

<div class="search-panel search-userMgr">

@RazorHelper.SearchPanel("#SearchForm .search-form", "Information text",false, false)

@using (Html.BeginForm("UserInGroup", "Management", FormMethod.Post, new { @class = "row-fluid", id = "SearchForm" }))
{
<div class="span12 search-form">
    <div class="row-fluid row-form end-search">
        <div class="cell">
            @Lang.Username
            <input type="text" class="form-control" name="UserName" placeholder="@Lang.All" />
        </div>
        <div class="cell">
            @Lang.FirstLetter
            @RazorHelper.ListAlPhabet(Model.FirstLetter, new Dictionary<string, object> { { "name", "FirstChar" } })
        </div>
    </div>
    <div class="row-fluid row-form btn-action">
        <div class="span12">
            <button type="submit" id="btnSearch" class="btn btn-default" style="vertical-align: top">@Lang.Submit</button>
            @Html.HiddenFor(m=>m.GroupId)
        </div>
    </div>
</div>
}
</div>

@Html.ValidationSummary()
<div id="gridId" class="freegrid content-grid"></div>

@section scripts{
    <script type="text/javascript">
        var MSG = {
            NoInfo: "@Lang.NoInfo",
            ChangeStatus: "@Lang.ConfirmChangeStatusAff",
            AccountPolicyOfUser: "@Lang.AccountPolicyOfUser",
            ChangePassword: "@Lang.ChangePassword"
        };
        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.UserManagement",
                showButtonsWhenNoData: true,
                customButtons: '<input type="button" name="btnAdd" title="@Lang.ChangePolicyOfMultipleUsers" class="btnAdd icon-assign-permission-to-multi-user" />'
            },
            columns: [
                {
                    HeaderText: "<input type='checkbox' value='all' />",
                    Width: 40,
                    Name: "check",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) { return "<input type='checkbox' name='user' value='" + rowData.CustID + "' data-name='" + rowData.Username + "' />"; }
                },
                { HeaderText: "#", Width: 40, Name: "number", HeaderAlign: "center", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Username",
                    Width: 120,
                    Name: "Username",
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) { return '<a href="javascript:Management.editAccount(' + rowData.CustID + ",'" + rowData.Username + '\')">' + cell.Value + '</a>'; }
                },
                { HeaderText: "@Lang.FirstName", Width: 80, Name: "FirstName" },
                { HeaderText: "@Lang.LastName", Width: 80, Name: "LastName" },
                {
                    HeaderText: "@Lang.Status",
                    Width: 80,
                    Name: "Status",
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) {
                            var statusName = cell.Value ? "@Lang.Closed" : "@Lang.Open";
                            var className = cell.Value ? "icon-ban-circle" : "icon-ok-circle";
                            return statusName + "<a href=\"javascript:Management.changeStatus(this," + rowData.CustID + ");\"><i id='i_" + rowData.CustID + "' class=\"" + className + "\"></i></a>";
                        }
                },
                { HeaderText: "@Lang.Creator", Width: 80, Name: "Creator" },
                { HeaderText: "@Lang.CreatedDate", Width: 160, Name: "CreateDateStr", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Policy",
                    Width: 100,
                    Name: "CustID",
                    CellAlign: "center",
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) {
                            return '<a href="javascript:Management.viewAccountPolicy(' + rowData.CustID + ",'" + rowData.Username + "','" + rowData.GroupName + '\')">@Lang.AccountPolicy</a>';
                        }
                },
                {
                    HeaderText: "@Lang.Password",
                    Width: 80,
                    Name: "CustID",
                    CellAlign: "center",
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) {
                            if (rowData.Status)
                                return "";
                            return "<a href=\"javascript:Management.editPassword(" + rowData.CustID + ",'" + rowData.Username + "\')\"><i class=\"icon-edit\"></i></a>";
                        }
                }
            ],
            showPager: true,
            allowTruncate: true,
            gridExpandHeight: 100,
            indexNumberColumn: 1
        };
    </script>
    <script src="~/scripts/libraries/jquery.multiselect.js"></script>
    @Scripts.Render("~/scripts/usermanagement")
}