@{
    var currentSession = SessionManager.CurrentSession;
}
@using Fanex.AffiliateAdmin.Core.Configurations
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="@Url.Content(string.Format("~/Content/_Sites/{0}/images/favicon.jpg?{1}", AppSettings.Layout, DateTime.Now.Ticks))" rel="shortcut icon" type="image/jpg" />
    <meta name="viewport" content="width=device-width" />
    @Styles.Render("~/bundles/css")
    @RenderSection("css", required: false)
    @Scripts.Render("~/bundles/jquery")
</head>
<body >
    @Html.Hidden("IsIT", currentSession.IsIT ? 1 : 0)
    <div class="container">
        <div class="row-fulid">
          @if (currentSession.ApplicationMode == Fanex.AffiliateAdmin.Core.Enumerations.AppMode.Self)
          {
            @Html.Partial("_Header")
          }
            <div class="span12 content narrow-padding">
                <!--content html-->
                <div class="row-fluid main-content">
                    <div class="span12">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/js")
    @if (currentSession.ApplicationMode == Fanex.AffiliateAdmin.Core.Enumerations.AppMode.Self)
    {
        @Scripts.Render("~/Scripts/site/RecheckIn.js")
    }
    @RenderSection("scripts", required: false)
    <script type="text/javascript">
        var Lang = {
            NoDataInfo: '@Html.Raw(Lang.NoInfo)',
            All: "@Lang.All",
            Uncheck: "@Lang.Uncheck",
            Selected: "@Lang.Selected",
            SelectAnOption: "@Lang.SelectAnOption",
            Close: "@Lang.Close",
            ChangePassword: "@Lang.ChangePassword"
        };

        $(document).ready(function() {
            $.unblockUI();

            AFFILIATE.getAbsoluteUrl = function(relativeUrl) {
                return '@Url.Content("~/")' + relativeUrl;
            };

            AFFILIATE.TimeZone = '@AppSettings.ServerTimeZone';
            $("#AffiliateInfo").addClass("active");
        });
    </script>
    @if (string.IsNullOrWhiteSpace(AppSettings.PiwikSiteId) == false && AppSettings.Environment.Equals("Production", StringComparison.OrdinalIgnoreCase))
    {
        <script type="text/ecmascript">
            var piwikSiteId = '@AppSettings.PiwikSiteId';

            var _paq = _paq || [];
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function () {
                var u = "https://pw.detecas.com/";
                _paq.push(['setTrackerUrl', u + 'piwik.php']);
                _paq.push(['setSiteId', piwikSiteId]);
                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
            })();           
        </script>    
        <noscript>
            <p>
                <img src="https://pw.detecas.com/piwik.php?idsite=@(AppSettings.PiwikSiteId)'  style="border:0;" alt="" /></p>
        </noscript>
    }
</body>
</html>
