    {
        var today = DateTime.Today < maxDate ? DateTime.Today : maxDate;
        var url = new System.Web.Mvc.UrlHelper(Context.Request.RequestContext);

    <label for="FromDate">@Lang.From</label>
    <input type="text" id="FromDate" data-original="@fromDate.ToString("MM/dd/yyyy")" value="@fromDate.ToString("MM/dd/yyyy")" class = "date-range @fromClass" name="FromDate" />
    <label for="ToDate">@Lang.To</label>
    <input type="text" id="ToDate" data-original="@toDate.ToString("MM/dd/yyyy")" value="@toDate.ToString("MM/dd/yyyy")" class = "date-range @toClass" name="ToDate" />
    <script type="text/javascript">
        var dateRangePicker = null;
        var langDatePicker = {
            Today: "@Lang.Today",
            Yesterday: "@Lang.Yesterday",
            Currentweek: "Current Week",
            Lastweek: "Last Week",
            Currentmonth: "Current month",
            Lastmonth: "Last month",
            Sincelastmonth: "Since last month",
            SpecificDate: "SpecificDate",
            DateRange: "DateRange",
            Fromdate: "Fromdate",
            Todate: "Todate",
            Next: "Next",
            Prev: "Prev",
            OK: "OK",
            EndDate: "EndDate"
        };
        $(document).ready(function () {
            var monthShort = ['@Lang.Jan', '@Lang.Feb', '@Lang.Mar', '@Lang.Apr', '@Lang.May', '@Lang.Jun', '@Lang.Jul', '@Lang.Aug', '@Lang.Sep', '@Lang.Oct', '@Lang.Nov', '@Lang.Dec']
            var dayMin = ['@Lang.Su', '@Lang.Mo', '@Lang.Tu', '@Lang.We', '@Lang.Th', '@Lang.Fr', '@Lang.Sa'];

            var disabledPreset = @(simpleMode ? 1 : 0) ? ['Lastweek', 'Currentmonth', 'Lastmonth', 'Sincelastmonth'] : [];
            dateRangePicker = $('#FromDate, #ToDate').daterangepicker({
                today: '@(today.ToString("MMM d yyyy"))',
                buttonImage: '@url.Content("~/Content/Themes/Theme1/images/calendar.gif")',
                datepickerOptions: {
                    showOtherMonths: true,
                    changeMonth: true,
                    changeYear: true,
                    selectOtherMonths: true,
                    closeText: 'OK',
                    dateFormat: 'mm/dd/yy',
                    minDate: '@(minDate.ToString("MM/dd/yyyy"))',
                    maxDate: '@(maxDate.ToString("MM/dd/yyyy"))',
