@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Models
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Configurations

@{
    ViewBag.Title = Lang.MemberStatistics;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section iconcss{
report
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Reports, 1, "report")
}
<div class="search-panel search-message" style="min-width: 872px">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    @using (Html.BeginForm("DataList", "Message", FormMethod.Post, new { @class = "row-fluid" }))
    {
        <div class="span12 search-form">
            <div class="row-fluid row-form">
                <div class="cell">
                    @Html.Label("AffName", Lang.Affiliate, new { @class = "txt" })
                    @Html.TextBox("AffName",null, new { placeholder = Lang.All, @class = "width-140", maxlength = "100" })
                </div>
                <div class="cell">
                    @Html.Label("AffTypes", Lang.AffType, new { @class = "txt" })
                    @Html.DropDownCheckList("AffTypes", new SelectList(AppSettings.AffTypes, "TypeID", "Name"), true, true, new { @class = "width-140" })
                </div>
                 <div class="cell">
                    @Html.Label("PreferLanguages", Lang.Language, new { @class = "txt" })
                    @Html.DropDownCheckList("PreferLanguages", new SelectList(AppSettings.AffSupportLanguages, "LanguageID", "LanguageName"), true, true, new { @class = "width-140" })
                </div>
            </div>
             <div class="row-fluid row-form">
                 <div class="cell">
                     @Html.Label("GroupBy", Lang.GroupBy, new { @class = "txt" })
                    
                     <select id="GroupBy" name="GroupBy" class="width-140 single-select dropdownchecklist">
                         <option value="0">@Lang.All</option>
                         <option value="1">@Lang.Date</option>
                         <option value="2" selected>@Lang.Month</option>                    
                     </select>
                 </div>
                 <div class="hide" id="dateSearch">
                     <div class="cell">
                         @Html.Label("FromDate", Lang.From, new { @class = "txt" })
                         @Html.DatePicker("FromDate", new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1), AppSettings.SystemStartDate, DateTime.Now, false)
                     </div>
                     <div class="cell" >
                         @Html.Label("ToDate", Lang.To, new { @class = "txt" })
                         @Html.DatePicker("ToDate", DateTime.Now, AppSettings.SystemStartDate, DateTime.Now, false)                                        
                     </div>
                </div>
                 <div id="monthSearch" >
                     <div class="cell" >
                         @Html.Label("FromMonth", Lang.From, new { @class = "txt" })
                         @Html.MonthPicker("FromMonth", DateTime.Now, AppSettings.SystemStartDate, DateTime.Now, new { id = "FromMonth" })
                     </div>
                     <div class="cell" >
                         @Html.Label("ToMonth", Lang.To, new { @class = "txt" })
                         @Html.MonthPicker("ToMonth", DateTime.Now, AppSettings.SystemStartDate, DateTime.Now, new { id = "ToMonth" })
                     </div>
                </div>
                 <input type="hidden" name="PreviousGroupBy" id="PreviousGroupBy" value="2"/>
            </div>
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    @Html.Label(Lang.Currency, new { @class = "txt", @for="Currencies" })
                    @Html.DropDownCheckList("Currencies", new SelectList(SessionManager.CurrentSession.CurrencyList, "CurrencyID", "CurrencyCode"), true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    @Html.Label("SortBy", Lang.SortBy, new { @class = "txt" })                    
                    <select id="SortBy" class="width-140 single-select dropdownchecklist">
                        <option value="0">@Lang.Affiliate</option>
                        <option value="1" selected>@Lang.SignUp</option>
                        <option value="2">@Lang.Active</option>                    
                    </select>
                </div>
                <div class="cell checkbox">                
                    <label for="ExcludeTest">
                        <input type="checkbox" id="ExcludeTest" name="ExcludeTest" checked/>
                        @Lang.ExcludeTestAccounts
                    </label>
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" class="btn" id="btnSubmit">
                        @Lang.Submit
                    </button>
                </div>
            </div>
        </div>
    }
</div>
<div id="gridId" class="freegrid">
</div>
<div class="content legend">
    <div class="row-fluid">
        <ul class="unstyled inline status pull-right">
            <li><span class="approved"></span>@Lang.Approved</li>
            <li><span class="locked"></span>@Lang.LockedOut</li>            
            <li><span class="closed"></span>@Lang.Closed</li>
        </ul>
    </div>
</div>
@section scripts{
    <script type="text/javascript">
        var MSG = {
            Date: "@Lang.Date",
            Month: "@Lang.Month",
            RangeTime3Months: "@Lang.RangeTime3Months",
            MemberStatisticsTitle: "@Lang.MemberStatistics"                
        };
        
        var sampleGridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.MemberStatistics"                
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Date", Width: 80, Name: "DateClick", HeaderAlign: "center", CellAlign: "center" },                
                { HeaderText: "@Lang.Affiliate", Width: 80, Name: "Username", HeaderAlign: "center",
                    Formatter: function (rIndex, record, cell, cellFormated) {
                        var affInfoUrl = AFFILIATE.getAbsoluteUrl("AffiliateInfo?username=");
                        
                        return "<a href='" + affInfoUrl + record.Username + "'>" + cellFormated + "</a>";
                    } 
                },
                { HeaderText: "@Lang.AffType", Width: 100, Name: "AffType", HeaderAlign: "center", FormatDateTime: AFFILIATE.DATE_FORMAT_FULL },
                { HeaderText: "@Lang.Language", Width: 100, Name: "Language", HeaderAlign: "center"},
                { HeaderText: "@Lang.Currency", Width: 70, Name: "Currency", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.TotalClicks", Width: 70, Name: "TotalClick", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.UniqueClicks", Width: 70, Name: "UniqueClick", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.Signups", Width: 70, Name: "Signups", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.FDM", Width: 70, Name: "FDM", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.NonDeposit", Width: 70, Name: "NonDeposit", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.Active", Width: 70, Name: "ActivePlayers", HeaderAlign: "center", CellAlign: "right" }
            ],

            gridExpandHeight: 360,
            allowTruncate: false,
            showNumberColumn: true,
            showFooter: true,
            rowCssClass: function (rowIndex, rowData) {
                return rowData.Status.toLowerCase();
            }
        };   
    </script>
    @Scripts.Render("~/scripts/memberstatistics")
}
