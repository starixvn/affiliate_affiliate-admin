@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Models
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Services.Impl
@model TextAddViewModel
@{
    ViewBag.Title = "Add Text";
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using (Html.BeginForm("AddText", "Media", FormMethod.Post, new { @class = "form-horizontal form-popup" }))
{
    @Html.ValidationSummary()
    <div class="popup-content">
        <div class="control-group">
            @Html.LabelFor(m => m.Content, new { @class = "control-label" })
            <div class="controls">
                @Html.TextAreaFor(m => m.Content, new { @class = "large-textarea" })
                <span class="required">*</span>
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Category, new { @class = "control-label" })
            <div class="controls">
                @Html.DropDownListFor(m => m.Category, Model.BannerCategoryOptionList, new { @class = "dropdownchecklist single-select" })
                <span class="required">*</span>
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Language, new { @class = "control-label" })
            <div class="controls">
                @Html.DropDownListFor(m => m.Language, Model.MemberSiteSupportedLanguageOptionList, new { @class = "dropdownchecklist single-select" })
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Currency, new { @class = "control-label" })
            <div class="controls">
                @Html.DropDownListFor(m => m.Currency, Model.PlayerCurrencyOptionList, new { @class = "dropdownchecklist single-select" })
                <span class="required">*</span>
            </div>
        </div>
    </div>
    <div class="popup-footer">
        <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnUpdate" class="btn">@Lang.Add</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </div>
}
@section scripts{
    <script src="~/Scripts/site/TextList.js" type="text/javascript"></script>
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.TextList.ReRenderAfterPaged);
        </script>
    }
}
