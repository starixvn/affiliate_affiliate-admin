@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminSiteUrl/Content/themes/theme1/images/email_bg.png">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminSiteUrl/Content/themes/theme1/images/email_top.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="#a30003" height="25">
                        &nbsp;&nbsp; <strong style="color: #ffffff;"><font style="font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">Afiliasi Penarikan Bimbingan </font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="#ffffff">
                        <table style="text-align: left" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td style="padding: 20px 15px">
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Yang terhormat @(Model.FirstName),</strong><br />
                                        Selamat untuk menjadi afiliasi @(Model.SystemName)
                                        kami!<br />
                                        <br />
                                        Untuk memastikan untuk pembayaran yang lebih cepat untuk afiliasi Anda, silahkan
                                        luangkan waktu untuk membaca prosedur untuk penarikan berikut:<br />
                                        <br />
                                        1. Tolong jangan mendaftarkan rekening taruhan @(Model.SystemName)
                                        baru<br />
                                        <br />
                                        2. Kirim email ke <a href="mailto:@(Model.MailContact)">@(Model.MailContact)</a>
                                        dan negara pengguna @(Model.SystemName)
                                        Anda bersama dengan nama pengguna afiliasi<br />
                                        <br />
                                        3. Setelah mengirim email kepada kami untuk Anda @(Model.SystemName)
                                        account, silahkan login account afiliasi Anda dan klik pada "Rekening Saya", pada
                                        kolom Informasi pembayaran, silakan ubah metode pembayaran Anda @(Model.SystemName)
                                        Player Account, isikan username dan @(Model.SystemName)
                                        Anda klik submit.<br />
                                        <br />
                                        4. Kami akan menyelesaikan pembayaran komisi member sekali dalam sebulan, silakan
                                        mengakses rekening afiliasi Anda dan klik pada permintaan Pembayaran, masukkan jumlah
                                        dan permintaan Payout.<br />
                                        <br />
                                        5. ika permintaan penarikan Anda disetujui, dana Anda akan secara otomatis ditransfer
                                        ke rekening taruhan @(Model.SystemName)
                                        Anda.<br />
                                        <br />
                                        6. Anda dapat meminta penarikan dari rekening taruhan @(Model.SystemName)
                                        Anda kapan saja dan tidak akan ada biaya tambahan.
                                        <br />
                                        <br />
                                        Harap perhatikan:<br />
                                        <br />
                                        1. @(Model.SystemName)
                                        rekening taruhan Anda adalah untuk tujuan afiliasi saja; tolong jangan membuat deposito
                                        atau menempatkan taruhan.<br />
                                        <br />
                                        2. Anda terdaftar @(Model.SystemName)
                                        rekening taruhan nama harus sama nama yang terdaftar sudah terdaftar di rekening
                                        afiliasi Anda, dan itu harus nama asli Anda.<br />
                                        <br />
                                        3. Prosedur di atas adalah untuk pertama kali penarikan hanya anggota afiliasi,
                                        jika permintaan penarikan 2 atau 3, silahkan merujuk pada langkah 4, 5 dan 6.<br />
                                        <br />
                                        Jangan ragu untuk menghubungi kami jika Anda memiliki pertanyaan lebih lanjut.<br />
                                        <br />
                                        Hormat kami,<br />
                                        <br />
                                        Afiliasi @(Model.SystemName)
                                        Tim
                                        <br />
                                        <a href="mailto:@(Model.MailContact)">@(Model.MailContact)</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="#d7d7d7" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © Hak Cipta @DateTime.Now.Year <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="#a30003" height="40">
                        <font style="font-size: 12px; color: #eba6a6; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            Ini adalah sistem yang dihasilkan otomatis email, harap jangan balas email ini secara langsung.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>