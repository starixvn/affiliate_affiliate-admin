﻿@using Fanex.AffiliateAdmin.Models
@{
    ViewBag.Title = Lang.EditUser;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}

@using Fanex.AffiliateAdmin.Models
@model Fanex.AffiliateAdmin.Models.EditUserViewModel

@using (Html.BeginForm("EditUser", "Management", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary()
    <fieldset>
         <div class="control-group">
            <label class="control-label" for="GroupId">@Lang.GroupName</label>
            <div class="controls">
                @RazorHelper.DropDownListGroup(Model.GroupList.ToList(), Model.GroupID, new Dictionary<string, object> { { "id", "GroupId" } })
            </div>
        </div>
         <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnSubmit" class="btn">@Lang.Submit</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </fieldset>    
    <input type="hidden" value="@Model.CustID" name="CustId" />
}
@section scripts{
    <script src="~/scripts/libraries/jquery.multiselect.js"></script>
    @Scripts.Render("~/scripts/usermanagement")
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.Management.ReRenderAfterPaged);
        </script>
    }
}