@using System.Globalization
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Models
@using Fanex.AffiliateAdmin.Criterias
@using Fanex.AffiliateAdmin.Services.Impl
@model PaymentUpdateViewModel
@{
    ViewBag.Title = Lang.UpdatePayment;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";

    var paymentDetail = Model.PaymentDetail;
    var disabled = paymentDetail != null && paymentDetail.Status.ToLower() == "pending" ? false : true;
}
@if (paymentDetail == null)
{
    <div>
        @string.Format("Transid {0} does not existed", Model.TransId)
    </div>
    return;
}
@using (Html.BeginForm("UpdatePayment", "Payment", FormMethod.Post))
{
    @Html.ValidationSummary()
    @Html.HiddenFor(m => m.TransId)
    @Html.HiddenFor(m => m.FromStatement)
    <fieldset>
        <legend>@Lang.AccInfo</legend>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.Username
            </div>
            <div class="bold">
                @paymentDetail.AffUserName
            </div>
        </div>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.DateRequest
            </div>
            <div class="bold">
                @paymentDetail.Transdate.ToString("MM/dd/yyyy hh:mm:ss tt", CultureInfo.InvariantCulture)
            </div>
        </div>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.Email
            </div>
            <div>
                @paymentDetail.Email
            </div>
        </div>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.FirstName
            </div>
            <div>
                @paymentDetail.Firstname
            </div>
        </div>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.LastName
            </div>
            <div>
                @paymentDetail.Lastname
            </div>
        </div>
    </fieldset>
    <fieldset>
        <legend>@Lang.PaymentInfo</legend>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.PaymentMethod
            </div>
            <div class="bold">
                @paymentDetail.PreferredPayment
            </div>
        </div>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.Amount
            </div>
            <div class="bold">
                @FormaterCurrency.Format(paymentDetail.Amt, paymentDetail.AffCurrency)
            </div>
        </div>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.Status
            </div>
            <div class="bold">
                @Common.GerStatus(paymentDetail.Status)
            </div>
        </div>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.TransferTo
            </div>
            <div>
                <span class="bold">@paymentDetail.UserName2</span> (@paymentDetail.IBCUserName)
            </div>
        </div>
        <div class="row-fluid">
            <div class="controls-row span5">
                @Lang.TransferAmount
            </div>
            <div>
                @FormaterCurrency.Format(Math.Abs(paymentDetail.TransferAmount), paymentDetail.PlayerCurrencyCode)
            </div>
        </div>
        @if (paymentDetail.Status.ToLower() == "pending")
        {
            <label class="radio inline">
                @Html.RadioButtonFor(m => m.Status, "Approved", new { }.DisabledIf(disabled))
                @Lang.Approved
            </label>
            <label class="radio inline">
                @Html.RadioButtonFor(m => m.Status, "Rejected", new { }.DisabledIf(disabled))
                @Lang.Rejected
            </label>
        }
        else
        {
            <div class="row-fluid">
                <div class="controls-row span5">
                    @Lang.CompletedDate
                </div>
                <div class="bold">
                    @paymentDetail.CompletedDate.ToString("MM/dd/yyyy hh:mm:ss tt", CultureInfo.InvariantCulture)
                </div>
            </div>
            <div class="row-fluid">
                <div class="controls-row span5">
                    @Lang.UpdatedBy
                </div>
                <div>
                    @paymentDetail.Adminname
                </div>
            </div>
        }
    </fieldset>

    <div class="row-fluid">
        <div class="span6">
            <fieldset>
                <legend>@Lang.AdminNote</legend>
                <div class="row-fluid">            
                    @Lang.VisibleOnlyToAdmin
                </div>
                <div class="row-fluid">
                    @Html.TextAreaFor(m => m.AdminRemark, new { @class = "xsmall-textarea" }.DisabledIf(disabled))            
                </div>
            </fieldset>
        </div>
        <div class="span6">
            <fieldset>
                <legend>@Lang.AffiliateNote</legend>
                <div class="row-fluid">
                    @Lang.VisibleAlsoToAffiliate
                </div>
                <div class="row-fluid">
                    @Html.TextAreaFor(m => m.AffRemark, new { @class = "xsmall-textarea" }.DisabledIf(disabled))
                </div>
                
            </fieldset>
        </div>
    </div>

    <div class="popup-footer">
        <div class="row-fluid">
            <button id="btnUpdate" type="submit" class="btn btn-default" disabled="@disabled">@Lang.Update</button>
            <button id="btnCancel" type="button" class="btn btn-default">@Lang.Cancel</button>
        </div>
    </div>
}
@section scripts{    
    @Scripts.Render("~/scripts/payment")
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        if(!Model.FromStatement)
        {
            @Scripts.Render("~/scripts/payment")
            <script type="text/javascript">
                AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.Payment.ReRenderAfterPaged);
            </script>
        }
        else
        {
            @Scripts.Render("~/scripts/statement")
            <script type="text/javascript">
                AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.STATEMENT.ReRenderAfterPaged);
            </script>
        }
    }
}
