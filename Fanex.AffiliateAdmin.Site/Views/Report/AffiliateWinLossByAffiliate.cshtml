@{
    ViewBag.Title = Lang.AffiliateWinLossReport;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}


@section iconcss{
report
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 6, string.Empty, 2)
    <div class="line line-statement">
        <div class="ic-open-window" title="@Lang.FullScreen"></div>
        <div class="ic-reload" title="@Lang.RefreshPage"></div>
    </div>
}

@{
    var now = DateTime.Now;
    var fromDate = Model.FromDate.HasValue ? Model.FromDate.Value : now;
    var toDate = Model.ToDate.HasValue ? Model.ToDate.Value : now;

    fromDate = new DateTime(2014, 1, 1);
    toDate = new DateTime(2014, 3, 1);
}

@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@model Fanex.AffiliateAdmin.Models.AffiliateWinLossViewModel
<div class="search-panel search-company-winloss" style="min-width: 800px" >
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", Common.GetReportInfo(ReportType.AffiliateWinLoss), false, true)
    @using (Html.BeginForm("AffiliateWinLossByAffiliate", "Report", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {
        <div class="span12 search-form  end-search">
            <div class="row-fluid row-form">                
                <div class="cell">
                    <label for="FromDate" class="txt">@Lang.From</label>
                    @Html.MonthPicker("FromDate", fromDate, AppSettings.SystemStartDate, now)
                </div>
                <div class="cell">
                    <label for="ToDate" class="txt">@Lang.To</label>
                    @Html.MonthPicker("ToDate", toDate, AppSettings.SystemStartDate, now)
                </div>            
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.BaseCurrency</label>
                    @Html.DropDownCheckList("BaseCurrency", Model.BaseCurrencyOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
            </div>
            <div class="row-fluid row-form end-search">                
                <div class="cell">
                    <label for="DrawFilter" class="txt">@Lang.DrawFilter</label>
                    @Html.DropDownCheckList("DrawFilter", Model.DrawFilterOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    @Html.Label("SortBy", Lang.SortBy, new { @class = "txt" })                    
                    @Html.DropDownCheckList("SortBy", Model.SortByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="Products" class="txt">@Lang.Product</label>
                    @Html.DropDownCheckList("Products", Model.ProductOptionList, true, false, new { @class = "width-140" })
                </div>                
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button id="btnSubmit" type="button" class="btn btn-default">@Lang.Submit</button>
                    <input type="hidden" name="ByAffiliate" id="ByAffiliate" value="true" />
                </div>
            </div>
        </div>
    }
</div>

<div id="gridId" class="freegrid" style="width: 1249px;">
</div>

@section scripts{
    <script type="text/javascript">

        var MSG = {
            ActivePlayers: "@Lang.ActiveMembers",
            BetCount: "@Lang.BetCount",
            Turnover: "@Lang.Turnover",
            Winloss: "@Lang.Winloss",
            PlayerComm: "@Lang.PlayerComm",
            SubTotalIn: "@Lang.SubTotalIn",
            Total: "@Lang.Total",
            TotalAll: "@Lang.TotalAll",
            Sportsbook: "@Lang.Sportsbook",
            NumberGame: "@Lang.NumberGame",
            LiveCasino: "@Lang.LiveCasino",
            RNGCasino: "@Lang.RNGCasino",
            PlaytechCasino: "@Lang.PlaytechCasino",
            VirtualSport: "@Lang.VirtualSport",
            SubTotal: "@Lang.SubTotal",
            RangeTime3Months: "@Lang.RangeTime3Months",
            CommPercent: "@Lang.CommPercent",
            QM: "@Lang.QM",
            CommGroupSettingFor: "@Lang.CommGroupSettingFor",
            AffQualifiedMemReportDetailFor: "@Html.Raw(Lang.AffQualifiedMemReportDetailFor)",
            Currency: "@Lang.Currency",
            AffiliateWinLossTitle: "@Lang.AffiliateWinLoss",
            NA: "@Lang.NA",
            Amount: "@Lang.Amount",
            ToggleSubTotal: '@Lang.ToggleSubTotal',
            ChooseAtLeastOneProduct: '@Lang.ChooseAtLeastOneProduct',
            QualifiedMembers: "@Lang.QualifiedMembers"
        };
        
        var PRODUCTS = @(Html.Raw(ViewBag.Products));
        var COLLAPSE_SUBTOTAL_STATUS = 0, EXPAND_SUBTOTAL_STATUS = 1;
        var subTotalStatus = COLLAPSE_SUBTOTAL_STATUS;
        
        var sampleGridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.AffiliateWinLoss",
                showButtonsWhenNoData: false,
                customButtons: "<i title='Simple Mode' id='btnChangeViewMode' style='cursor: pointer' class='icon-circle-arrow-left'></i>"
            },
            groupHeaderRows: [
                {
                    Columns: [
                        { HeaderText: "@Lang.Month", Name: "WinlostDate", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.CommGroup", Name: "GroupName", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Currency", Name: "Currency", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.ActiveMembers", Name: "ActivePlayers", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.BetCount", Name: "BetCount", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Deposit", IsCurrency: true, HeaderText: "@Lang.Deposit", Name: "Deposit", NameCache: "Deposit", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.PlayerComm", IsCurrency: true, HeaderText: "@Lang.PlayerComm", Name: "PlayerComm", NameCache: "PlayerComm", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Withdrawal", IsCurrency: true, HeaderText: "@Lang.Withdrawal", Name: "Withdrawal", NameCache: "Withdrawal", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Turnover", IsCurrency: true, HeaderText: "@Lang.Turnover", Name: "Turnover", NameCache: "Turnover", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Winloss", IsCurrency: true, HeaderText: "@Lang.Winloss", Name: "Winloss", NameCache: "Winloss", MergeRowNumber: 2 }
                    ]
                }
            ],
            columns: [
                {
                    HeaderText: "@Lang.Month",
                    Width: 80,
                    Name: "WinlostDate",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    FormatDateTime: AFFILIATE.DATE_FORMAT_MONTH,
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a class='monthlink' data-affname='" + record.Username + "' href='javascript:void(0)' data-winlostdate='{0}'>".format(record.WinlostDate) + cellFormated + "</a>";
                    }
                },
                {
                    HeaderText: "@Lang.CommGroup",
                    Width: 80,
                    Name: "GroupName",
                    HeaderAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        if (cellFormated)
                            return "<a class='commgroup' data-date='" + moment(record.WinlostDate).format("MMM-YYYY") + "' data-groupid='" + record.GroupID + "' href='javascript:void(0)'>" + cellFormated + "</a>";
                        return null;
                    }
                },
                { HeaderText: "@Lang.Currency", Width: 80, Name: "Currency", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.ActiveMembers", Width: 80, Name: "ActivePlayers", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.BetCount", Width: 80, Name: "BetCount", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.Deposit", Width: 110, Name: "Deposit", NameCache: "Deposit", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)', IsAbs: true },
                { HeaderText: "@Lang.PlayerComm", Width: 110, Name: "PlayerComm", NameCache: "PlayerComm", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)', IsAbs: true },
                { HeaderText: "@Lang.Withdrawal", Width: 70, Name: "Withdrawal", NameCache: "Withdrawal", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)',  IsAbs: true },
                { HeaderText: "@Lang.Turnover", Width: 110, Name: "Turnover", NameCache: "Turnover", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)',  IsAbs: true },
                { HeaderText: "@Lang.Winloss", Width: 110, Name: "Winloss", NameCache: "Winloss", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)',  IsAbs: true }
            ],
            showPager: true,
            customPager: true,
            allowTruncate: false,
            gridExpandHeight: 360,
            showFooter: true,
            customizeHeader: true,
            showDistinctRow: true,
            numberOfFrozenColumn: 3,
            headerColumnHeight: 30,
            rowCssClass: function (rowIndex, rowData) {
                return rowData.Status.toLowerCase();
            }
        };
        
        var samplePShareCol = { 
            HeaderCaption: "<span title='@Lang.ProgressiveShare'>@Lang.PShare</span>", 
            HeaderText: "<span title='@Lang.ProgressiveShare'>@Lang.PShare</span>", 
            IsCurrency: true, Width: 110, Name: "PShare", NameCache: "PShare", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)',  IsAbs: true };
        var samplePWinCol= { 
            HeaderCaption: "<span title='@Lang.ProgressiveWin'>@Lang.PWin</span>", 
            HeaderText: "<span title='@Lang.ProgressiveWin'>@Lang.PWin</span>", 
            IsCurrency: true, Width: 110, Name: "PWin", NameCache: "PWin", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)',  IsAbs: true };
        var sampleNetGamingCol = { 
            HeaderCaption: "<span title='@Lang.PlaytechCasinoNetGaming'>@Lang.PCNetGaming</span>", 
            HeaderText: "<span title='@Lang.PlaytechCasinoNetGaming'>@Lang.PCNetGaming</span>", 
            IsCurrency: true, Width: 110, Name: "NetGaming", NameCache: "NetGaming", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)',  IsAbs: true };
        
    </script>
    @Scripts.Render("~/scripts/affiliatewinlossreport")
}

