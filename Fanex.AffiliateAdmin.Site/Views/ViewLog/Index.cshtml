@{
    ViewBag.Title = Lang.ViewLog;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities

@model Fanex.AffiliateAdmin.Models.AffiliateInfo.ViewLogViewModel
@section iconcss{
affiliate-info
}
@{
    var appSetting = DependencyResolver.Current.GetService<IAppSetting>();
    var systemSettings = DependencyResolver.Current.GetService<ISystemSettings>();
    var now = systemSettings.SystemDateTime;
    var systemStartDate = systemSettings.SystemStartDate;
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 7)
    <div class="line line-statement">
        <div class="ic-reload" title="@Lang.RefreshPage"></div>
    </div>
}
<div class="search-panel search-viewLog no-border">
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    <div class="span12 search-form">
        <div class="row-fluid row-form end-search">
            <div class="cell">
                @Html.LabelFor(m => m.LogType, new { @class = "txt" })
                @Html.DropDownCheckList("LogType", Model.LogTypeListItem, false, false, new { @class = "width-140" })
            </div>
            <div class="cell width-160">
                @Html.LabelFor(m => m.DateFrom, new { @class = "txt", style = "min-width: 70px;" })
                @Html.DatePicker("DateFrom", Model.DateFrom, (systemStartDate > Model.DateFrom) ? systemStartDate : Model.DateFrom, now)
            </div>
            <div class="cell width-160">
                @Html.LabelFor(m => m.DateTo, new { @class = "txt", style = "min-width: 70px;" })
                @Html.DatePicker("DateTo", Model.DateTo, (systemStartDate > Model.DateFrom) ? systemStartDate : Model.DateFrom, now)
            </div>
        </div>
        <div class="row-fluid row-form btn-action">
            <div class="span12">
                <button type="submit" class="btn" id="btnSubmit">
                    @Lang.Submit
                </button>
            </div>
        </div>
    </div>
</div>
<div class="w-space">
</div>
@Html.ValidationSummary()
<div id="gridId" class="freegrid content-grid">
</div>
@section scripts{
    <script type="text/javascript">
        var ipCheckUrl = "@appSetting.IPCheckerUrl";

        var MSG = {
            NoInfo: "@Lang.NoInfo"
        };

        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.LogList"
            },
            columns: [
                { HeaderText: "#", Width: 40, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                {
                    HeaderText: "@Lang.ID",
                    Width: 80,
                    Name: "ID",
                    CellAlign: "center",
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) {
                            return rowData.RefNo;
                        }
                },
                { HeaderText: "@Lang.Date", Width: 120, Name: "LoggedDateStr", CellAlign: "center" },
                {
                    HeaderText: "@Lang.UpdatedBy",
                    Width: 80,
                    Name: "UpdatedDate",
                    CellAlign: "center",
                    CanResize: true,
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) {
                            return rowData.UserName + "<br/>(" + rowData.AffId + ")";
                        }
                },
                {
                    HeaderText: "@Lang.Action",
                    Width: 200,
                    Name: "Action",
                    CellAlign: "center",
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) {
                            return rowData.Description + "<br/>(" + rowData.SPName + ")";
                        }
                },
                { HeaderText: "@Lang.Description", Width: 250, Name: "Description" },
                {
                    HeaderText: "@Lang.IP",
                    Width: 110,
                    Name: "Ip",
                    CellAlign: "center",
                    CanResize: true,
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) {
                            return "<a href=\"" + ipCheckUrl.replace("{0}", cell.Value) + "\">" + cell.Value + "</a>";
                        }
                }
            ],
            showPager: true,
            customPager: true,
            allowTruncate: false,
            gridExpandHeight: 250,
            showNumberColumn: true,
            autoResizeColumn: true
        };
    </script>
    @Scripts.Render("~/scripts/viewlog")
}
