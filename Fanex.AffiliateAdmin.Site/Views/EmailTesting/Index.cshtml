
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="@Url.RenderLink("~/www/dist/style/jquery-ui.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.RenderLink("~/www/dist/style/bootstrap.css")" rel="stylesheet" type="text/css" />
    <title>Email</title>
</head>
<body>
    <div>
        <div>
            Format:
            <label for="Html">
                <input name="Format" id="Html" type="radio" checked value="cshtml" />
                Html
            </label>
            <label for="PlainText">
                <input name="Format" id="PlainText" type="radio" value="txt" />
                Plain Text
            </label>
        </div>
        <div>
            Language:
            <label for="enUS">
                <input name="Language" id="enUS" type="radio" checked value="en-US" />
                English
            </label>
            <label for="idID">
                <input name="Language" id="idID" type="radio" value="id-ID" />
                Indonesian
            </label>
            <label for="koKR">
                <input name="Language" id="koKR" type="radio" value="ko-KR" />
                Korean
            </label>
            <label for="thTH">
                <input name="Language" id="thTH" type="radio" value="th-TH" />
                Thai
            </label>
            <label for="viVN">
                <input name="Language" id="viVN" type="radio" value="vi-VN" />
                Vietnamese
            </label>
            <label for="zhCN">
                <input name="Language" id="zhCN" type="radio" value="zh-CN" />
                Chinese Simplified
            </label>
            <label for="zhTW">
                <input name="Language" id="zhTW" type="radio" value="zh-TW" />
                Chinese Traditional
            </label>
        </div>

        <div>
            Function:
            <label for="AffiliateApprove">
                <input name="Function" id="AffiliateApprove" type="radio" checked value="AffiliateApprove" />
                Affiliate Approve
            </label>
            <label for="AffiliateDisapprove">
                <input name="Function" id="AffiliateDisapprove" type="radio" value="AffiliateDisapprove" />
                Affiliate Disapprove
            </label>
            <label for="PaymentApprove">
                <input name="Function" id="PaymentApprove" type="radio" value="PaymentApprove" />
                Payment Approve
            </label>
            <label for="PaymentCancel">
                <input name="Function" id="PaymentCancel" type="radio" value="PaymentCancel" />
                Payment Cancel
            </label>
        </div>

        <div>
            <input id="emailAddress" type="text" value="" placeholder="enter email address to send" />
        </div>

        <div>
            <button type="button" id="btnSendMail">Send Email</button>
        </div>

        <div style="margin: 15px auto; border: 1px solid #808080; padding: 15px" id="resultContent">
        </div>
    </div>

    <input id="rootAction" type="hidden" value="@Url.Content("~/")" />
    @Scripts.Render("~/bundles/jquery")

    <script type="text/javascript">
        $(function () {
            const getUrl = (actionName) => {
                const rootAction = $("#rootAction").val();
                const format = $('input[name=Format]:checked').val() || "cshtml";
                const language = $('input[name=Language]:checked').val() || "en-US";
                const functionName = $('input[name=Function]:checked').val();
                return rootAction + "EmailTesting/" + actionName + "?language=" + language + "&function=" + functionName + "&format=" + format;
            }

            const _me = {
                initialize: () => {
                    _me.initEvent();
                },
                initEvent: () => {
                    $("#btnSendMail").on("click", () => {
                        $("#resultContent").html("");
                        const emailAddress = $("#emailAddress").val();
                        if (!emailAddress) {
                            $("#resultContent").html("Please enter email address");
                            return;
                        }

                        const url = getUrl("SendEmail");
                        const actionUrl = url + "&EmailAddress=" + emailAddress;

                        $.ajax({
                            type: "POST",
                            dataType: "json",
                            cache: false,
                            url: actionUrl,
                            success: function (response) {
                                if (response.Success) {
                                    $("#resultContent").html("Send Successfully");
                                }
                                else {
                                    const message = "Send Failed<br />" + response.Message;
                                    $("#resultContent").html(message);
                                }
                            }
                        });
                    });
                }
            }

            _me.initialize();
        });
    </script>
</body>
</html>