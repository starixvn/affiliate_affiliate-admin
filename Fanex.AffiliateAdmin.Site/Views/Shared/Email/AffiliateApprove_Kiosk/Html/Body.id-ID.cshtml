@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminSiteUrl/Content/themes/theme1/images/email_bg.png">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminSiteUrl/Content/themes/theme1/images/email_top.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="#a30003" height="25">
                        &nbsp;&nbsp; <strong style="color: #ffffff;"><font style="font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">Afiliasi Pemberitahuan </font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="#ffffff">
                        <table style="text-align: left" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td style="padding: 20px 15px">
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Yang terhormat dihargai Afiliasi,</strong><br />
                                        <br />
                                        Syabas , anda sudah menjadi ahli Afiliasi @Model.SystemName!<br />
                                        <br />
                                        Untuk membantu kami untuk melayani Anda kami berharap setiap perubahan terbaru dalam
                                        informasi pribadi Anda disertakan URL tambahan (jika ada) dalam "" My Account ""
                                        di situs Afiliasi @Model.SystemName kami.
                                        <br />
                                        <br />
                                        Sila memberitahu kami melalui e-mail ke situs yang tepat <a href="mailto:@Model.MailContact">@Model.MailContact</a>
                                        URL atau URL anda berencana untuk memasang @Model.SystemName's spanduk. Jika ada
                                        kebutuhan untuk berbagai ukuran banner, silakan hubungi kami dan kami akan bertindak
                                        balas dengan secepat mungkin.
                                        <br />
                                        <br />
                                        Sila ambil perhatian bahwa rekening afiliasi Anda akan ditutup sekiranya spanduk
                                        @Model.SystemName belum memasang di situs web berdaftar. Jikalau anda tidak dapat
                                        memasang sepanduk @Model.SystemName dalam waktu tujuh hari Anda perlu memberitahui
                                        memberitahu kami untik mendapatkan persetujuan.
                                        <br />
                                        <br />
                                        Kami berharap Anda pasti berjaya melalui lintasan web Anda yang mendatangkan keuntungan
                                        lumayan kepada Anda!<br />
                                        <br />
                                        Terima kasih.<br />
                                        <br />
                                        Salam Sejahtera,<br />
                                        <br />
                                        Tim Afiliasi @Model.SystemName Anda<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="#d7d7d7" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © Hak Cipta @DateTime.Now.Year <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="#a30003" height="40">
                        <font style="font-size: 12px; color: #eba6a6; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            Ini adalah sistem yang dihasilkan otomatis email, harap jangan balas email ini secara langsung.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>