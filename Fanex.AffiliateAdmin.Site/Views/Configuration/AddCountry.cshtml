@{
    ViewBag.Title = Lang.AddNewCountry;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@model Fanex.AffiliateAdmin.DTO.Country
@using (Html.BeginForm("AddCountry", "Configuration", FormMethod.Post, new { @class = "form-horizontal form-popup" }))
{
    @Html.ValidationSummary()
    <div class="popup-content">
        <div class="control-group">
            @Html.LabelFor(m => m.CountryID, Lang.ID, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.CountryID, new { @class = "form-control" })
                <span class="required">*</span>
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.CountryName, Lang.Name, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.CountryName, new { @class = "form-control" })
                <span class="required">*</span>
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Description, Lang.Description, new { @class = "control-label" })
            <div class="controls">
                @Html.TextAreaFor(m => m.Description, new { @class = "medium-textarea" })
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Icon, Lang.Icon, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.Icon, new { @class = "form-control" })
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.DisplayOrder, Lang.DisplayOrder, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBox("DisplayOrder", string.Empty, new { @class = "form-control" })
                <span class="required">*</span>
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.IsEnabled, Lang.IsEnabled, new { @class = "control-label" })
            <div class="controls">
                @Html.CheckBoxFor(m => m.IsEnabled, new { @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="popup-footer">
        <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnUpdate" class="btn">@Lang.Add</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </div>
}
@section scripts{
    @if (ViewBag.Result != null)
    {
        var result = (Fanex.AffiliateAdmin.Models.ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus( @result.ErrorCode, "@result.Message", parent.Country.ReRenderAfterPaged );
        </script>
    }
    @Scripts.Render("~/scripts/country")
}
