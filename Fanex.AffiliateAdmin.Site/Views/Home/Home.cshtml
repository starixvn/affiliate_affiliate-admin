@{
    ViewBag.Title = Lang.HomePage;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Utilities

@model Fanex.AffiliateAdmin.Models.HomeViewModel
@section iconcss{
    home
}

@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Home, 0)
}

<!--Waiting task & Banner Statistics-->
<div class="row-fluid">
    <div class="span6">
        <table class="table table-bordered">
            <tr>
                <th colspan="4">  
                    @Lang.TaskWaitingApp
                </th>
            </tr>
            <tr>
                <td>@Lang.Affiliate</td>
                <td>
                    @Model.PendingAllNum
                </td>
                <td>@Lang.Payment</td>
                <td>@Model.PaymentRequestNum</td>
            </tr>
        </table>
    </div>
    <div class="span6">
        <table class="table table-bordered">
            <tr>
                <th colspan="4">
                    @Lang.BannerStatc (We have @Model.BannerNum banner(s) in the program)
                </th>
            </tr>
            <tr>
                <td>@Lang.ImageBanner</td>
                <td>@Model.ImageBannerNum</td>
                <td>@Lang.FlashBanner</td>
                <td>@Model.FlashBannerNum</td>
            </tr>
        </table>
    </div>    
</div>

<!--Affiliate statistics chart for all and current month-->
<div class="row-fluid">
    <div class="span6 ic-hometask">
        <div id="chartAll">
        </div>
    </div>

    <div class="span6 ic-banner">
        <div id="chartMonth">
        </div>
    </div>
</div>

<!--Member statistics-->
<div class="row-fluid">
    <div class="span6">
        <table class="table table-bordered table-hover table-striped">
            <tr>
                <th colspan="2">
                    @Lang.MemStatAll
                </th>
            </tr>
            <tr>
                <td colspan="2">
                    <p>
                        @Lang.WeHave
                        We have <strong>@Model.MemInProAllNum</strong> members in the program<br />
                        <strong>@Model.DepositMemAllNum</strong> @Lang.Deposit / <strong>@(Model.MemInProAllNum - Model.DepositMemAllNum)</strong> @Lang.NonDeposit
                    </p>
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalDeposit</td>
                <td>@Model.DepositAll</td>
            </tr>
            <tr>
                <td>@Lang.TotalPSPFees</td>
                <td>@Model.PSPFeeAll</td>
            </tr>            
            <tr>
                <td>@Lang.TotalWinlost</td>
                <td>@Model.WinlostAll</td>
            </tr>
            <tr>
                <td>@Lang.TotalBonus</td>
                <td>@Model.BonusAll</td>
            </tr>
            <tr>
                <td>@Lang.TotalAdjustment</td>
                <td>@Model.AdjustmentAll</td>
            </tr>
            <tr class="info">
                <td>@Lang.TotalNetWinlost</td>
                <td>@Model.NetWinlostAll</td>
            </tr>
        </table>
    </div>
    <div class="span6">
         <table class="table table-bordered table-hover table-striped">
            <tr>
                <th colspan="2">
                    @Lang.MemStatcMonth
                </th>
            </tr>
            <tr>
                <td colspan="2">
                    <p>
                        We have <strong>@Model.MemInProMonthNum</strong> members in the program.<br />
                        <strong>@Model.DepositMemMonthNum</strong> @Lang.Deposit / <strong>@(Model.MemInProMonthNum - Model.DepositMemMonthNum)</strong> @Lang.NonDeposit
                    </p>
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalDeposit</td>
                <td>@Model.DepositMonth</td>
            </tr>
            <tr>
                <td>@Lang.TotalPSPFees</td>
                <td>@Model.PSPFeeMonth</td>
            </tr>            
            <tr>
                <td>@Lang.TotalWinlost</td>
                <td>@Model.WinlostMonth</td>
            </tr>
            <tr>
                <td>@Lang.TotalBonus</td>
                <td>@Model.BonusMonth</td>
            </tr>
            <tr>
                <td>@Lang.TotalAdjustment</td>
                <td>@Model.AdjustmentMonth</td>
            </tr>
            <tr class="info">
                <td>@Lang.TotalNetWinlost</td>
                <td>@Model.NetWinlostMonth</td>
            </tr>
        </table>
    </div>    
</div>

<!--User online list-->
<div class="row-fluid expand-collapse">
    <div class="span12">
       <strong>@Lang.CurrOnlineList</strong> <a href="javascript:void(0)" id="toggleOnlineList"><i class="icon-minus"></i></a>
    </div>
</div>

<div id="gridId" class="freegrid">
</div>

@section scripts{
    <script src="~/Scripts/site/Dashboard.js" type="text/javascript"></script>
    <script type="text/javascript" src="https://www.google.com/jsapi"></script>
    <script type="text/javascript">
        var gridOption = {
            columns: [
                        { HeaderText: "#", Width: 30, Name: "No", CellAlign: "center" },
                        { HeaderText: "@Lang.Username", Width: 150, Name: "Username" },
                        { HeaderText: "@Lang.LoggedIn", Width: 110, Name: "LoggedIn", FormatDateTime: AFFILIATE.DATE_FORMAT },
                        { HeaderText: "@Lang.LastRequest ", Width: 110, Name: "LastRequest", FormatDateTime: AFFILIATE.DATE_FORMAT },
                        { HeaderText: "@Lang.IP", Width: 100, Name: "Ip", CellAlign: "center" },
                        { HeaderText: "@Lang.Role", Width: 100, Name: "Role", CellAlign: "center" }
                   ],
            showPager: true,
            customPager: true,
            gridExpandHeight: 290,
            showNumberColumn: true
        };
        
        google.load("visualization", "1", { packages: ["corechart"] });
        google.setOnLoadCallback(drawChart);
        function drawChart() {
            var dataAll = google.visualization.arrayToDataTable([
                ['@Lang.AffStatisticsAll', 'Status'],
                ['@Lang.Pending', @Model.PendingAllNum],
                ['@Lang.Approved', @Model.ApprovedAllNum],
                ['@Lang.Disapproved', @Model.DisapprovedAllNum],
                ['@Lang.Closed', @Model.ClosedAllNum],
                ['@Lang.LockedOut', @Model.LockedAllNum]
            ]);

            var optionsAll = {
                title: '@Lang.AffStatisticsAll'
            };

            var chart = new google.visualization.PieChart(document.getElementById('chartAll'));
            chart.draw(dataAll, optionsAll);

            var dataMonth = google.visualization.arrayToDataTable([
                ['@Lang.AffStatisticsAll', 'Status'],
                ['@Lang.Pending', @Model.PendingMonthNum],
                ['@Lang.Approved', @Model.ApprovedAllNum],
                ['@Lang.Disapproved', @Model.DisapprovedMonthNum],
                ['@Lang.Closed', @Model.ClosedMonthNum],
                ['@Lang.LockedOut', @Model.LockedMonthNum]
            ]);

            var optionsMonth = {
                title: '@Lang.AffMonthStatc'
            };

            var chart2 = new google.visualization.PieChart(document.getElementById('chartMonth'));
            chart2.draw(dataMonth, optionsMonth);
        }
    </script>
}