@{
    ViewBag.Title = Lang.ExchangeRate;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.DTO
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Configurations

@section iconcss{
exchange-rate
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Exchange, 0, "currency")
}
<div class="search-panel" style="width: 1000px">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", "Information text", false, false)
    <form class="row-fluid" id="SearchForm">
    <div class="span12 search-form">
        <div class="row-fluid row-form end-search">
            <div class="cell">
                @Html.DatePicker("Time", DateTime.Now, AppSettings.SystemStartDate,DateTime.Now)
                <button type="button" id="btnSubmit" class="btn btn-default" style="vertical-align: top">@Lang.Submit</button>
            </div>
        </div>
    </div>
    </form>
</div>

<div class="grid-status">
<div id="gridId" class="freegrid" colheight="200" expheight="290"></div>
<br />
<p id="notification-header" class="hide text-error">
    * @Lang.DropLastZeroDigits
</p>
<div id="notification" class="text-error">
</div>
</div>
@section scripts{
    <script>
        var MSG = {
            SelRate: "@Lang.SelRate",
            NoInfo: "@Lang.NoInfo",
            ConfirmCopyRate: "@Lang.ConfirmCopyRate",
            Rate: "@Lang.rate_",
            MarketRate: "@Lang.MarketRate",
            Title: "@Lang.ExchangeRate"
        };
        
        var sampleGridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.ExchangeRate",
                showButtonsWhenNoData: true,
                customButtons: "<input type='button' name='btnCopy' value='' title='@Lang.CopyRateMarket' class='btnAdd icon-add-config' id='btnCopy'>"
            },
            columns: [
                {
                    HeaderText: "",
                    Width: 30,
                    Name: "a",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function(rowIndex, rowData, cell, cellFormated) {
                        return "<input class='check' type='checkbox' data-mid='" + rowData.ExchangeID + "' />";
                    }
                },
                { HeaderText: "#", Width: 30, Name: "b", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Currency", Width: 70, Name: "Code", HeaderAlign: "center", CellAlign: "center" },
                {
                    HeaderText: "@Lang.AutoUpdate",
                    Width: 100,
                    Name: "IsAutoRefresh",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function(rowIndex, rowData, cell, cellFormated) {
                        return "<input class='autoupdate' type='checkbox' " + (rowData.IsAutoRefresh ? "checked='checked'" : null) + " data-id='" + rowData.ExchangeID + "' />";
                    }
                }
            ],
            showPager: false,
            customPager: true,
            allowTruncate: false,
            gridExpandHeight: 290,
            numberOfFrozenColumn: 3,
            headerColumnHeight: 38,
            indexNumberColumn: 1
        };
        
        $(function () {
            EXCHANGE.init();
        });
    </script>
    <script src="@Url.Content("~/Scripts/site/Exchange.js")" type="text/javascript"></script>
}
