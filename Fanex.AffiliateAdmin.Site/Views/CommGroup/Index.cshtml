@{
    ViewBag.Title = @Lang.CommissionGroup;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@section iconcss{
commgroup
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.CommGroup, 0, "commissionGroup")
}
<div class="search-panel search-commgroup">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", "Information text", false, false)
    <form class="row-fluid" id="SearchForm">
    <div class="span12 search-form">
        <div class="row-fluid row-form end-search">
            <div class="cell">
                <label for="groupname">@Lang.GroupName</label>
                <input type="text" size="25" value="@ViewBag.GroupName" class="form-control width-140" id="groupname" name="groupname" placeholder="@Lang.All">
            </div>
            <div class="cell">
                <label for="currency">@Lang.Currency</label>
                @Html.DropDownCheckList("currencylist", new SelectList(SessionManager.CurrentSession.CurrencyList, "CurrencyID", "CurrencyCode"), true, true, new { @class = "width-140" })
            </div>
            <div class="cell">
                <label for="month" class="">@Lang.Month</label>
                @Html.MonthPicker("month", DateTime.Now, AppSettings.SystemStartDate, DateTime.Now, new { @class = "width-140" })                
            </div>
        </div>
        <div class="row-fluid row-form btn-action">
            <div class="span12">
                <button type="submit" id="btnSubmit" class="btn btn-default" style="vertical-align: top">@Lang.Submit</button>
            </div>
        </div>
    </div>
    </form>
</div>
<div class="clear">
</div>

<div id="gridId" class="freegrid" colheight="210" expheight="300">
</div>
<br />
<p id="notification-header" class="hide text-error">
    * @Lang.DropLastZeroDigits
</p>
<div id="notification" class="text-error">
</div>
@section css{
    <link href="@Url.Content("~/Content/themes/Default/commgroup.less")" rel="stylesheet" type="text/css" />
}
@section scripts{
    <script>
        var MSG = {
            SelRate: "@Lang.SelRate",
            NoInfo: "@Lang.NoInfo",
            ConfirmCopyRate: "@Lang.ConfirmCopyRate",
            ConfirmDelGroup: "@Lang.ConfirmDelGroup",
            Remove: "@Lang.Remove",
            Edit: "@Lang.Edit"
        };
        var IS_IT = @(ViewBag.IsIT ? "true" : "false");
        var formatter = function (rowIndex, rowData, cell, cellFormated) {
            var className = cell.Name == rowData.Code ? "c" : "linkpopup";
            return "<div class='" + className + "' data-exchangeid='" + rowData.ExchangeID +
                "' data-codefrom='" + rowData.Code +
                "' data-codeto='" + cell.Name +
                "' data-rate='" + cellFormated + "'>" + cellFormated + "</div>";
        };
        var gridOption = {
            showTitle: true,
            titleInfo:
            {
                text: "@Lang.CommissionGroup",
                showAddButton: true,
                addFunction: function() {
                    COMMGROUP.showAddPopup();
                }
            },
            showHighlightRow: false,
            customizeHeader: true,
            groupHeaderRows: [
                {
                    Columns: [
                        { HeaderText: "#", Width: 30, Name: "b", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Name", Width: 70, Name: "GroupName", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.NoOfAffiliate", Width: 70, Name: "NoOfAffiliate", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Description", Width: 70, Name: "Description", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Creator", Width: 65, Name: "Creator", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.CreatedDate", Width: 70, Name: "CreatedDate", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.QualifiedAmount", Width: 70, Name: "QualifiedAmount", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Currency", Width: 55, Name: "Currency", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Policy", Width: 70, Name: "ProductName", MergeColNumber: 8 },
                        { HeaderText: "@Lang.Deduction", Width: 70, Name: "Deduction", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Action", Width: 50, Name: "Action", MergeRowNumber: 2 }
                    ]
                }
            ],
            columns: [
                { HeaderText: "#", Width: 30, Name: "b", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Name", Width: 70, Name: "GroupName", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.NoOfAffiliate", Width: 70, Name: "NoOfAffiliate", HeaderAlign: "center", CellAlign: "center"},
                { HeaderText: "@Lang.Description", Width: 70, Name: "Description", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Creator", Width: 65, Name: "Creator", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.CreatedDate", Width: 70, Name: "CreatedDate", HeaderAlign: "center", CellAlign: "center", FormatDateTime: AFFILIATE.DATE_FORMAT },
                { HeaderText: "@Lang.QualifiedAmount", Width: 70, Name: "QualifiedAmount", HeaderAlign: "center", CellAlign: "center", FormatNumber: AFFILIATE.FORMAT_INT_NUMBER },
                { HeaderText: "@Lang.Currency", Width: 55, Name: "Currency", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Product", Width: 70, Name: "ProductName", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Tier", Width: 70, Name: "TierID", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.MinAmount", Width: 70, Name: "MinAmount", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.MaxAmount", Width: 70, Name: "MaxAmount", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.MinQM", Width: 70, Name: "MinQM", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.MaxQM", Width: 70, Name: "MaxQM", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.Commission", Width: 70, Name: "Commission", HeaderAlign: "center", CellAlign: "center", FormatNumber: AFFILIATE.FORMATNUMBER },
                { HeaderText: "@Lang.Deductions", Width: 110, Name: "Deductions", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Deduction", Width: 70, Name: "Deduction", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER },
                { HeaderText: "@Lang.Action", Width: 50, Name: "Action", HeaderAlign: "center", CellAlign: "center" }
            ],
            showPager: true,
            customPager: true,
            allowTruncate: true,
            gridExpandHeight: 300,
            showColumnsShowHide: true,
            columnsNeedHide: [16]
            // numberOfFrozenColumn: 3,
            //headerColumnHeight: 38,
            //indexNumberColumn: 1
            //showNumberColumn: true
        };
        $(function () {
            COMMGROUP.init();
        });
    </script>
    <script src="@Url.Content("~/Scripts/site/CommGroup.js")" type="text/javascript"></script>
}
