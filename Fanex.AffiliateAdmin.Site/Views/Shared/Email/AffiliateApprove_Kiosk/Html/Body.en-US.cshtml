@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminSiteUrl/Content/themes/theme1/images/email_bg.png">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminSiteUrl/Content/themes/theme1/images/email_top.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="#a30003" height="25">
                        &nbsp;&nbsp; <strong style="color: #ffffff;"><font style="font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">Affiliate Notification </font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="#ffffff">
                        <table style="text-align: left" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td style="padding: 20px 15px">
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Dear valued Affiliate,</strong><br />
                                        <br />
                                        Congratulations, you are now a valued @Model.SystemName Affiliate member!<br />
                                        <br />
                                        To assist us in serving you better please update any latest change in your personal
                                        details in "My Account" at our @Model.SystemName Affiliate site.<br />
                                        <br />
                                        We wish you all the best and may your web traffic bring forth great profits to you!<br />
                                        <br />
                                        Thank you.<br />
                                        <br />
                                        Regards,<br />
                                        <br />
                                        Your @Model.SystemName Affiliates Team<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="#d7d7d7" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © Copyright @DateTime.Now.Year <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="#a30003" height="40">
                        <font style="font-size: 12px; color: #eba6a6; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            This is a system auto generated email, please do not reply to this email directly.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>