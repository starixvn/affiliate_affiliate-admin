@{
    ViewBag.Title = Lang.UpdateConfiguration;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@model Fanex.AffiliateAdmin.Models.SystemSettingUpdateViewModel
@using (Html.BeginForm("UpdateConfiguration", "Configuration", FormMethod.Post, new { @class = "form-horizontal form-popup" }))
{
    @Html.ValidationSummary()
    <div class="popup-content">
        @Html.Hidden("Id", Model.SId)
        @Html.HiddenFor(t => t.Type)
        <div class="form-group">
            @Html.LabelFor(m => m.SName, Lang.Key, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.SName, new { @class = "form-control", @readonly = "readonly", @disabled = "disabled" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Description, Lang.Description, new { @class = "control-label" })
            <div class="controls">
                @Html.TextAreaFor(m => m.Description, new { @class = "small-textarea" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Environment, Lang.Environment, new { @class = "control-label" })
            <div class="controls">
                @Html.DropDownList("Environment", Model.EnvironmentOptionList, new { @class = "width-140 dropdownchecklist single-select" })
            </div>
        </div>
        <div class="form-group">
            @Html.Label("Value", Lang.Value, new { @class = "control-label" })
            <div class="controls">
                @Html.TextArea("Value", Model.SValue, new { @class = "large-textarea" })
                <span class="required">*</span>
            </div>
        </div>
    </div>
    <div class="popup-footer">
        <div class="form-group">
            <div class="controls">
                <button id="btnUpdate" type="submit" class="btn">@Lang.Update</button>
                <button id="btnCancel" type="button" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </div>
    
}
@section scripts{
    @if (ViewBag.Result != null)
    {
        var result = (Fanex.AffiliateAdmin.Models.ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.Configuration.ReRenderAfterPaged);
        </script>
    }
    <script src="~/Scripts/site/Configuration.js" type="text/javascript"></script>
}
