@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Models
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Services
@model MessageViewModel
@{
    ViewBag.Title = Lang.MessageList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section iconcss{
message
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Message, 0, "Message")
}
@{
    var now = SystemTimeService.GetSystemDateTime();
}
<div class="search-panel">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    @using (Html.BeginForm("DataList", "Message", FormMethod.Post, new { @class = "row-fluid" }))
    {
        <div class="span12 search-form">
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    @Html.LabelFor(m => m.SearchBy)
                    @Html.DropDownCheckList("SearchBy", MessageSettings.ListSearchBy, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    &nbsp;&nbsp;
                    @Html.CheckBoxFor(m => m.DateChecked)
                    @Html.LabelFor(m => m.FromDate)
                    @Html.DatePicker("FromDate", new DateTime(now.Year, now.Month, 1), AppSettings.SystemStartDate, now, true)
                    &nbsp;&nbsp;&nbsp;&nbsp;
                    @Html.LabelFor(m => m.ToDate)
                    @Html.DatePicker("ToDate", now, AppSettings.SystemStartDate, now, true)
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" class="btn" id="btnSubmit">
                        @Lang.Submit
                    </button>
                </div>
            </div>
        </div>
    }
</div>
<div id="gridId" class="freegrid">
</div>
@section scripts{
    <script type="text/javascript">
        var MSG = {
            AddMessage: "@Lang.AddMessage",
            EditMessage: "@Lang.EditMessage",
            InvalidMessage: "@Lang.InvalidMessage",
            DeleteMessageMsg: "@Lang.DeleteMessageMsg",
            EditCurrentMessage: "@Lang.EditCurrentMessage",
            Remove: '@Lang.Remove',
            Edit: '@Lang.Edit'
        };

        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.MessageList",
                showButtonsWhenNoData: true,
                customButtons: '<input type="button" name="btnAdd" value="" title="@Lang.AddMessage" class="btnAdd icon-add-message" /> <input type="button" name="btnEdit" value="" title="@Lang.EditCurrentMessage" class="btnEdit icon-edit-message" />'
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Creator", Width: 80, Name: "CreatorName", HeaderAlign: "center" },
                { HeaderText: "@Lang.PostDate", Width: 160, Name: "PostedDateStr", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Message", Width: 400, Name: "Message_en", HeaderAlign: "center", Formatter: formatMessage },
                { HeaderText: "@Lang.Important", Width: 70, Name: "Important", HeaderAlign: "center", Formatter: formatImportant },
                { HeaderText: "@Lang.UpdatedBy", Width: 70, Name: "UpdateName", HeaderAlign: "center", CanResize: true },
                { HeaderText: "@Lang.UpdateDate", Width: 160, Name: "UpdatedDateStr", HeaderAlign: "center", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Action",
                    Width: 70,
                    Name: "Update",
                    CellAlign: "center",
                    CanResize: true,
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a href='javascript:Message.editMessage({0})' title='{1}'><i class='icon-edit'></i>".format(record.Msgid, MSG.Edit) +
                            "</a>&nbsp;&nbsp;<a href='javascript:Message.deleteMessage({0});' title='{1}'><i class='icon-remove'></i></a>".format(record.Msgid, MSG.Remove);
                    }
                }
            ],
            showPager: true,
            customPager: true,
            gridExpandHeight: 360,
            allowTruncate: true,
            indexNumberColumn: 0,
            autoResizeColumn: true
        };

        function formatImportant(rIndex, record, cell, cellFormated) {
            if (cell.Value) {
                return 'Yes';
            }
            return 'No';
        }

        function formatMessage(rIndex, record, cell, cellFormated) {
            var text = cell.Value;

            if (text == "") {
                text = " ";
            }
            var _class = "text";

            if (record.Important) {
                _class += " important";
            }

            return '<div class="' + _class + '" >' + text + '</div>';
        }

    </script>
    @Scripts.Render("~/scripts/message")
}
