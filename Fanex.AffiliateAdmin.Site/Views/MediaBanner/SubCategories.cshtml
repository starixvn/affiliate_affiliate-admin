@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Models.MarketingTools
@model SubCategoriesViewModel

@if (Model.SubCategories.Any())
{
     if (Model.IsShowAll)
     {
         <!-- for search panel -->
         @Html.Label("SubCategory", Lang.SubCategory, new {@class = "txt"})
         @Html.DropDownCheckList("SubCategory", Model.SubCategoryOptionList, false, false, new { @class = "width-140" })
     }
     else
     {
         <!-- for add, update action-->
         @Html.Label("SubCategory", Lang.SubCategory, new { @class = "control-label" })
         <div class="controls">
             @Html.DropDownCheckList("SubCategory", Model.SubCategoryOptionList, false, false)
         </div>
     }
}
