@{
    ViewBag.Title = Lang.Statistics;
    Layout = "~/Views/Shared/_LayoutFrameNoHeader.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@using System.Web

@model Fanex.AffiliateAdmin.Models.AffiliateStatisticViewModel

@{
    var lastDay = Model.FullDateTime.AddMonths(1).AddDays(-1);
    var fromDate = Model.FullDateTime > AppSettings.SystemStartDate ? Model.FullDateTime.ToString("dd MMM yyyy") : AppSettings.SystemStartDate.ToString("dd MMM yyyy");
    var toDate = lastDay < DateTime.Now ? lastDay.ToString("dd MMM yyyy") : DateTime.Now.ToString("dd MMM yyyy");
}

@Styles.Render("~/bundles/css")

<table id="top_panel" class="top_panel">
    <colgroup>
        <col width="40%" />
        <col width="30%" />
        <col width="30%" />
    </colgroup>
    <thead>
        <tr>
            <td class="top_colexp"><span id="spStatistic" class="statistic-show"></span>@Lang.Statistics</td>
            <td class="col-data">
                @Html.MonthPicker("monthyear", Model.FullDateTime, AppSettings.SystemStartDate, DateTime.Now, new { @class = "width-ex-90" })
            </td>
            <td class="col-data">@Lang.UpToNow</td>
        </tr>
    </thead>
    <tbody id="stContent">
        <tr>
            <td class="col-label">@Lang.NewSignup/@Lang.FDM</td>
            <td class="col-data">
                @Html.ActionLink(Model.Statistic.NewSignUp.ToString(), "MemberListByAffiliate", "Affiliate", new { DateOption = 1, FromDate = fromDate, ToDate = toDate }, new { @class = "link" })/@Html.ActionLink(Model.Statistic.NewSignUpDep.ToString(), "MemberListByAffiliate", "Affiliate", new { DateOption = 2, FromDate = fromDate, ToDate = toDate }, new { @class = "link" })
            </td>
            <td class="col-data">
                @Html.ActionLink(Model.Statistic.TotalPlayer.ToString(), "MemberListByAffiliate", "Affiliate", new { DateOption = 0 }, new { @class = "link" })/@Model.Statistic.TotalPlayerDepUp
            </td>
        </tr>
        @if (Model.Statistic.TotalActivePlayer != 0 && Model.FullDateTime.CompareTo(AppSettings.SystemStartDate) >= 0)
        {
        <tr>
            <td class="col-label">@Lang.TotalActive</td>
            <td class="col-data">
                @Html.ActionLink(Model.Statistic.TotalActivePlayer.ToString(), "PlayerWinlossByAffiliate", "Report", new { GroupBy = 1, FromDate = fromDate, ToDate = toDate }, new { @class = "link" })
            </td>
            <td class="col-data">@Lang.NotAvaliable</td>
        </tr>
        }
        @if (Model.Products.Any())
        {
        <tr>
            <td class="col-label">@Lang.TotalQualifiedMembers
                (<span class="link-box-active nopadding" id="spProduct">@Model.Products.FirstOrDefault().ProductName</span><select id="slProduct" name="slProduct" style="display: none;" class="width-ex-100 nopadding">
                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.ProductName" data-qualified="@product.TotalQualifiedMembers" data-product="@product.ProductID">@product.ProductName</option>
                    }
                </select>)
            </td>
            <td class="col-data" id="dataqualified">
                <a href="javascript:void(0)" data-date="@Model.FullDateTime.ToString("MMM yyyy")" 
                   data-affid="@Model.AffId" data-affname="@Model.AffName" data-currency="@Model.BaseCurrency" class="qm" >
                    @Model.Products.FirstOrDefault().TotalQualifiedMembers
                </a>
            </td>
            <td class="col-data">@Lang.NotAvaliable</td>
        </tr>
        }
        <tr>
            <td class="col-label">@Lang.TotalDeposit</td>
            <td class="col-data">
                @Html.ActionLink(FormaterCurrency.Format(Model.Statistic.TotalDeposit), "PlayerWinlossByAffiliate", "Report", new { GroupBy = 1, FromDate = fromDate, ToDate = toDate }, new { @class = "link" })
            </td>
            <td class="col-data">@MvcHtmlString.Create(FormaterCurrency.Format(Model.Statistic.TotalDepositUp))</td>
        </tr>
        <tr>
            <td class="col-label">@Lang.TotalTurnover</td>
            <td class="col-data">
                @Html.ActionLink(FormaterCurrency.Format(Model.Statistic.TotalTurnover), "PlayerWinlossByAffiliate", "Report", new { GroupBy = 1, FromDate = fromDate, ToDate = toDate }, new { @class = "link" })
            </td>
            <td class="col-data">@MvcHtmlString.Create(FormaterCurrency.Format(Model.Statistic.TotalTurnoverUp))</td>
        </tr>
        <tr>
            <td class="col-label">@Lang.TotalWinlost</td>
            <td class="col-data">
                <a href="@Url.Action("PlayerWinlossByAffiliate", "Report", new { GroupBy = 1, FromDate = fromDate, ToDate = toDate })" class="link">@Html.Raw(FormaterCurrency.Format(Model.Statistic.TotalWinlost))</a>
            </td>
            <td class="col-data">@Html.Raw(FormaterCurrency.Format(Model.Statistic.TotalWinlostUp))</td>
        </tr>
        <tr>
            <td class="col-label">@Lang.TrackingRate</td>
            <td class="col-data">
                @Html.ActionLink(Model.Statistic.TotalUniqueClicks.ToString(), "Referrer", "TrackingStatistic", new { FromDate = fromDate, ToDate = toDate }, new { @class = "link" })/@Html.ActionLink(Model.Statistic.TotalClicks.ToString(), "Referrer", "TrackingStatistic", new { FromDate = fromDate, ToDate = toDate }, new { @class = "link" })
            </td>
            <td class="col-data">@Lang.NotAvaliable</td>
        </tr>
    </tbody>
</table>


@section scripts{
    <script type="text/javascript">
        var MSG = {
                AffQualifiedMemReportDetailFor: "@Html.Raw(Lang.AffQualifiedMemReportDetailFor)",
                Currency: "@Lang.Currency"
            };
    </script>
    <script src="~/Scripts/site/AffiliateStatistic.js" type="text/javascript"></script>
}