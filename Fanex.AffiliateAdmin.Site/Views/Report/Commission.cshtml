@{
    ViewBag.Title = Lang.CommissionReport;
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section iconcss{
report
}
@section submenu{
    @RazorHelper.ListSubmenu(Fanex.AffiliateAdmin.Core.Utilities.SubMenu.Reports, 2, "report")
}
@{
    var now = DateTime.Now;
}

@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@model Fanex.AffiliateAdmin.Models.CommissionReportViewModel
<div class="search-panel search-company-winloss" style="min-width: 1100px" >
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", "Information text", false, false)
    @using (Html.BeginForm("Commission", "Report", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {            
        <div class="span12 search-form search-company-winloss">
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="AffName" class="txt">@Lang.Affiliate</label>
                    <input type="text" class="form-control width-140" id="AffName" name="AffName" placeholder="@Lang.All" maxlength="100"/>
                </div>
                <div class="cell">
                    <label for="AffTypes" class="txt">@Lang.AffType</label>
                    @Html.DropDownCheckList("AffTypes", Model.AffTypeOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="CommGroups" class="txt width-100">@Lang.CommissionGroup</label>
                    @Html.DropDownCheckList("CommGroups", Model.CommissionGroupOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="PreferLanguages" class="txt auto">@Lang.Language</label>
                    @Html.DropDownCheckList("PreferLanguages", Model.PreferLanguageOptionList, true, true, new { @class = "width-140" })
                </div>
            </div>
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="Currencies" class="txt">@Lang.Currency</label>
                    @Html.DropDownCheckList("Currencies", Model.CurrencyOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="DateOption" class="txt">@Lang.GroupBy</label>
                    @Html.DropDownCheckList("GroupBy", Model.GroupByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="FromDate" class="txt width-100">@Lang.From</label>
                    @Html.MonthPicker("FromDate", now, AppSettings.SystemStartDate, now, false)                    
                </div>
                <div class="cell">
                    <label for="ToDate" class="txt auto text-left">@Lang.To</label>
                    @Html.MonthPicker("ToDate", now, AppSettings.SystemStartDate, now, false)
                </div>
            </div>
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.BaseCurrency</label>
                    @Html.DropDownCheckList("BaseCurrency", Model.BaseCurrencyOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="DrawFilter" class="txt">@Lang.DrawFilter</label>
                    @Html.DropDownCheckList("DrawFilter", Model.DrawFilterOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    @Html.Label("SortBy", Lang.SortBy, new { @class = "txt width-100" })                    
                    @Html.DropDownCheckList("SortBy", Model.SortByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell checkbox">
                    <label for="ExcludeTest">
                        @Html.CheckBoxFor(m => m.ExcludeTest)
                        @Lang.ExcludeTestAccounts
                    </label>
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button id="btnSubmit" type="submit" class="btn btn-default">@Lang.Submit</button>
                </div>
            </div>
        </div>
    }
</div>
<div id="gridId" class="freegrid" colheight="200" expheight="350">
</div>
<div class="content legend">
    <div class="row-fluid">
        <ul class="unstyled inline status pull-right">
            <li><span class="approved"></span>@Lang.Approved</li>
            <li><span class="locked"></span>@Lang.LockedOut</li>            
            <li><span class="closed"></span>@Lang.Closed</li>
        </ul>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        var MSG = {
            ActivePlayers: "@Lang.ActiveMembers",
            BetCount: "@Lang.BetCount",
            Turnover: "@Lang.Turnover",
            Winloss: "@Lang.Winloss",
            Commission: "@Lang.Commission",
            SubTotalIn: "@Lang.SubTotalIn",
            Total: "@Lang.Total",
            TotalAll: "@Lang.TotalAll",
            Sportsbook: "@Lang.Sportsbook",
            NumberGame: "@Lang.NumberGame",
            LiveCasino: "@Lang.LiveCasino",
            RNGCasino: "@Lang.RNGCasino",
            SubTotal: "@Lang.SubTotal",
            Total: "@Lang.Total",
            RangeTime3Months: "@Lang.RangeTime3Months",
            CommPercent: "@Lang.CommPercent",
            QM: "@Lang.QM",
            CommGroupSettingFor: "@Lang.CommGroupSettingFor",
            AffQualifiedMemReportDetailFor: "@Html.Raw(Lang.AffQualifiedMemReportDetailFor)",
            Currency: "@Lang.Currency",
            CommissionTitle: "@Lang.Commission",
            Amount: "@Lang.Amount",
            
        };
        var affiliateUrl = AFFILIATE.getAbsoluteUrl("AffiliateInfo?username=");
        var commGroupUrl = AFFILIATE.getAbsoluteUrl("CommGroup?groupname=");
        var PRODUCTS = @(Html.Raw(ViewBag.Products));
        var True = true, False = false;
        var HasCashbackDeduction = "@ViewBag.HasCashbackDeduction";

        var sampleGridOption = {
            showTitle: true,

            titleInfo:
            {
                customButtons: "<i title='Simple Mode' id='btnChangeViewMode' style='cursor: pointer' class='icon-circle-arrow-left'></i>",
                text: "@Lang.Commission",
            },
            groupHeaderRows: [
                {
                    Columns: [
                        { HeaderText: "@Lang.Affiliate", Name: "Username", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Month", Name: "WinlostDate", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.AffType", Name: "AffType", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Language", Name: "Language", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.CommGroup", Name: "GroupName", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Currency", Name: "Currency", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.ActiveMembers", Name: "ActivePlayers", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.BetCount", Name: "BetCount", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Deposit", IsCurrency: true, HeaderText: "@Lang.Deposit", Name: "Deposit", NameCache: "Deposit", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Cashback", HeaderText: "@Lang.Cashback", Name: "DeductedPercentage", MergeColNumber: 2 },
                        { HeaderCaption: "@Lang.Withdrawal", IsCurrency: true, HeaderText: "@Lang.Withdrawal", Name: "Withdrawal", NameCache: "Withdrawal", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Turnover", IsCurrency: true, HeaderText: "@Lang.Turnover", Name: "Turnover", NameCache: "Turnover", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Winloss", IsCurrency: true, HeaderText: "@Lang.Winloss", Name: "Winloss", NameCache: "Winloss", MergeRowNumber: 2 },
                        { HeaderCaption: "@Lang.Commission", IsCurrency: true, HeaderText: "@Lang.Commission", Name: "Commission", NameCache: "Commission", MergeRowNumber: 2 }
                    ]
                }
            ],
            columns: [
                {
                    HeaderText: "@Lang.Affiliate",
                    Width: 80,
                    Name: "Username",
                    HeaderAlign: "center",
                    CellAlign: "left",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a class='afflink' data-affname='" + record.Username + "' href='javascript:void(0)'>" + cellFormated + "</a>";
                    }
                },
                {
                    HeaderText: "@Lang.Month",
                    Width: 80,
                    Name: "WinlostDate",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    FormatDateTime: AFFILIATE.DATE_FORMAT_MONTH,
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a class='monthlink' data-affname='" + record.Username + "' href='javascript:void(0)' data-winlostdate='{0}'>".format(record.WinlostDate) + cellFormated + "</a>";
                    }
                },
                { HeaderText: "@Lang.AffType", Width: 80, Name: "AffType", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Language", Width: 80, Name: "Language", HeaderAlign: "center" },
                {
                    HeaderText: "@Lang.CommGroup",
                    Width: 80,
                    Name: "GroupName",
                    HeaderAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        if (cellFormated)
                            return "<a class='commgroup' data-date='" + moment(record.WinlostDate).format("MMM-YYYY") + "' data-groupid='" + record.GroupID + "' href='javascript:void(0)'>" + cellFormated + "</a>";
                        return null;
                    }
                },
                { HeaderText: "@Lang.Currency", Width: 80, Name: "Currency", HeaderAlign: "center", CellAlign: "center", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.ActiveMembers", Width: 80, Name: "ActivePlayers", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.BetCount", Width: 80, Name: "BetCount", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.Deposit", Width: 80, Name: "Deposit", NameCache: "Deposit", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.DeductionPercent", Width: 80, Name: "DeductedPercentage", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER },                
                { HeaderCaption: "@Lang.Amount", HeaderText: "@Lang.Amount", Width: 80, IsCurrency: true, Name: "Cashback", NameCache: "Cashback", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.Withdrawal", Width: 70, Name: "Withdrawal", NameCache: "Withdrawal", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.Turnover", Width: 80, Name: "Turnover", NameCache: "Turnover", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMAT_INT_NUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.Winloss", Width: 110, Name: "Winloss", NameCache: "Winloss", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.Commission", Width: 110, Name: "Commission", NameCache: "Commission", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' }
            ],
            allowTruncate: true,
            gridExpandHeight: 350,
            showFooter: true,
            customizeHeader: true,
            showDistinctRow: true,
            numberOfFrozenColumn: 6,
            headerColumnHeight: 30,
            
            rowCssClass: function (rowIndex, rowData) {
                return rowData.Status.toLowerCase();
            }
        };

    </script>
    <script src="@Url.Content("~/Scripts/site/CommissionReport.js")" type="text/javascript"></script>
}

