@{
    ViewBag.Title = Lang.EmailHistory;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using Fanex.AffiliateAdmin.DTO
@model Fanex.AffiliateAdmin.DTO.EmailHistory
@if (Model == null)
{
    @Lang.ErrInvalidData
}
else
{
    using (Html.BeginForm("Delete", "EmailHistory", FormMethod.Post, new { @class = "form-horizontal" }))
    {
    @Html.ValidationSummary()
    @Html.HiddenFor(m => m.Mid)
    <div class="popup-content">
        <div class="control-group">
            <label class="control-label">@Lang.Subject</label>
            <div class="controls">@HttpUtility.HtmlDecode(Model.Subject.Replace("&amp;", "&"))</div>
        </div>
        <div class="control-group">
            <label class="control-label">@Lang.From</label>
            <div class="controls">@HttpUtility.HtmlDecode(Model.Sender.Replace("&amp;", "&")) &nbsp;(<a href="javascript:DETAIL.openMail('mailto:@Model.Email')">@Model.Email</a>)
            </div>
        </div>
        <div class="control-group">
            <label class="control-label">@Lang.SentDate</label>
            <div class="controls">
                @Model.CreateDate
            </div>
        </div>
        <div class="control-group">
            <label class="control-label">@Lang.Content</label>
            <div class="controls">
                <textarea style="width: 300px; height: 128px;" id="txtContent" readonly="readonly">@HttpUtility.HtmlDecode(Model.Content.Replace("&amp;", "&"))</textarea>
            </div>
        </div>
    </div>
    <div class="popup-footer">
        <div class="control-group">
            <div class="controls">
                <button type="button" id="btnDelete" class="btn btn-default">@Lang.Delete</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </div>
    }
    @section css{
        <style>
            .form-horizontal .control-label
            {
                padding-top: 0px;
            }
            .form-horizontal .controls
            {
                margin-top: 2px;
            }
        </style>
    }
    @section scripts{
        <script>
            var MSG = {
                NoEmailSelected: "@Lang.NoEmailSelected",
                ConfirmDeleteEmail: "@Lang.ConfirmDeleteEmail"
            };
        </script>
        @Scripts.Render("~/scripts/emailhistorydetail")
    }
}