@helper ListSubmenu(List<Menu> list, int selectedMenu, string activeMenu = "home", int selectedSubMenu = -1)
{
    var url = new System.Web.Mvc.UrlHelper(Context.Request.RequestContext);
    <ul>
        @for (var i = 0; i < list.Count; i++)
        {
            var item = list[i];
            string activeText = (i == selectedMenu ? "class=\"current\"" : string.Empty);
            
            if (item.SubMenu == null || item.SubMenu.Count == 0)
            {
                <li @(new HtmlString(activeText))>
                    <a href="@(url.Content(item.Link))"><span>@item.Text</span></a>
                </li>
            }
            else
            {
                var link = (i == selectedMenu && selectedSubMenu != -1) ? item.SubMenu[selectedSubMenu].Link: item.Link;
                
                <li @(new HtmlString(activeText))>
                    <a href="@(url.Content(link))"><span>@item.Text</span></a>
                    <ul class="inner-submenu">
                        @for (int j = 0; j < item.SubMenu.Count; j++)
                        {
                            activeText = (j == selectedSubMenu ? "class=\"current\"" : string.Empty);
                            var ele = item.SubMenu[j];
                            
                           <li @(new HtmlString(activeText))>
                                <a href="@(url.Content(ele.Link))">&raquo; @ele.Text</a>
                           </li>
                        }
                    </ul>
                </li>
            }
        }
    </ul>
    <script type="text/javascript">
        $("#@(activeMenu)").addClass("active");
    </script>
}
@helper PageSizeDropdownList(int selectedPageSize = 10, string id = "pageSize", string postAction = "")
