@{
    ViewBag.Title = Lang.UserManagement;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var title = SessionManager.CurrentSession.IsIT ? Lang.AddNewITUser : Lang.AddNewUser;
}
@using Fanex.AffiliateAdmin.Core.Utilities
@model Fanex.AffiliateAdmin.Models.UserManagement.UserManagementViewModel
@section iconcss{
management
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Management, 0, "UserManagement")
}
<div class="search-panel search-userMgr">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", "Information text", false, false)
    @using (Html.BeginForm("Users", "Management", FormMethod.Post, new { @class = "row-fluid", id = "SearchForm" }))
    {
        @*@Html.ValidationSummary()*@
        <div class="span12 search-form">
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="username">@Lang.Username</label>
                    <input type="text" class="form-control" id="username" name="UserName" placeholder="@Lang.All" maxlength="100"/>
                </div>
                </div>
                <div class="row-fluid row-form end-search">
                <div class="cell">
                    <label for="FirstChar">@Lang.FirstLetter</label>
                    @RazorHelper.ListAlPhabet(Model.FirstLetter, new Dictionary<string, object> { { "name", "FirstChar" }, { "id", "FirstChar" } })
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" id="btnSearch" class="btn btn-default" style="vertical-align: top">@Lang.Submit</button>
                </div>
            </div>
        </div>
    }
</div>

<div id="gridId" class="freegrid content-grid">

</div>
@section scripts{
    <script type="text/javascript">
        var MSG = {
            NoInfo: "@Lang.NoInfo",
            ChangeStatus: "@Lang.ConfirmChangeStatusAff",
            AddNewUser: "@title",
            AccountPolicyOfUser: "@Lang.AccountPolicyOfUser",
            ChangePassword: "@Lang.ChangePassword",
            Group: "@Lang.Group"
        };

        var canUpdateData = @(ViewBag.CanUpdateData ? "true" : "false");

        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.UserManagement",
                showButtonsWhenNoData: true,
                customButtons: canUpdateData && @(ViewBag.IsIT ? 1 : 0) ? '<input type="button" name="btnAdd" value="" title="@title" class="btnAdd" id="btnAddgridId">': null
            },
            columns: [
                      { HeaderText: "#", Width: 40, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                      { HeaderText: "@Lang.Username", Width: 150, Name: "Username", Formatter:
                        function (rowIndex, rowData, cell, cellFormated) {
                            return (!canUpdateData || rowData.IsIT) ? cellFormated : '<a href="javascript:Management.editAccount(' + rowData.CustID + ",'" + rowData.Username + '\')">' + cell.Value + '</a>';
                        }
                      },
                      { HeaderText: "@Lang.Policy", Width: 150, Name: "PolicyCol", HeaderAlign: "center", CellAlign: "center", Formatter:
                        function (rowIndex, rowData, cell, cellFormated) {
                            return '<a href="javascript:Management.viewAccountPolicy(' + rowData.CustID + ",'" + rowData.Username + "','" + rowData.GroupName + '\')">@Lang.AccountPolicy</a>';
                        }
                      },
                      { HeaderText: "@Lang.GroupName", Width: 150, Name: "GroupName", Formatter:
                        function (rowIndex, rowData, cell, cellFormated) {
                            return '<a href="javascript:Management.viewGroup(' + rowData.GroupID + ",'" + rowData.GroupName + '\')">' + cell.Value + '</a>';
                        }
                      },
                      { HeaderText: "@Lang.Password", Width: 80, Name: "Password", CellAlign: "center", Formatter:
                        function (rowIndex, rowData, cell, cellFormated) {
                            if (rowData.IsIT == false || rowData.Status)
                                return "";
                            return "<a href=\"javascript:Management.editPassword(" + rowData.CustID + ",'" + rowData.Username + "\')\"><i class=\"icon-edit\"></i></a>";
                        }
                      }
                   ],
            showPager: true,
            gridExpandHeight: 320,
            showNumberColumn: true
        }
    </script>
    @Scripts.Render("~/scripts/usermanagement")
}
