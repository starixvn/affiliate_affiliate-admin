@{
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using Fanex.AffiliateAdmin.Models
@model Fanex.AffiliateAdmin.Models.ChangeAffPasswordViewModel
@using (Html.BeginForm("ChangePassword", "Affiliate", FormMethod.Post, new { @class = "form-horizontal form-popup" }))
{
     @Html.ValidationSummary()
     @Html.HiddenFor(m => m.Username)
     @Html.HiddenFor(m => m.Id)
     <div class="popup-content">
         <div class="control-group">
             <label class="control-label" for="Password">@Lang.Username</label>
             <div class="controls">
                 <label class="label-text bold">@Model.Username</label>
             </div>
         </div>
        <div class="control-group">
            <label class="control-label" for="Password">@Lang.Password</label>
            <div class="controls">
                @Html.Password("Password", Model.Password)
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="ConfirmPassword">@Lang.ConfirmPass</label>
            <div class="controls">
                @Html.Password("ConfirmPassword", Model.ConfirmPassword)
            </div>
        </div>
    </div>
     <div class="popup-footer">
        <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnUpdate" class="btn">@Lang.Update</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </div>
}
@section scripts{
    <script src="@Url.Content("~/Scripts/site/AffiliateList.js")" type="text/javascript"></script> 
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.Message", parent.AffiliateList.ReRenderAfterPaged);
        </script>
    }
}