@{
    ViewBag.Title = Lang.AffiliateInfo;
    Layout = "~/Views/Shared/_LayoutNoSubMenu.cshtml";
}

@model Fanex.AffiliateAdmin.Models.AffiliateInfoViewModel

<div class="panel">
    <div id="l-panel" class="l-panel">
        @if (Model == null)
        {
            @Html.Partial("~/Views/AffiliateInfo/_Search.cshtml");
        }
        else
        {
            <input type="hidden" id="UserName" value="@Model.AffiliateInfo.UserName" />
            <input type="hidden" id="Status" value="@Model.AffiliateInfo.Status" />
            @Html.Partial("~/Views/AffiliateInfo/_Info.cshtml");
        }
    </div>
    @if (Model != null && !string.IsNullOrEmpty(Model.AffiliateInfo.UserName))
    {
        <div id="c-panel" class="c-panel">
               <div id="StatisticPanel" class="span12 t-panel">
                   @if (Model.AffiliateInfo.Status.Equals("approved", StringComparison.OrdinalIgnoreCase))
                   {
                    @Html.Partial("~/Views/AffiliateInfo/_Statistic.cshtml", Model.StatisticViewModel)
                   }
                </div>
                <div id="ReportPanel" class="span12 b-panel">
                    <iframe id="ifReport" class="span12 report" seamless="seamless" style="border: none; overflow-x: hidden;"></iframe>
                </div>
        </div>
    }
</div>

@section scripts{

    @Scripts.Render("~/scripts/affiliatemaster")
    @Scripts.Render("~/scripts/affiliateinfo")
    @Scripts.Render("~/scripts/affiliatestatistic")
    <script type="text/javascript">
        var Lang = {
            ChangePassword: "@Lang.ChangePassword"
        };

        var MSG = {
            No: "@Lang.No",
            Yes: "@Lang.Yes",
            ConfirmChangeStatus: "@Lang.ConfirmChangeStatusAff",
            ConfirmChangeLanguage: "@Lang.ConfirmChangeLanguageAff",
            ConfirmChangeAffType: "@Lang.ConfirmUpdateTypeAff",
            ConfirmClose: "@Lang.ConfirmCloseAff",
            ConfirmOpen: "@Lang.ConfirmOpenAff",
            ConfirmUnLocked: "@Lang.ConfirmUnlockAff",
            ChangeComGroup: "@Lang.ChangeComGroup",
            CommissionGroup: "@Lang.CommissionGroup",
            ChangeAccountType: "@Lang.ChangeAccountType",
            AssignComGroup: "@Lang.AssignComGroup",
            ChangePassword: "@Lang.ChangePassword",
            AffQualifiedMemReportDetailFor: "@Html.Raw(Lang.AffQualifiedMemReportDetailFor)",
            Currency: "@Lang.Currency"
        };

        $(document).ready(function() {
            window.Mgmt = {
                ifStatistic: $('iframe#ifStatistic'),
                ifReport: $('iframe#ifReport')
            };
            setHeightBox();

            function setHeightBox() {
                $("#left_hide").css("height", ($(window).height() - 50));
            }
            var status = $("#Status").val().toLowerCase();
           if (status === 'approved') {
                //$("#ifStatistic").attr("src", AFFILIATE.getAbsoluteUrl("AffiliateInfo/Statistic"));
                $("#ifReport").attr("src", AFFILIATE.getAbsoluteUrl("Statement"));
                //$("#ifStatistic").attr("class", "statistic-exp");
            } else {
                $("#ifReport").attr("src", AFFILIATE.getAbsoluteUrl("AffiliateInfo/Edit"));
                //$("#ifStatistic").attr("class", "statistic-hide");
            }
        });
    </script>
}