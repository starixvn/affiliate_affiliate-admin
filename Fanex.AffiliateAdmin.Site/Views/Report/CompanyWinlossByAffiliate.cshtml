@{
    ViewBag.Title = Lang.EarningsHistory;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities

@model Fanex.AffiliateAdmin.Models.CompanyWLByAffiliateViewModel

@section iconcss{
    affiliate-info
}

@{
    var now = DateTime.Now;
}

@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 6, string.Empty, 0)
    <div class="line line-statement">
        <div class="ic-open-window" title="@Lang.FullScreen"></div>
        <div class="ic-reload" title="@Lang.RefreshPage"></div>
    </div>
}
<div class="search-panel search-company-winloss no-border">
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    @using (Html.BeginForm("CompanyWinloss", "Report", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {            
        <div class="span12 search-form">
            <div class="row-fluid row-form">
                <div class="cell ">
                    <label for="PlayerCurrencies" class="txt">@Lang.Currency</label>
                    @Html.DropDownCheckList("PlayerCurrencies", Model.PlayerCurrencyOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="DateOption" class="txt">@Lang.GroupBy</label>
                    @Html.DropDownCheckList("GroupBy", Model.GroupByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell width-160">
                    <label for="FromDate" class="txt">@Lang.From</label>
                    @Html.DatePicker("FromDate", new DateTime(now.Year, now.Month, 1), AppSettings.SystemStartDate, now, false)
                </div>
                <div class="cell width-160">
                    <label for="ToDate" class="txt auto text-left">@Lang.To</label>
                    @Html.DatePicker("ToDate", now, AppSettings.SystemStartDate, now, false)
                </div>
            </div>
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.DrawFilter</label>
                    @Html.DropDownCheckList("DrawFilter", Model.DrawFilterOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.BaseCurrency</label>
                    @Html.DropDownCheckList("BaseCurrency", Model.BaseCurrencyOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="Products" class="txt">@Lang.Product</label>
                    @Html.DropDownCheckList("Products", Model.ProductOptionList, true, false, new { @class = "width-140" })
                </div>

            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <input type="hidden" name="ByAffiliate" id="ByAffiliate" value="true" />
                    <input type="hidden" name="AffiliateCurrencySymbol" id="AffiliateCurrencySymbol" value="@ViewBag.AffiliateCurrencySymbol" />
                    <button id="btnSubmit" type="submit" class="btn btn-default">@Lang.Submit</button>
                </div>
            </div>
        </div>
    }
</div>

<div id="gridId" class="freegrid" colheight="200" expheight="350" >
</div>

