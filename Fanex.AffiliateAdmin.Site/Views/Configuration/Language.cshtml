@{
    ViewBag.Title = Lang.LanguageList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Utilities
@model Fanex.AffiliateAdmin.Models.LanguageViewModel
@section iconcss{
settings
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Configuration, 3, "configuration")
}
<div class="search-panel search-language">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    @using (Html.BeginForm("GetLanguageList", "Configuration", FormMethod.Post, new { id = "ConfigurationForm", @class = "row-fluid" }))
    {
        <div class="span12 search-form">
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    @Html.LabelFor(m => m.Name, Lang.SearchByName)
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control width-140", placeholder = Lang.All, maxlength = "100" })
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" class="btn btn-default" id="btnSubmit">
                        @Lang.Submit 
                    </button>
                </div>
            </div>
        </div>
    }
</div>
<div id="gridId" class="freegrid content-grid" colheight="200" expheight="290">
</div>
@section scripts{
    <script type="text/javascript">
        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            titleInfo:
            {
                text: "@Lang.LanguageList",
                showButtonsWhenNoData: true,
                customButtons: '<input type="button" name="btnAdd" value="" title="@Lang.AddNewLanguage" class="btnAdd icon-add-config" id="btnAddgridId">'
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Name", Width: 200, Name: "LanguageName", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Country", Width: 250, Name: "CountryName", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.Creator", Width: 100, Name: "CreatorName", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "@Lang.CreatedDate", Width: 150, Name: "CreatedDate", HeaderAlign: "center", CellAlign: "center", FormatDateTime: AFFILIATE.DATE_FORMAT_FULL },
                {
                    HeaderText: "@Lang.Action",
                    Width: 70,
                    Name: "Update",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a title='{0}' href='javascript:Language.showLanguageDlg(\"".format(MSG.Edit) + record.LanguageID + "\");'><i class='icon-edit'></i></a>"
                            + "&nbsp;&nbsp;<a title='{1}' href='javascript:Language.deleteLanguage(\"".format(MSG.Remove) + record.LanguageID + "\");'><i class='icon-remove'></i></a>";
                    }
                }
            ],
            customPager: true,
            gridExpandHeight: 290,
            allowTruncate: false,
            indexNumberColumn: 0
        };

        var MSG =
        {
            AddNewLanguage: '@Lang.AddNewLanguage',
            InvalidLanguage: '@Lang.InvalidLanguage',
            DeleteLanguageMsg: '@Lang.DeleteLanguageMsg',
            UpdateLanguage: '@Lang.UpdateLanguage',
            NoInfo: '@Lang.NoInfo',
            Remove: '@Lang.Remove',
            Edit: '@Lang.Edit',
            Title: "@Lang.LanguageList"
        };
    </script>
    <script src="~/Scripts/site/Language.js" type="text/javascript"></script>
}
