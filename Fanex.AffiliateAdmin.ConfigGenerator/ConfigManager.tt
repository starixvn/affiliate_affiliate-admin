<#@ template debug="true" hostspecific="true" language="C#" #>
<#@ output extension=".txt" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ assembly name="System.Data" #>
<#@ assembly name="System.Core" #>

<#@ import namespace="Fanex.AffiliateAdmin.ConfigGenerator.ConfigModelReaders" #>
<#@ include file="$(SolutionDir)\packages\T4.TemplateFileManager.2.1.2\tools\ttinc\TemplateFilemanager.CS.ttinclude" #>
<# 
	var fileManager = TemplateFileManager.Create(this);
	fileManager.IsAutoIndentEnabled = true;
	fileManager.CanOverwriteExistingFile = true;

	// init handling for parameter templates
	var paramTmpl = ParamTextTemplate.Create(this.Host);
	var session = ParamTextTemplate.GetSessionObject();

	var manager = new SiteManager
        {
            XmlFile = Host.ResolvePath(@"ConfigModels\SiteConfigModels\SiteConfigModel.xml")
        };

    manager.LoadXml();

    var globalWebConfigModel = manager.GetGlobalWebConfigModel();
    var environments = manager.GetSupportedEnvironmentList();
    var sites = manager.GetSupportedSiteList();
	var demoSite = manager.GetDemoSite();

	var webProject = @"Fanex.AffiliateAdmin.Site";
	var appDataFolder = @"App_Data";

	foreach(var site in sites)
	{
		if(site.Status)
		{
			site.WebConfigModel = string.IsNullOrEmpty(site.WebConfigModel) ? globalWebConfigModel : site.WebConfigModel;	
			
			foreach(var environment in environments.Keys)
			{
				if(environments[environment])
				{
					site.Environment = environment;
					session["Site"] = site;

					var webconfigName = string.Format("Web.{0}.{1}.config", site.Name.ToLower(), site.Environment.ToLower());
					var appSettingName = string.Format("Web.AppSettings.{0}.{1}.config", site.Name.ToLower(), site.Environment.ToLower());
					var connectionStringName = string.Format("Web.ConnectionString.{0}.{1}.config", site.Name.ToLower(), site.Environment.ToLower());
					var spName = string.Format("SpName.{0}.{1}.xml", site.Name.ToLower(), site.Environment.ToLower());
					
					// for web config
					fileManager.StartNewFile(webconfigName, webProject);
					var webConfigOutput = paramTmpl.TransformText("Web.Config.tt", session);
					this.Write(webConfigOutput);

					// for app settings
					fileManager.StartNewFile(appSettingName, webProject);
					var webAppSettingsOutput = paramTmpl.TransformText("Web.AppSettings.tt", session);
					this.Write(webAppSettingsOutput);

					// for connection strings
					fileManager.StartNewFile(connectionStringName, webProject);
					var connectionStringOutput = paramTmpl.TransformText("Web.ConnectionString.tt", session);
					this.Write(connectionStringOutput);

					// for spname
					fileManager.StartNewFile(spName, webProject, appDataFolder);
					var spNameOutput = paramTmpl.TransformText("SpName.tt", session);
					this.Write(spNameOutput);
                    
					if(site.Name.Equals(demoSite, StringComparison.OrdinalIgnoreCase))
                    {
						webconfigName = "Web.config";
						appSettingName = "Web.AppSettings.config";
						connectionStringName = "Web.ConnectionString.config";
						spName = "SpName.xml";
					
						// for web config
						fileManager.StartNewFile(webconfigName, webProject);
						var webConfigOutput2 = paramTmpl.TransformText("Web.Config.tt", session);
						this.Write(webConfigOutput2);

						// for app settings
						fileManager.StartNewFile(appSettingName, webProject);
						var webAppSettingsOutput2 = paramTmpl.TransformText("Web.AppSettings.tt", session);
						this.Write(webAppSettingsOutput2);

						// for connection strings
						fileManager.StartNewFile(connectionStringName, webProject);
						var connectionStringOutput2 = paramTmpl.TransformText("Web.ConnectionString.tt", session);
						this.Write(connectionStringOutput2);

						// for spname
						fileManager.StartNewFile(spName, webProject, appDataFolder);
						var spNameOutput2 = paramTmpl.TransformText("SpName.tt", session);
						this.Write(spNameOutput2);
					}
				}
			}
		}
	}

	fileManager.Process();
#>





