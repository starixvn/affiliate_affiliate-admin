@{
    ViewBag.Title = Lang.EmailHistory;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.DTO
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@model Fanex.AffiliateAdmin.Models.EmailHistoryViewModel
@section iconcss{
home
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Affiliate, 3, "affiliate")
}
@{
    object datepickerAttr = null;

    if (Model.IsAll)
    {
        datepickerAttr = new { @class = "datepicker", disabled = "disabled" };
    }
    else
    {
        datepickerAttr = new { @class = "datepicker" };
    }
}
<div class="search-panel search-emailHistory">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", "Information text", false, false)
    <form class="row-fluid" id="SearchForm">
    <div class="span12 search-form">
        <div class="row-fluid row-form end-search">
            <div class="cell">
                <label for="SearchOption" class="txt">@Lang.SearchBy</label>
                <select id="SearchOption" name="SearchOption" class="width-140 single-select dropdownchecklist">
                    <option value="-1">All</option>
                    <option value="0">Sender</option>
                    <option value="1">Email Address</option>
                    <option value="2">Affiliate</option>
                    <option value="-2">Unknown Affiliate</option>
                </select>
                @Html.TextBoxFor(m => m.SearchText, Model.SearchText, 
                    new { @class = "form-control width-140", Style = "display:" + (Model.SearchOption >= 0 ? "inline" : "none") })                                
            </div>

            <div class="cell checkbox">       
                @Html.CheckBoxFor(m => m.IsAll)
                @Html.LabelFor(m => m.FromDate, Lang.From)
                @Html.DatePicker("FromDate", new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1), AppSettings.SystemStartDate, DateTime.Now, true)
                &nbsp;&nbsp;
                @Html.LabelFor(m => m.ToDate, Lang.To)
                @Html.DatePicker("ToDate", DateTime.Now, AppSettings.SystemStartDate, DateTime.Now, true)
            </div>
        </div>
        <div class="row-fluid row-form btn-action">
            <div class="span12">
                <button type="button" id="btnSubmit" class="btn btn-default" style="vertical-align: top">@Lang.Submit</button>
            </div>
        </div>
    </div>
    </form>
</div>

<div id="gridId" class="freegrid" colheight="200" expheight="290">
</div>
@section scripts{
    <script>
        var MSG = {
            NoEmailSelected: "@Lang.NoEmailSelected",
            ConfirmDeleteEmail: "@Lang.ConfirmDeleteEmail",
            NoInfo: "@Lang.NoInfo"
        };
        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.EmailHistory"                
            },
            columns: [                        
                        { HeaderText: "#", Width: 30, Name: "b", HeaderAlign: "center", CellAlign: "center" },
                        { HeaderText: "@Lang.Sender", Width: 182, Name: "Sender", HeaderAlign: "center" },
                        { HeaderText: "@Lang.Affiliate", Width: 70, Name: "Affname", HeaderAlign: "center" },
                        { HeaderText: "@Lang.Subject", Width: 150, Name: "Subject", HeaderAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated)
                            { return "<a href='#' data-mid='" + rowData.Mid + "' class='subject'>" + cellFormated + "</a>"; }
                        },
                        { HeaderText: "@Lang.Email", Width: 200, Name: "Email", HeaderAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated)
                            { return "<a href='mailto:" + cellFormated + "'>" + cellFormated + "</a>"; }
                        },
                        { HeaderText: "@Lang.SentDate", Width: 100, Name: "CreateDate", HeaderAlign: "center", FormatDateTime: AFFILIATE.DATE_FORMAT },
                        { HeaderText: "@Lang.Remove", Width: 50, Name: "Remove", CellAlign: "center",
                            Formatter: function (rowIndex, rowData, cell, cellFormated) {
                                return "<a href=\"javascript:EmailHistory.deleteEmail(" + rowData.Mid + ")\"><i class=\"icon-remove\"></i></a>";
                            }
                        }
                   ],
            showPager: true,
            customPager: true,
            allowTruncate: false,
            gridExpandHeight: 360,
            showNumberColumn: true,
            indexNumberColumn: 0
        }
    </script>
    <script src="@Url.Content("~/Scripts/site/EmailHistory.js")" type="text/javascript"></script>
}
