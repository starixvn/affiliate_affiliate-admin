    <sessionState mode="StateServer" timeout="40" stateConnectionString="tcpip=10.2.180.14:42424" cookieless="false" />
    <machineKey validationKey="44F20A5378DEA27ACE5881B2CE1CED6790FF1873C2798E4050C9EEF353E4D3275AE0CE0D58AD8447F84711892DA90D1E82B71A6ED7749F20B24C6C1D24ADC756" decryptionKey="9FC60F0A32DEC79FEE5B0975CEDE69D2C8825F14EC8821AA1164F8639DBAEF28" validation="SHA1" decryption="AES" />
    <httpHandlers>
