<?xml version="1.0"?>
<appSettings>
  <add key="Layout" value="livebet365"/>
  <add key="PageSize" value="10"/>
  <add key="DefaultLanguage" value="en-US"/>  
  <add key="AffiliateName" value="LiveBet365"/>   
  <add key="Environment" value="UAT"/>
  <add key="TransferDay" value="8"/>
