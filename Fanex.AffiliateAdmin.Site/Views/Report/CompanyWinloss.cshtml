@{
    ViewBag.Title = "CompanyWinloss";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section iconcss{
report
}
@section submenu{
    @RazorHelper.ListSubmenu(Fanex.AffiliateAdmin.Core.Utilities.SubMenu.Reports, 0, "report")
}
@{
    var now = DateTime.Now;
}

@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Mvc
@model Fanex.AffiliateAdmin.Models.CompanyWinlossViewModel

<div class="search-panel search-company-winloss">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", "Information text", false, false)
    @using (Html.BeginForm("CompanyWinloss", "Report", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {            
        <div class="span12 search-form">
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="AffName" class="txt">@Lang.Affiliate</label>
                    <input type="text" class="form-control width-140" id="AffName" name="AffName" placeholder="@Lang.Affiliate" maxlength="100"/>
                </div>
                <div class="cell">
                    <label for="AffTypes" class="txt">@Lang.AffType</label>
                    @Html.DropDownCheckList("AffTypes", Model.AffTypeOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="CommGroups" class="txt auto">@Lang.CommissionGroup</label>
                    @Html.DropDownCheckList("CommGroups", Model.CommissionGroupOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="PreferLanguages" class="txt auto">@Lang.Language</label>
                    @Html.DropDownCheckList("PreferLanguages", Model.PreferLanguageOptionList, true, true, new { @class = "width-140" })
                </div>
            </div>
            <div class="row-fluid row-form">
                <div class="cell">
                    <label for="PlayerCurrencies" class="txt">@Lang.Currency</label>
                    @Html.DropDownCheckList("PlayerCurrencies", Model.PlayerCurrencyOptionList, true, true, new { @class = "width-140" })
                </div>
                <div class="cell">
                    <label for="DateOption" class="txt">@Lang.GroupBy</label>
                    @Html.DropDownCheckList("GroupBy", Model.GroupByOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="FromDate" class="txt width-90">@Lang.From</label>
                    @Html.DatePicker("FromDate", new DateTime(now.Year, now.Month, 1), AppSettings.SystemStartDate, now, false, new { isdefault = "false" })</div>
                <div class="cell">
                    <label for="ToDate" class="txt auto text-left">@Lang.To</label>
                    @Html.DatePicker("ToDate", now, AppSettings.SystemStartDate, now, false, new { isdefault = "false" })
                </div>
            </div>
            <div class="row-fluid row-form end-search">
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.DrawFilter</label>
                    @Html.DropDownCheckList("DrawFilter", Model.DrawFilterOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell">
                    <label for="BaseCurrency" class="txt">@Lang.BaseCurrency</label>
                    @Html.DropDownCheckList("BaseCurrency", Model.BaseCurrencyOptionList, false, false, new { @class = "width-140 dropdownchecklist single-select" })
                </div>
                <div class="cell checkbox">
                    <label for="ExcludeTest">
                        @Html.CheckBoxFor(m => m.ExcludeTest)
                        @Lang.ExcludeTestAccounts
                    </label>
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button id="btnSubmit" type="submit" class="btn btn-default">@Lang.Submit</button>
                </div>
            </div>
        </div>
    }
</div>

<div id="gridId" class="freegrid" colheight="200" expheight="350" >
</div>

@section scripts{
    <script type="text/javascript">
        var MSG = {
            Date: "@Lang.Date",
            Month: "@Lang.Month",
            UnitPerBaseCurrency: "@Lang.UnitPerBaseCurrency",
            Deposit: "@Lang.Deposit",
            Withdrawal: "@Lang.Withdrawal",
            Bonus: "@Lang.Bonus",
            Adjustment: "@Lang.Adjustment",
            PSP: "@Lang.PSP",
            Turnover: "@Lang.Turnover",
            CustomerWL: "@Lang.CustomerWL",
            CompanyWL: "@Lang.CompanyWL",
            SubTotalIn: "@Lang.SubTotalIn",
            Total: "@Lang.Total",
            TotalRangeIn: "@Lang.TotalRangeIn",
            TotalAllIn: "@Lang.TotalAllIn",
            TotalAll: "@Lang.TotalAll",
            Sportsbook: "@Lang.Sportsbook",
            NumberGame: "@Lang.NumberGame",
            LiveCasino: "@Lang.LiveCasino",
            RNGCasino: "@Lang.RNGCasino",     
            RangeTime3Months: "@Lang.RangeTime3Months",
        };

        var sampleGridOption = {
            showTitle: true,
            titleInfo:
            {
                text: "@Lang.CompanyWinloss",
            },
            groupHeaderRows: [
                {
                    Columns: [
                        { HeaderText: "@Lang.Date", Name: "WinlostDate", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Currency", Name: "Currency", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.UnitPerBaseCurrency", Name: "ExRate", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Deposit", Name: "Deposit", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Withdrawal", Name: "Withdrawal", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Bonus", Name: "Bonus", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Adjustment", Name: "Adjustment", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.PSP", Name: "PSP", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.Turnover", Name: "SportsBookTurnover", MergeColNumber: 5 },
                        { HeaderText: "@Lang.BetCount", Name: "BetCount", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.ActiveMembers", Name: "ActivePlayer", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.CustomerWL", Name: "Winlost", MergeRowNumber: 2 },
                        { HeaderText: "@Lang.CompanyWL", Name: "SportsBookWinlost", MergeColNumber: 5 }
                    ]
                }
            ],
            columns: [                                                
                { HeaderText: "@Lang.Date", Width: 80, Name: "WinlostDate", HeaderAlign: "center", CellAlign: "center", FormatDateTime: AFFILIATE.DATE_FORMAT },
                { HeaderText: "@Lang.Currency", Width: 80, Name: "Currency", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.UnitPerBaseCurrency", Width: 80, Name: "ExRate", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.Deposit", Width: 90, Name: "Deposit", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.Withdrawal", Width: 90, Name: "Withdrawal", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.Bonus", Width: 90, Name: "Bonus", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.Adjustment", Width: 90, Name: "Adjustment", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.PSP", Width: 50, Name: "PSP", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
                { HeaderText: "@Lang.Turnover", Width: 110, Name: "Turnover", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },                
                { HeaderText: "@Lang.BetCount", Width: 110, Name: "BetCount", HeaderAlign: "center", CellAlign: "right" },                
                { HeaderText: "@Lang.ActiveMembers", Width: 110, Name: "ActivePlayer", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "@Lang.CustomerWL", Width: 110, Name: "Winlost", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },                
                { HeaderText: "@Lang.CompanyWL", Width: 110, Name: "Total", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' },
            ],            
            allowTruncate: true,
            gridExpandHeight: 350,
            showFooter: true,
            customizeHeader: true,
            showDistinctRow: false,
            numberOfFrozenColumn: 3
        };

        var sampleCol = { HeaderText: "@Lang.Sportsbook", Width: 110, Name: "SportsBookTurnover", HeaderAlign: "center", CellAlign: "right", FormatNumber: AFFILIATE.FORMATNUMBER, FormatNegative: '($)' };
        var turnoverPosition = 8;
    </script>
    <script src="@Url.Content("~/Scripts/site/CompanyWLHelper.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/site/CompanyWinlossReport.js")" type="text/javascript"></script>
}

