@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Core.Configurations

@model Fanex.AffiliateAdmin.Models.AffiliateInfoViewModel

<div class="left-group">
    <div class="left-tab"><a href="#"><span>@Lang.CurrOnlineList</span></a></div>
    <div class="left-tab-info" style="width: 215px;">
        <table> 
            <colgroup>
                <col width="10"/>
                <col width="70"/>
                <col width="*"/>
            </colgroup>
            <thead> 
                <tr>
                    <td class="text-c">#</td>
                    <td class="text-c">@Lang.IP</td>
                    <td class="text-c">@Lang.LastCheckIn</td>
                </tr>
            <thead>
            <tbody>
               
                @{
                    if (Model.OnUsers.Any())
                    {
                        int counter = 0;
                        foreach (var onUser in Model.OnUsers)
                        {
                            counter++;
                        
                            <tr>
                                <td class="text-c">@counter</td>
                                <td class="text-c"><a target="_blank" href="@string.Format(AppSettings.IPCheckerUrl.ToString(), onUser.Ip)">@onUser.Ip</a></td>
                                <td class="text-c">@string.Format(FormatType.FULL_DATETIME_SPLASH_FORMAT.GetStringValue(), onUser.Reload_Time)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-c">@Lang.ErrUserOnline</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>