@using Fanex.AffiliateAdmin.Core.Configurations
@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.AdminSiteUrl/Content/_Sites/@AppSettings.Layout/images/emailBg.jpg">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.AdminSiteUrl/Content/_Sites/@AppSettings.Layout/images/emailBanner.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.HeaderBgColor" height="30">
                        &nbsp;&nbsp;<strong><font style="color: @Model.HeaderFontColor; font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">เรื่อง ผลการสมัครเป็นพันธมิตร</font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.ContentBgColor">
                        <table width="100%" border="0">
                            <tr>
                                <td style="background-color:@Model.ContentBgColor !important; padding: 20px 15px;">
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>เรียน @Model.FirstName,</strong><br />
                                        <br />
                                        ขอแสดงความยินดีที่ท่านได้เป็นพันธมิตรกับ @(Model.SystemName)  กรุณาอ่านขั้นตอนในการขอถอนเงินด้านล่างนี้<br /><br />

                                        1. กรุณาสมัครเปิดบัญชีผู้เล่นใหม่กับ@(Model.SystemName)<br /><br />
                                        2. ส่งอีเมลล์มาแจ้งที่ <a href="mailto:@Model.MailContact">@Model.MailContact</a> ระบุยูสเซอร์เนมบัญชี @(Model.SystemName) และ ยูสเซอร์การเป็นพัธมิตรของท่าน <br /><br />
                                        3. หลังจากส่งอีเมลล์มาแจ้งเราเกี่ยวกับบัญชี @(Model.SystemName) แล้ว กรุณาล๊อคอินเข้าที่บัญชีพันธมิตรของคุณแล้วคลิ๊กไปที่ปุ่ม MY Account ที่รายละเอียดเกี่ยวกับกับการจ่ายเงิน กรุณาเปลี่ยนวิธีการขอจ่ายเงินเป็นให้ส่งไปที่บัญชี @(Model.SystemName) จากนั้นกรอกยูสเซอร์เนมของ @(Model.SystemName) และคลิ๊กยืนยัน<br /><br />
                                        4. เราจะทำการจ่ายเงินค่าคอมมิชชั่นให้สมาชิกเดือนละครั้ง  กรุณาล๊อคอินเข้าไปที่บัญชีพันธมิตรและคลิ๊กไปที่การขอถอนเงิน จากนั้นกรอกจำนวนเงินที่คุณต้องการจะถอน<br /><br />
                                        5. ถ้าการขอถอนเงินของคุณได้รับการอนุมัติ  ระบบจะโอนเงินเข้าไปยังบัญชี @(Model.SystemName) ของคุณโดยอัตโนมัติ<br /><br />
                                        6. คุณสามารถถอนเงินออกจากบัญชี @(Model.SystemName) ได้ตลอดเวลาและจะไม่เสียค่าธรรมเนียมใดใดเพิ่มเติม<br /><br />
                                        ข้อควรระวัง :<br /><br />
                                        1. บัญชี @(Model.SystemName)  ของคุณใช้เพื่อวัตถุประสงค์ในการรับคอมมิชชั่นจากโปรแกรมพันธมิตรเท่านั้น  กรุณาอย่าทำการฝากเงินหรือวางเดิมพันเป็นอันขาด<br /><br />
                                        2. ชื่อที่ใช้ในการสมัครบัญชี @(Model.SystemName)  จะต้องเป็นชื่อเดียวกับที่ใช้สมัครเป็นสมาชิกพันธมิตรเท่านั้นและต้องเป็นชื่อจริง<br /><br />
                                        3. ขั้นตอนที่กล่าวมาข้างบนใช้สำหรับการขอถอนเงินครั้งแรกเท่านั้น หากเป็นการขอถอนเงินครั้งที่ 2หรือ3 กรุณาใช้ข้อมูลในข้อ 4 ข้อ 5 และ ข้อ 6ในการปฎิบัติ<br /><br />

                                        กรุณาอย่างลังเลที่จะติดต่อเรา หากคุณมีคำถามเพิ่มเติม<br /><br />

                                        ขอแสดงความนับถือ<br /><br />
                                        ทีมงานพันธมิตร @Model.SystemName<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="@Model.CopyrightBgColor" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: @Model.CopyrightFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © ลิขสิทธิ์ @Model.CopyrightYear <a href="@Model.MemberSiteUrl">@Model.MemberSiteDomain</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="@Model.FooterBgColor" height="40">
                        <font style="font-size: 12px; color: @Model.FooterFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            อีเมลล์นี้เป็นการอีเมลล์ที่ถูกส่งโดยระบบ  กรุณาอย่าตอบกลับอีเมลล์นี้โดยตรง
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>