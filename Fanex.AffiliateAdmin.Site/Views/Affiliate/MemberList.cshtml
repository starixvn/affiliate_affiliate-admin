@{
    ViewBag.Title = Lang.MemberList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.DTO
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Services
@section iconcss{
customer
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Affiliate, 2, "AffManagement")
}
@{
    var now = SystemTimeService.GetSystemDateTime();
}
<div class="search-panel">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel(".search-form", "Information text", false, false)
    <form class="row-fluid">    
    <div class="span12 search-form">
        <div class="row-fluid row-form">
            <div class="cell">
                <label for="username" class="txt">@Lang.Member</label>
                <input type="text" placeholder="@Lang.All" id="username" name="username" value="@ViewBag.MemberName" maxlength="100" class="form-control width-140" />                
            </div>
            <div class="cell">
                <label for="affUsername" class="txt">@Lang.Affiliate</label>
                <input type="text" placeholder="@Lang.All" id="affUsername" name="affUsername" value="@ViewBag.AffName" maxlength="100" class="form-control width-140" />                
            </div>
            <div class="cell">
                <label for="AffType" class="txt">@Lang.AffType</label>
                @Html.DropDownCheckList("AffType", new SelectList(AppSettings.AffTypes, "TypeID", "Name"), true, true, new { @class = "width-140" })
            </div>
            <div class="cell">
                <label for="CurrencyList" class="txt">@Lang.Currency</label>
                @Html.DropDownCheckList("CurrencyList", new SelectList(AppSettings.PlayerCurrencies, "CurrencyID", "CurrencyCode"), true, true, new { @class = "width-140" })
            </div>
        </div>
        <div class="row-fluid row-form">
            <div class="cell">
                <label for="MemberType" class="txt">@Lang.MemberType</label>
                <select id="MemberType" name="MemberType" class="width-140 single-select dropdownchecklist">
                    <option value="0">@Lang.All</option>
                    <option value="1">@Lang.Deposit</option>
                    <option value="2">@Lang.NonDeposit</option>
                </select>
            </div>
            <div class="cell">
                <label for="DateOption" class="txt">@Lang.DateOption</label>
                <select id="DateOption" name="DateOption" class="width-140 single-select dropdownchecklist">
                    <option value="0">@Lang.All</option>
                    <option value="1">@Lang.RegisteredDate</option>
                    <option value="2">@Lang.FirstDepositDate</option>
                </select>
            </div>
             <div class="cell">
                <label for="FromDate" class="txt">@Lang.From</label>
                @Html.DatePicker("FromDate", new DateTime(now.Year, now.Month, 1), AppSettings.SystemStartDate, now,true)
            </div>
            <div class="cell">
                <label for="ToDate" class="txt">@Lang.To</label>
                @Html.DatePicker("ToDate", now, AppSettings.SystemStartDate, now, true)
            </div>
        </div>
        <div class="row-fluid row-form end-search">
        <div class="cell">
                <label for="SortBy" class="txt">@Lang.SortBy</label>
                <select id="SortBy" name="SortBy" class="width-140 single-select dropdownchecklist" >
                    <option value="0">@Lang.Username</option>
                    <option value="1" selected>@Lang.RegisteredDate</option>
                    <option value="2">@Lang.FirstDepositDate</option>
                </select>
            </div>
            <div class="cell checkbox">
                 <label for="ExcludeTest">
                     <input type="checkbox" id="ExcludeTest" name="ExcludeTest" value="True" checked="checked"/>
                    @Lang.ExcludeTestAccounts
                </label>
            </div>
        </div>
        <div class="row-fluid row-form btn-action">
            <div class="span12">
                <button type="submit" class="btn" id="btnSubmit">
                    @Lang.Submit
                </button>
            </div>
        </div>
    </div>
    </form>
</div>
<br />
<div id="gridId" class="freegrid">
</div>

<div class="content legend">
    <div class="row-fluid">
        <ul class="unstyled inline status pull-right">
            <li><span class="removed"></span>@Lang.Removed</li>
        </ul>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        var MSG = {
            ConfirmRemoveMem: "@Lang.ConfirmRemoveMem",
            AssignMemToAff: "@Lang.AssignMemToAff"
        };
        
        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.MemberList",
                showButtonsWhenNoData: true,
                customButtons: "<input type='button' name='btnAdd' value='' title='@Lang.AssignMemToAff' class='btnAdd icon-add-config' id='btnAssign'>"
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", CellAlign: "center" },
                { HeaderText: "@Lang.Username", Width: 70, Name: "UserName", canResize: true },
                { HeaderText: "@Lang.FirstName", Width: 100, Name: "FirstName" },
                { HeaderText: "@Lang.LastName", Width: 100, Name: "LastName" },
                {
                    HeaderText: "@Lang.EmailAddress",
                    Width: 110,
                    Name: "Email",
                    canResize: true,
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return cellFormated ? "<a href='mailto:" + cellFormated + "'>" + cellFormated + "</a>" : "";
                    }
                },
                { HeaderText: "@Lang.Phone", Width: 100, Name: "Phone" },
                { HeaderText: "@Lang.Address", Width: 100, Name: "Address" },
                { HeaderText: "@Lang.Country", Width: 80, Name: "Country" },
                { HeaderText: "@Lang.RegisteredDate", Width: 100, Name: "RegisteredDateStr", CellAlign: "center" },
                { HeaderText: "@Lang.FirstDepositDate", Width: 100, Name: "CreatedDateStr", CellAlign: "center" },
                { HeaderText: "@Lang.EffectiveDate", Width: 100, Name: "AffAffectedDateStr", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Affiliate",
                    Width: 70,
                    Name: "AffUserName",
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        return "<a href=\"" + AFFILIATE.getAbsoluteUrl() + "AffiliateInfo?username=" + cellFormated + "\">" + cellFormated + "</a>";
                    }
                },
                { HeaderText: "@Lang.Currency", Width: 60, Name: "Currency", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Remove",
                    Width: 70,
                    Name: "Remove",
                    CellAlign: "center",
                    Formatter: function (rowIndex, rowData, cell, cellFormated) {
                        if (rowData.IsRemoved) {
                            return rowData.RemovedDateStr;
                        }

                        return "<a href=\"javascript:CUSTOMER.Remove('" + rowData.UserName + "')\"><i class=\"icon-remove\"></i></a>";
                    }
                }
            ],
            showPager: true,
            customPager: true,
            gridExpandHeight: 360,
            showNumberColumn: true,
            allowTruncate: true,
            autoResizeColumn: true,
            rowCssClass: function (rowIndex, rowData) {
                return rowData.IsRemoved ? "removed" : "approved";
            }
        };
        $(function () {
            CUSTOMER.init();
        });
    </script>
    @Scripts.Render("~/scripts/customer")
}
