@{
    ViewBag.Title = Lang.AffiliateInfo;
    Layout = "~/Views/Shared/_LayoutNoSubMenu.cshtml";
}

@model Fanex.AffiliateAdmin.Models.AffiliateMasterViewModel

<div class="panel">
    <div id="l-panel" class="l-panel">
        <iframe id="ifAffInfo" scrolling="auto" class="span12 affInfo" src="@(Model.GetUrl("AffiliateInfo", "Info"))" frameborder="0"></iframe>    
    </div>
    @if (!string.IsNullOrEmpty(Model.UserName))
    {
        <div id="c-panel" class="c-panel">
            <div class="span12 t-panel">
                <iframe id="ifStatistic" src="javascript:false;" scrolling="no" class="span12 statistic-exp" frameborder="0"></iframe>
            </div>
            <div class="span12 b-panel">
                <iframe id="ifReport" src="javascript:false;" class="span12 report" scrolling="auto" style="overflow-x: hidden;" frameborder="0"></iframe>    
            </div>
        </div>
    }
</div>


@section scripts{
    @Scripts.Render("~/scripts/affiliatemaster")
    
    <script type="text/javascript">
        var domain = "@Model.SiteDomainUrl";
        $(document).ready(function() {
            window.Mgmt = {
                ifStatistic: $('iframe#ifStatistic'),
                ifReport: $('iframe#ifReport')
            };
        });
    </script>
}