<#@ template  language="C#" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ assembly name="System.Data" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="$(SolutionDir)\ConfigGenerator.Core\bin\Debug\ConfigGenerator.Core.dll" #>
<#@ import namespace="ConfigGenerator.Core" #>
<#
if(Session["environment"] != null && Session["model"] != null)
{
	var reader = new WebConfigModelReader 
				{
					Environment = Session["environment"].ToString(),
					XmlFile = Session["model"].ToString()
				};

	reader.LoadXml();

	var dbDict = reader.GetSettingsOfNode("connectionstrings");
#>
<?xml version="1.0" encoding="utf-8" ?>
<Functions>
  <Function Name="Aff-Banner">
    <Setting Key="Aff_Banner_UpdateStatistic" SpName="Aff_Banner_UpdateStatistic" DbName="<#= dbDict.GetValue("affilatedb-name") #>" Plain="0" />
    <Setting Key="Aff_Banner_SelInfo" SpName="Aff_Banner_SelInfo" DbName="<#= dbDict.GetValue("affilatedb-name") #>" Plain="0" />
    <Setting Key="Aff_Banner_GetSystemName" SpName="Aff_Banner_GetSystemName" DbName="<#= dbDict.GetValue("affilatedb-name") #>" Plain="0" />
  </Function>
</Functions>
<#
}
#>