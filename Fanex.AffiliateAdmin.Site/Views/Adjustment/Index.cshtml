@{
    ViewBag.Title = Lang.Adjustment;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}

@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Models

@section iconcss{
    affiliate-info
}

@model Fanex.AffiliateAdmin.Models.AdjustmentViewModel

@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 3)
    <div class="line line-statement">
    </div>
}
@if (ViewBag.Result != null)
{
    var result = (ResultViewModel)ViewBag.Result;
    <input type="hidden" id="ResultCode" value="@result.ErrorCode" data-message="@result.Message" />
}
<form method="post" action='@Url.Content("~/Adjustment")' class = "iframe-content">
      @Html.ValidationSummary()  <div class="row-fluid">
        <div class="span12">
            <fieldset>
                <legend>@Model.AffName</legend>
                <div class="clearfix"></div>
                    <table>
                        <colgroup>
                            <col style="width: 160px;" />
                            <col />
                        </colgroup>
                        <tr>
                            <td><label class="control-label">@Lang.BalanceForward</label></td>
                            <td>@MvcHtmlString.Create(FormaterCurrency.Format(Model.Adjustment.BalBroughtForward, Model.CurrencyCode))</td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(m => m.Amount, Lang.Adjustment, new { @class = "control-label" }) </td>
                            <td>@Html.TextBox("Amount", string.Empty, new { @class = "control-text text-r" })</td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(m => m.Description, Lang.Description, new { @class = "control-label" }) </td>
                            <td>
                                <table>
                                    <tr>
                                        <td>@Html.LabelFor(m => m.Description, Lang.VisibleOnlyToAdmin, new { @class = "control-label", style = "margin-bottom: -5px;" })</td>
                                        <td>@Html.LabelFor(m => m.AffDescription, Lang.VisibleAlsoToAffiliate, new { @class = "control-label", style = "margin-bottom: -5px;" })</td>
                                    </tr>
                                    <tr>
                                        <td>@Html.TextAreaFor(m => m.Description, new { @class = "xsmall-textarea" })</td>
                                        <td>@Html.TextAreaFor(m => m.AffDescription, new { @class = "xsmall-textarea" })</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="required">
                                @string.Format(Lang.AdjustAmountUpTo, FormaterCurrency.Format(Model.Adjustment.MaxAmount, Model.CurrencyCode))
                                @RazorHelper.GetCurrencyNotification(Model.CurrencyCode)
                            </td>
                        </tr>
                    </table>
                    @Html.HiddenFor(m => m.Adjustment.MaxAmount, new { id = "MaxAmount" })
                    @Html.HiddenFor(m => m.Adjustment.BalBroughtForward, new { id = "BalanceForward" })
                    @Html.Hidden("InvalidAmount", ErrorMsg.Msg1011, new { id = "InvalidAmount" })
            </fieldset>
        </div>
    </div>

    <div class="row-fluid row-form btn-action">
        <div class="span12">
            <button type="submit" class="btn" id="btnSubmit">@Lang.Submit</button>
        </div>
    </div>
</form>
@section scripts{
    @Scripts.Render("~/scripts/adjustment")
}