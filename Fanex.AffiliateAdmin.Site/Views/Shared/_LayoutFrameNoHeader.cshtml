@using Fanex.AffiliateAdmin.Core.Configurations
@{
    var currentSession = Fanex.AffiliateAdmin.Core.Session.SessionManager.CurrentSession;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Title here.</title>
    <meta charset="utf-8" />
    @Styles.Render("~/bundles/css")
    @RenderSection("css", required: false)
    @Scripts.Render("~/bundles/jquery")
</head>
<body>
    <!--content html-->
    @RenderBody()
    @Scripts.Render("~/bundles/js")
    @RenderSection("scripts", required: false)
    <script type="text/javascript">
        var Lang = {
            ChangePassword: "@Lang.ChangePassword"
        };

        $(document).ready(function () {
            AFFILIATE.getAbsoluteUrl = function (relativeUrl) {
                return '@Url.Content("~/")' + relativeUrl;
            };

            AFFILIATE.TimeZone = '@Fanex.AffiliateAdmin.Core.Configurations.AppSettings.ServerTimeZone';
        });
    </script>
    @if (AppSettings.Environment.Equals("Production", StringComparison.OrdinalIgnoreCase))
    {
        <script type="text/ecmascript">
            var piwikSiteId = '@AppSettings.PiwikSiteId';

            var _paq = _paq || [];
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function () {
                var u = "https://pw.detecas.com/";
                _paq.push(['setTrackerUrl', u + 'piwik.php']);
                _paq.push(['setSiteId', piwikSiteId]);
                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
            })();           
        </script>    
        <noscript>
            <p>
                <img src="https://pw.detecas.com/piwik.php?idsite=@(AppSettings.PiwikSiteId)'  style="border:0;" alt="" /></p>
        </noscript>
    }
</body>
</html>
