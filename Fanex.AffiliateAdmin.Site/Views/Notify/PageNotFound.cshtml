@{
    ViewBag.Title = Lang.PageNotFound;
    Layout = "~/Views/Shared/_LayoutNoHeader.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Configurations
@section css{
    @Styles.Render("~/bundles/notify")
    <link href='http://fonts.googleapis.com/css?family=Oswald' rel='stylesheet' type='text/css'>
}
<div class="header">
    <a href="@Url.Content("~/Home")" class="no-underline">
        <div class="logo">404: @Lang.PageNotFound!!</div>
    </a>
    <div class="seperator">
    </div>
</div>
<div class="content">
    <div class="icon notfound">
    </div>
    <div class="text">
        <ul class="notify-content">
            @for (var i = 0; i <= AppSettings.BaseLanguages.Count() - 1; i++)
        {
                var lang = AppSettings.BaseLanguages.ElementAt(i);
            <li class="@(i == (AppSettings.BaseLanguages.Count() - 1) ? "end" : string.Empty)">
            @switch (lang.LanguageID)
            {
                case "en-US":
                    <span>
                        Sorry, the page you were looking for appears to have been moved, deleted or does not exist.
                    </span>
                    break;
                case "id-ID":
                    <span class="end">
                        Mohon maaf. Saat ini sistem tidak tersedia.
                        <br />Silahkan mencoba dilain waktu atau hubungi administrator.
                    </span>
                    break;
                case "th-TH":
                    <span>
                        ขออภัยในความไม่สะดวก หน้าเว็บที่คุณกำลังค้นหาได้ถูกย้าย ลบ หรืออาจไม่มีหน้าดังกล่าว 
                    </span>
                    break;
                case "vi-VN":
                    <span>
                        Xin lỗi, trang bạn đang tìm kiếm đã được di chuyển, bị xóa hoặc không tồn tại. 
                    </span>                                                                                   
                    break;
                case "zh-CN":
                    <span>
                        对不起，您要找的页面已被移动，删除或不存在.  
                    </span>
                    break;
                case "zh-TW":
                    <span>
                        對不起，您要找的頁面已被移動，刪除或不存在. 
                    </span>
                    break;
                 case "ko-KR":
                    <span>
                        죄송합니다, 찾으시는 페이지가 이동, 삭제, 또는 존재하지 않습니다.
                    </span>
                    break;
                 default:
                    <span>
                        Mohon maaf, halaman yang anda cari telah di pindahkan atau telah di hapus.
                    </span>
                    break;
            }
            </li>
        }    
        </ul>
    </div>
</div>

@section scripts{    
    @Scripts.Render("~/bundles/loginJs")
}