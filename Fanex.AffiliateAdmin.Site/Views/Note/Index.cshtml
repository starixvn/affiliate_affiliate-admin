@{
    ViewBag.Title = Lang.NotesList;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}

@using Fanex.AffiliateAdmin.Core.Utilities

@section iconcss{
    affiliate-info
}

@section submenu{
    @if(String.Equals(Convert.ToString(ViewBag.Status), "approved", StringComparison.OrdinalIgnoreCase))
    {
         @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 2)
    }
    else
    {
        @RazorHelper.ListSubmenu(SubMenu.AffiliateNotApprove, 1)
    }
    <div class="line line-statement">
        <div class="ic-open-window" title="@Lang.FullScreen"></div>
        <div class="ic-reload" title="@Lang.RefreshPage"></div>
    </div>
}
<div id="gridId" class="freegrid content-grid"></div>

@section scripts{
    <script type="text/javascript">
        var MSG = {
            NoInfo: "@Lang.NoInfo",
            AddNote: "@Lang.AddNote",
            Title: "@Lang.NotesList"
        };
        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.NotesList",
                showButtonsWhenNoData: true,
                customButtons: '<input type="button" name="btnAdd" value="" title="@Lang.AddNote" class="btnAdd icon-add-note" />'
            },
            columns: [
                { HeaderText: "#", Width: 40, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.Content", Width: 400, Name: "Content", CanResize: true },
                { HeaderText: "@Lang.UpdatedBy", Width: 80, Name: "UpdateName", CanResize: true },
                { HeaderText: "@Lang.LastModify", Width: 100, Name: "UpdatedDate", CellAlign: "center", FormatDateTime: AFFILIATE.DATE_FORMAT_FULL },
                {
                    HeaderText: "@Lang.Action",
                    Width: 50,
                    Name: "Update",
                    CellAlign: "center",
                    Formatter:
                        function(rowIndex, rowData, cell, cellFormated) {
                            return "<a onclick=\"javascript:NOTE.editNote(" + rowData.NoteId + ");\" href=\"javascript:void(0);\"><i class=\"icon-edit\"></i></a>";
                        }
                }
            ],
            gridExpandHeight: 200,
            showNumberColumn: true,
            autoResizeColumn: true
        };
    </script>
    <script src="~/Scripts/site/Note.js" type="text/javascript"></script>
}
