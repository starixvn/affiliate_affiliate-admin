@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Models
@using Fanex.AffiliateAdmin.Core.Services.Impl
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Utilities
@using StackExchange.Profiling
@model BannerListViewModel
@{
    ViewBag.Title = Lang.BannerList;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var profiler = MiniProfiler.Current; // it's ok if this is null
}
@section iconcss{
marketing-tools
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Media, 0, "MarketingTools")
}
<div class="search-panel search-bannerList">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
    @RazorHelper.SearchPanel("#SearchForm .search-form", "Information text", false, false)

    @using (Html.BeginForm("DataList", "MediaBanner", FormMethod.Post, new { id = "SearchForm", @class = "row-fluid" }))
    {
        <div class="span12 search-form">
            <div class="row-fluid row-form">
                <div class="cell">
                    @Html.LabelFor(m => m.Currency, Lang.Category, new { @class = "txt" })
                    @Html.DropDownCheckList("Category", Model.BannerCategoryOptionList, false, false, new { @class = "width-140" })
                </div>
                <div class="cell" style="display: none" id="divSubCategories">
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.Language, new { @class = "txt" })
                    @Html.DropDownCheckList("Language", Model.MemberSiteSupportedLanguageOptionList, false, false, new { @class = "width-140" })
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.Currency, new { @class = "txt" })
                    @Html.DropDownCheckList("Currency", Model.PlayerCurrencyOptionList, false, false, new { @class = "width-140" })
                </div>
            </div>
            <div class="row-fluid row-form  end-search">
                <div class="cell">
                    @Html.LabelFor(m => m.AffType, new { @class = "txt" })
                    @Html.DropDownCheckList("AffType", Model.AffiliateTypeOptionList, false, false, new { @class = "width-140" })
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.ImageType, new { @class = "txt" })
                    @Html.DropDownCheckList("ImageType", Model.BannerTypeOptionList, false, false, new { @class = "width-140" })
                </div>
                <div class="cell">
                    @Html.LabelFor(m => m.Size, new { @class = "txt" })
                    @Html.DropDownCheckList("Size", Model.BannerSizeOptionList, false, false, new { @class = "width-140" })
                </div>
            </div>
            <div class="row-fluid row-form btn-action">
                <div class="span12">
                    <button type="submit" class="btn" id="btnSubmit">
                        @Lang.Submit
                    </button>
                </div>
            </div>
        </div>
    }
</div>
<div id="gridId" class="freegrid">
</div>
@section scripts{
    <script type="text/javascript">
        var BANNER_URL = "@RazorHelper.GetBannerUrl()";
        var MSG = {
            AddBanner: "@Lang.AddBanner",
            EditBanner: "@Lang.EditBanner",
            InvalidBanner: "@Lang.InvalidBanner",
            DeleteBannerMsg: "@Lang.DeleteBannerMsg",
            Remove: "@Lang.Remove",
            Edit: "@Lang.Edit",
            OriginalView: "@Lang.OriginalView",
            Image: "@Lang.Image"
        };

        var thumbnailHeight = @MediaSettings.ThumbnailHeight;
        var thumbnailWidth = @MediaSettings.ThumbnailWidth;

        var gridOption = {
            language: '@AppSession.Language',
            showTitle: true,
            timeZone: AFFILIATE.TimeZone,
            titleInfo:
            {
                text: "@Lang.BannerList",
                showButtonsWhenNoData: true,
                customButtons: '<input type="button" name="btnAdd" value="" title="@Lang.AddBanner" class="btnAdd icon-add-banner">'
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Banner",
                    Width: thumbnailWidth,
                    Name: "Image",
                    HeaderAlign: "center",
                    CellAlign: "left",
                    Formatter: formatContent
                },
                { HeaderText: "@Lang.filename", Width: 120, Name: "Content", HeaderAlign: "center" },
                { HeaderText: "@Lang.Category", Width: 70, Name: "Category", HeaderAlign: "center" },
                { HeaderText: "@Lang.Language", Width: 70, Name: "Language", HeaderAlign: "center" },
                { HeaderText: "@Lang.Currency", Width: 70, Name: "Currency", HeaderAlign: "center" },
                { HeaderText: "@Lang.Type", Width: 50, Name: "ImageType", HeaderAlign: "center" },
                { HeaderText: "@Lang.Size", Width: 70, Name: "Size", HeaderAlign: "center" },
                { HeaderText: "@Lang.TotalRequest", Width: 60, Name: "TotalRequest", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "@Lang.LastRequest", Width: 90, Name: "LastRequestStr", HeaderAlign: "center", CellAlign: "center" },
                {
                    HeaderText: "@Lang.Action",
                    Width: 70,
                    Name: "BannerID",
                    HeaderAlign: "center",
                    CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        var removeClass = 'icon-remove';

                        if (record.TotalRequest > 0) {
                            removeClass += ' icon-white';
                        }

                        return "<a href='javascript:BannerList.editBanner({0})' title='{1}'><i class='icon-edit'></i>".format(record.BannerID, MSG.Edit) +
                            "</a>&nbsp;&nbsp;<a href='javascript:BannerList.deleteBanner({0}, \"{1}\", {2});' title='{4}'><i class='{3}'></i></a>".format(record.BannerID, record.Content, record.TotalRequest, removeClass, MSG.Remove);
                    }
                }
            ],
            showPager: true,
            customPager: true,
            allowTruncate: true,
            gridExpandHeight: 360,
            indexNumberColumn: 0,
            RowHeight: rowHeight
        };

        function rowHeight(rIndex, record) {
            return thumbnailHeight;
        }

        function formatContent(rIndex, record, cell, cellFormated) {
            var size = record.Size.split('x');
            var width = parseInt(size[0]);
            var height = parseInt(size[1]);
            var objectFormat = '';
            var imgUrl = BANNER_URL + record.Content;

            var heightRatio = thumbnailHeight / height;
            var widthRatio = thumbnailWidth / width;
            var ratio = heightRatio > widthRatio ? widthRatio : heightRatio;
            var swidth = width, sheight = height;

            if (ratio < 1) {
                swidth = parseInt(swidth * ratio);
                sheight = parseInt(sheight * ratio);
            }

            if (record.ImageType == window.MSG.Image) {
                if (record.Thumbnail) {
                    var thumbnailUrl = BANNER_URL + record.Thumbnail;
                    objectFormat = '<img style="cursor: pointer; max-width: 300px" src="{0}" alt="{1}" onclick="javascript:BannerList.viewImage(this, {2}, {3});" title="{4}" />';
                    return objectFormat.format(thumbnailUrl, imgUrl, width, height, "@Lang.ViewOriginalSize");
                } else {
                    objectFormat = '<a href="{0}" alt="{0}" onclick="javascript:BannerList.viewImage(this, {1}, {2});" title="{3}">{0}</a>';
                    return objectFormat.format(imgUrl, width, height, "@Lang.ViewOriginalSize");
                }
            } else {
                objectFormat = '<a alt="{0}" onclick="javascript:BannerList.viewFlash(this, {2}, {3});" title="{4}" style="cursor: pointer; display: block;">{1}</a>';
                var flashHtml = BannerList.createFlashHtml(imgUrl, swidth, sheight);


                return objectFormat.format(imgUrl, flashHtml, width, height, "@Lang.ViewOriginalSize");
            }
        }
    </script>
    @Scripts.Render("~/scripts/mediabannerlist")
}
