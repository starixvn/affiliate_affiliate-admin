@{
    ViewBag.Title = Lang.Adjustment;
    Layout = "~/Views/Shared/_LayoutFrame.cshtml";
}

@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.Models

@section iconcss{
    affiliate-info
}

@model Fanex.AffiliateAdmin.Models.AdjustmentViewModel

@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.AffiliateInfo, 3)
    <div class="line line-statement">
        <div class="ic-open-window" title="@Lang.FullScreen"></div>
    </div>
}

@using (Html.BeginForm("", "Adjustment", FormMethod.Post, new { @class = "iframe-content" }))
{
    @Html.ValidationSummary()
    <div class="row-fluid">
        <div class="span12">
            <fieldset>
                <legend>@Model.AffName</legend>
                <div class="clearfix"></div>
                    <table>
                        <colgroup>
                            <col width="160"/>
                            <col width="*"/>
                        </colgroup>
                        <tr>
                            <td>@Html.LabelFor(m => m.Adjustment.BalBroughtForward, Lang.BalanceForward, new { @class = "control-label" }) </td>
                            <td>@MvcHtmlString.Create(FormaterCurrency.Format(Model.Adjustment.BalBroughtForward, Model.Currency.CurrencyCode))</td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(m => m.Amount, Lang.Adjustment, new { @class = "control-label" }) </td>
                            <td>@Html.TextBox("Amount", string.Empty, new { Name = "Amount", @class = "control-text text-r" })</td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(m => m.Description, Lang.Description, new { @class = "control-label" }) </td>
                            <td>@Html.TextAreaFor(m => m.Description, new { Name = "Description", @class = "small-textarea" })</td>
                        </tr>
                        <tr>
                            <td colspan="2" class="required">
                                @string.Format(Lang.AdjustAmountUpTo, FormaterCurrency.Format(Model.Adjustment.MaxAmount, Model.Currency.CurrencyCode))
                                @RazorHelper.GetCurrencyNotification(Model.Currency)
                            </td>
                        </tr>
                    </table>
                    @Html.HiddenFor(m => m.Adjustment.MaxAmount, new { id = "MaxAmount" })
                    @Html.HiddenFor(m => m.Adjustment.BalBroughtForward, new { id = "BalanceForward" })
                    @Html.Hidden("InvalidAmount", ErrorMsg.Msg1011, new { id = "InvalidAmount" })
            </fieldset>
        </div>
    </div>
    
    <div class="row-fluid row-form btn-action">
        <div class="span12">
            <button type="submit" class="btn" id="btnSubmit">@Lang.Submit</button>
        </div>
    </div>
}
@section scripts{
    <script src="~/Scripts/site/Adjustment.js" type="text/javascript"></script>
    @if (ViewBag.Result != null)
    {
        var result = (ResultViewModel)ViewBag.Result;
        if (result.ErrorCode == 0)
        {
            <script type="text/javascript">
                AFFILIATE.showUpdateStatus(@(result.ErrorCode), "@result.Message", top.AFFMASTER.reloadAffInfo());
                ADJUST.hideMsg();
            </script>
        }
        else
        {
            <script type="text/javascript">
                AFFILIATE.showUpdateStatus(@(result.ErrorCode), "@result.Message", ADJUST.hideMsg);
            </script>
        }
    }
}