@using Fanex.AffiliateAdmin.Core.Configurations
@{
    var currentSession = SessionManager.CurrentSession;
    var appSetting = DependencyResolver.Current.GetService<IAppSetting>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="@Url.RenderLink(string.Format("~/www/dist/style/{0}/assets/static/favicon.jpg", appSetting.Layout))" rel="shortcut icon" type="image/jpg" />
    <meta name="viewport" content="width=device-width" />
    <link href="@Url.RenderLink("~/www/dist/style/jquery-ui.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.RenderLink("~/www/dist/style/bootstrap.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.RenderLink("~/www/dist/style/common-pages.css")" rel="stylesheet" type="text/css" />
    @RenderSection("css", required: false)
</head>
<body>
    @Html.Hidden("IsIT", currentSession.IsIT ? 1 : 0)
    @Html.Hidden("BaseUrl", Url.Content("~/"))
    @Html.Hidden("TimeZone", appSetting.ServerTimeZone)
    <div class="container">
        <div class="row-fulid">
            @if (currentSession.ApplicationMode == Fanex.AffiliateAdmin.Core.Enumerations.AppMode.Self)
            {
                @Html.Partial("_Header")
            }
            <div class="span12 content narrow-padding">
                <!--content html-->
                <div class="row-fluid main-content">
                    <div class="span12">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/js")
    @if (currentSession.ApplicationMode == Fanex.AffiliateAdmin.Core.Enumerations.AppMode.Self)
    {
        @Scripts.Render("~/Scripts/site/RecheckIn.js")
    }
    else
    {
        @Scripts.Render("~/Scripts/site/_Session.js")
    }
    <script type="text/javascript">
        var Lang = {
            NoDataInfo: '@Html.Raw(Lang.NoInfo)',
            All: "@Lang.All",
            Uncheck: "@Lang.Uncheck",
            Selected: "@Lang.Selected",
            SelectAnOption: "@Lang.SelectAnOption",
            Close: "@Lang.Close",
            ChangePassword: "@Lang.ChangePassword"
        };

        $(document).ready(function () {
            $("#AffiliateInfo").addClass("active");
        });
    </script>
    @RenderSection("scripts", required: false)
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-93927620-2"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'UA-93927620-2');
    </script>
</body>
</html>
