@{
    ViewBag.Title = Lang.AffDomain;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.DTO
@section iconcss{
domain
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Domain, 0, "domain")
}
<div class="line line-affDomain">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
</div>
<div id="gridId" class="freegrid">
</div>
@section scripts{
    <script type="text/javascript">
        var gridOption = {
            showTitle: true,
            titleInfo:
            {
                text: "@Lang.AffDomain",
                customButtons: '<input type="button" name="btnAdd" value="" title="@Lang.AddAffDomain" class="btnAdd icon-add-affDomain" id="btnAddgridId">'
            },
            columns: [
                { HeaderText: "#", Width: 30, Name: "No", CellAlign: "center" },
                { HeaderText: "@Lang.Domain", Width: 250, Name: "DomainName" },
                { HeaderText: "@Lang.UpdatedBy", Width: 110, Name: "Creator" },
                { HeaderText: "@Lang.CreatedDate ", Width: 110, Name: "CreateDate", CellAlign: "center", FormatDateTime: AFFILIATE.DATE_FORMAT },
                {
                    HeaderText: "@Lang.Action",
                    Width: 50,
                    Name: "DomainID",
                    CellAlign: "center",
                    Formatter: function(rIndex, record, cell, cellFormated) {
                        return "<a title='{0}' href='javascript:DOMAIN.ShowUpdate(".format(lang.Edit) + record.DomainID + ");'><i class='icon-edit'></i></a>"
                            + "&nbsp;&nbsp;<a title='{0}' href='javascript:DOMAIN.Remove(".format(lang.Remove) + record.DomainID + ");'><i class='icon-remove'></i></a>";
                    }
                }
            ],
            showPager: true,
            gridExpandHeight: 290,
            showNumberColumn: true
        };
        var lang = {
            AddDomain: "@Lang.AddAffDomain",
            EditDomain: "@Lang.EditAffDomain",
            DeleteDomain: "@Lang.ConfirmDelAffDomain",
            Remove: '@Lang.Remove',
            Edit: '@Lang.Edit'
        };
    </script>
    <script src="~/Scripts/site/DomainAff.js" type="text/javascript"></script>
}
