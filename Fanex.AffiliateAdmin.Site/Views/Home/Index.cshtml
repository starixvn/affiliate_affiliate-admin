@{
    ViewBag.Title = Lang.HomePage;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.AffiliateAdmin.Core.Configurations
@using Fanex.AffiliateAdmin.Core.Utilities
@model Fanex.AffiliateAdmin.Models.HomeViewModel
@section iconcss{
home
}
@section submenu{
    @RazorHelper.ListSubmenu(SubMenu.Home, 0)
}
<div class="line">
    <div class="ic-reload" title="@Lang.RefreshPage">
    </div>
</div>
<!--Waiting task & Banner Statistics-->
<div class="row-fluid">
    <div class="span6">
        <table class="table table-bordered">
            <tr>
                <th colspan="4" class="l">
                    <span class="ico-home-waiting"></span>@Lang.TaskWaitingApp
                </th>
            </tr>
            <tr>
                <td>@Lang.Affiliate
                </td>
                <td>
                    <strong>@Html.ActionLink(Model.PendingAllNum.ToString(), "Index", "Affiliate", new { Status = "Pending" }, new { })</strong>
                </td>
                <td>@Lang.Payment
                </td>
                <td>
                    <strong>@Html.ActionLink(Model.PaymentReqNum.ToString(), "Index", "Payment", new { Status = "Pending" }, new { })</strong>
                </td>
            </tr>
        </table>
    </div>
    <div class="span6">
        <table class="table table-bordered">
            @{
                var count = AppSettings.AffTypes.Count();
                var span = 4 * count;
                <tr>
                    <th colspan="@span" class="l">
                        <span class="ico-home-banner"></span>@Lang.BannerStatc (@Html.Raw(string.Format(Lang.NumBannerInProgram, @Html.ActionLink(Model.BannerNum.ToString(), "BannerList", "Media"))))
                    </th>
                </tr>
                <tr>
                    <td>@Lang.NormalImageBanner
                    </td>
                    <td>
                        <strong>@Html.ActionLink(Model.ImageBannerNum.ToString(), "BannerList", "Media", new { ImageType = 1, AffType = 1 }, new { })</strong>
                    </td>
                    <td>@Lang.NormalFlashBanner
                    </td>
                    <td>
                        <strong>@Html.ActionLink(Model.FlashBannerNum.ToString(), "BannerList", "Media", new { ImageType = 2, AffType = 1 }, new { })</strong>
                    </td>
                    @if (count == 2)
                    {
                        <td>@Lang.KioskImageBanner
                        </td>
                        <td>
                            <strong>@Html.ActionLink(Model.KioskImageBannerNum.ToString(), "BannerList", "Media", new { ImageType = 1, AffType = 3 }, new { })</strong>
                        </td>
                        <td>@Lang.KioskFlashBanner
                        </td>
                        <td>
                            <strong>@Html.ActionLink(Model.KioskFlashBannerNum.ToString(), "BannerList", "Media", new { ImageType = 2, AffType = 3 }, new { })</strong>
                        </td>
                    }
                </tr>
            }
        </table>
    </div>
</div>
<!--Affiliate statistics for all and current month-->
<div class="row-fluid">
    <div class="span6">
        <table class="table table-bordered">
            <tr>
                <th colspan="5" class="l">
                    <span class="ico-home-statistisc-up"></span>@Lang.AffStatisticsAll
                </th>
            </tr>
            <tr>
                <td colspan="5">
                    @Html.Raw(string.Format(Lang.WeHaveAffiliates, @Model.AffInProAllNum))
                </td>
            </tr>
            <tr class="info">
                <td>
                    <strong>@Html.ActionLink(Model.PendingAllNum.ToString(), "Index", "Affiliate", new { Status = "Pending" }, new { })</strong>
                    @Lang.Pending
                </td>
                <td>
                    <strong>@Html.ActionLink(Model.ApprovedAllNum.ToString(), "Index", "Affiliate", new { Status = "Approved" }, new { })</strong>
                    @Lang.Approved
                </td>
                <td>
                    <strong>@Html.ActionLink(Model.DisapprovedAllNum.ToString(), "Index", "Affiliate", new { Status = "Disapproved" }, new { })</strong>
                    @Lang.Disapproved
                </td>
                <td>
                    <strong>@Html.ActionLink(Model.ClosedAllNum.ToString(), "Index", "Affiliate", new { Status = "Closed" }, new { })</strong>
                    @Lang.Closed
                </td>
                <td>
                    <strong>@Html.ActionLink(Model.LockedAllNum.ToString(), "Index", "Affiliate", new { Status = "LockedOut" }, new { })</strong>
                    @Lang.Locked
                </td>
            </tr>
        </table>
    </div>
    <div class="span6">
        <table class="table table-bordered">
            <tr>
                <th colspan="5" class="l">
                    <span class="ico-home-statistisc-month"></span>@Lang.AffMonthStatc
                </th>
            </tr>
            <tr>
                <td colspan="5">
                    @Html.Raw(string.Format(Lang.WeHaveAffiliates, @Model.AffInProMonthNum))
                </td>
            </tr>
            <tr class="info">
                <td>
                    <strong>@Model.PendingMonthNum</strong> @Lang.Pending
                </td>
                <td>
                    <strong>@Model.ApprovedMonthNum</strong> @Lang.Approved
                </td>
                <td>
                    <strong>@Model.DisapprovedMonthNum</strong> @Lang.Disapproved
                </td>
                <td>
                    <strong>@Model.ClosedMonthNum</strong> @Lang.Closed
                </td>
                <td>
                    <strong>@Model.LockedMonthNum</strong> @Lang.Locked
                </td>
            </tr>
        </table>
    </div>
</div>
<!--Member statistics-->
<div class="row-fluid">
    <div class="span6">
        <table class="table table-bordered table-hover table-striped">
            <tr>
                <th colspan="2" class="l">
                    <span class="ico-home-statistisc-up"></span>@Lang.MemStatAll
                </th>
            </tr>
            <tr>
                <td colspan="2">
                    <p>
                        @Html.Raw(string.Format(Lang.WeHaveMembers, Model.MemInProAllNum))
                        <br />
                        <strong>@Model.DepositMemAllNum</strong> @Lang.Deposit / <strong>@(Model.MemInProAllNum - Model.DepositMemAllNum)</strong>
                        @Lang.NonDeposit
                    </p>
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalDeposit
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.DepositAll))
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalWithdrawal
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.WithdrawalAll))
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalTurnover
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.TurnoverAll))
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalWinlost
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.WinlostAll))
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalBonus
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.BonusAll))
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalAdjustment
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.AdjustmentAll))
                </td>
            </tr>
            <tr class="info">
                <td>
                    <strong>@Lang.TotalNetWinlost</strong>
                </td>
                <td class="text-right">
                    <strong>@Html.Raw(FormaterCurrency.Format(Model.NetWinlostAll))</strong>
                </td>
            </tr>
        </table>
    </div>
    <div class="span6">
        <table class="table table-bordered table-hover table-striped">
            <tr>
                <th colspan="2" class="l">
                    <span class="ico-home-statistisc-month"></span>@Lang.MemStatcMonth
                </th>
            </tr>
            <tr>
                <td colspan="2">
                    <p>
                        @Html.Raw(string.Format(Lang.WeHaveMembers, @Model.MemInProMonthNum))
                        <br />
                        <strong>@Model.DepositMemMonthNum</strong> @Lang.Deposit / <strong>@Model.NonDepositMemMonthNum/@Model.MemInProMonthNum</strong>
                        @Lang.NonDeposit
                    </p>
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalDeposit
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.DepositMonth))
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalWithdrawal
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.WithdrawalMonth))
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalTurnover
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.TurnoverMonth))
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalWinlost
                </td>
                <td class="text-right">
                    @Html.Raw(FormaterCurrency.Format(Model.WinlostMonth))
            </tr>
            <tr>
                <td>@Lang.TotalBonus
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.BonusMonth))
                </td>
            </tr>
            <tr>
                <td>@Lang.TotalAdjustment
                </td>
                <td class="text-right">@Html.Raw(FormaterCurrency.Format(Model.AdjustmentMonth))
                </td>
            </tr>
            <tr class="info">
                <td>
                    <strong>@Lang.TotalNetWinlost</strong>
                </td>
                <td class="text-right">
                    <strong>@Html.Raw(FormaterCurrency.Format(Model.NetWinlostMonth))</strong>
                </td>
            </tr>
        </table>
    </div>
</div>
@section scripts{
    @Scripts.Render("~/scripts/dashboard")
}
