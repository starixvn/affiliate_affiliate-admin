@{
    ViewBag.Title = Lang.QualifiedMembers;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@using System.Globalization
@using Fanex.AffiliateAdmin.Core.Utilities
@using Fanex.AffiliateAdmin.DTO
@using Fanex.AffiliateAdmin.Models
@using Fanex.AffiliateAdmin.Core.Mvc
@using Fanex.AffiliateAdmin.Core.Configurations
@using System.Linq

@model IEnumerable<QualifiedMember>

@{
    var systemSettings = DependencyResolver.Current.GetService<ISystemSettings>();


    var products = ViewBag.Products as List<byte>;
    var selectedProducts = systemSettings.Products
                                      .Where(t => products.Any(p => p == t.ProductID))
                                      .ToList();
    var productCount = selectedProducts.Count;
    var rowSpan = productCount > 1 ? 2 : 1;

}

<div id="gridId" class="freegrid" colheight="200" expheight="350" style="width: 1249px;">
</div>

<div class="freegrid" style="display: block; border: 0px">
    <div class="col_header">
        <table class="grid-fixed-table col_header_content" style="width: 100%">
            <thead>
                <tr style="height: 24px">
                    <th rowspan="@rowSpan" width="60px">#</th>
                    <th rowspan="@rowSpan" width="150px">@Lang.Member</th>
                    <th rowspan="@rowSpan" width="100px">@Lang.MemberCurrency</th>
                    <th rowspan="@rowSpan">@Lang.QualifiedAmount (@ViewBag.SymbolCurrency)</th>
                    @if (productCount > 0)
                    {
                        var productName = Lang.ResourceManager.GetString(selectedProducts[0].ProductName.Replace(" ", string.Empty));
                        productName = string.IsNullOrEmpty(productName) ? selectedProducts[0].ProductName : productName;
                        var turnoverTitle = productCount > 1
                            ? string.Format("{0} ({1})", Lang.Turnover, ViewBag.SymbolCurrency)
                            : string.Format("{0} {1} ({2})", productName, Lang.Turnover, ViewBag.SymbolCurrency);

                        <th colspan="@(selectedProducts.Count())">@turnoverTitle</th>
                    }
                </tr>
                @if (productCount > 1)
                {
                    <tr style="height: 24px">
                    @foreach (var product in selectedProducts)
                    {
                        var productName = Lang.ResourceManager.GetString(product.ProductName.Replace(" ", string.Empty));
                        productName = string.IsNullOrEmpty(productName) ? product.ProductName : productName;

                        <th>@productName</th>
                    }
                    </tr>
                }
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    var colspan = 4 + productCount;
                    <tr>
                        <td class="noinfo" colspan="@colspan">@Lang.NoInfo</td>
                    </tr>
                }
                else
                {
                    var count = 1;
                    var className = string.Empty;
                    var totalData = new Dictionary<int, int>();

                    foreach (QualifiedMember member in Model)
                    {
                        className = count%2 == 1 ? "freegrid-odd" : "freegrid-even";
                        <tr class="@className" style="height: 21px">
                            <td align="center">@(count++)</td>
                            <td class="">@member.Username</td>
                            <td class="" align="center">@member.Currency</td>
                            <td class="" align="right">
                                @(ViewBag.BaseCurrency == 2 ? member.QualifiedAmount.ToString("N", CultureInfo.InvariantCulture) : member.QualifiedAmountBase.ToString("N", CultureInfo.InvariantCulture))
                            </td>
                            @foreach (var product in selectedProducts)
                            {
                                QualifiedMemberProduct memberProduct;
                                if(member.QualifiedMemberProducts.ContainsKey(product.ProductID))
                                {
                                    memberProduct = member.QualifiedMemberProducts[product.ProductID];
                                }
                                else
                                {
                                    memberProduct = new QualifiedMemberProduct();
                                }

                                var isQualified = (decimal)memberProduct.Turnover >= member.QualifiedAmount;
                                var style = isQualified ? "style=color:green" : null;
                                if (!totalData.ContainsKey(product.ProductID))
                                {
                                    totalData.Add(product.ProductID, isQualified ? 1 : 0);
                                }
                                else
                                {
                                    totalData[product.ProductID] += isQualified ? 1 : 0;
                                }

                                <td class="" width="@(selectedProducts.Count > 1 ? "100px" : "160px")" align="right" @style >
                                    @(ViewBag.BaseCurrency == 2 ? memberProduct.Turnover.ToString("N", CultureInfo.InvariantCulture) : memberProduct.TurnoverBase.ToString("N", CultureInfo.InvariantCulture))
                                </td>
                            }
                        </tr>
                    }

                    <!-- Total row -->
                    <tr class="total-whole-range" style="height: 21px; border-top: 2px solid red">
                        <td colspan="4" align="center">@Lang.TotalQM</td>
                        @foreach (var product in selectedProducts)
                        {
                            <td class="" width="100px" align="right">@totalData[product.ProductID]</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section css{
    <style>
        .box-insite
        {
            border: 1px solid #CACACA;
        }
    </style>
}