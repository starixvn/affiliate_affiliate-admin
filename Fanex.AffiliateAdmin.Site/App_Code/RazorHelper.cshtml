@helper GetMoreUrls(string moreSiteUrls)
    {
        if (!string.IsNullOrEmpty(moreSiteUrls))
        {
            var lastIndex = moreSiteUrls.Length - 1;

            moreSiteUrls = (moreSiteUrls.LastIndexOf(';') == lastIndex) ? moreSiteUrls.Remove(lastIndex) : moreSiteUrls;

            var sites = moreSiteUrls.Split(';');

            for (int index = 0; index < sites.Count(); index++)
            {
    <tr id="site_@(index + 2)">
        <td>
            <label class = "control-label" for="Affiliate_SiteURL_@(index + 2)">@(Lang.SiteUrl + " " + (index + 2).ToString())</label>
        </td>
        <td>
        </td>
        <td>
            <input type="text" class="sites more-site control-text valid" id="Affiliate_SiteURL_@(index + 2)" value="@sites[index]" />
        </td>
        <td>
            <button type="button" class="btn btn-default" onclick="AFFEDIT.delUrl(this);" style="vertical-align: top">@Lang.Delete</button>
        </td>
    </tr>
            }
        }        
}
@helper GetCurrencyNotification(string currencyCode)
{
    var currency =  AppSettings.AffSystemSupportedCurrencies.FirstOrDefault(c => c.CurrencyCode == currencyCode);
    GetCurrencyNotification(currency);
}

@helper GetCurrencyNotification(Currency currency)
    {
        if (currency != null && currency.MultipliedBy > 1)
        {
            int number = 2;
    <p>
        @string.Format(Lang.PleaseInput1For, currency.MultipliedBy.ToString(), currency.CurrencyCode,
                        FormaterCurrency.Format(number, currency.CurrencyCode),
                        FormaterCurrency.Format(number * currency.MultipliedBy, currency.CurrencyCode))
    </p>
        }
}
@helper PercentageDropDownList(decimal percent, decimal step, string className, string disabled)
    {
        decimal num = 0;
    <select style="margin-left: 10px; width: 70px" class="@className" @disabled>
        @while (num <= (decimal)1.00)
        {
            var val = string.Format("{0:0.00}", num);
            <option value="@val" @(num == percent ? "selected" : null)>@val</option>
            num += step;
        }
    </select>
}
@helper AdditionalSharingFee(string deductionName, decimal percentDeposit, decimal percentWithdrawl, string disabled)
    {
        if (deductionName.Equals("Marketing", StringComparison.OrdinalIgnoreCase) || deductionName.Equals("Odds Fee", StringComparison.OrdinalIgnoreCase))
        {
    <span>&nbsp;&nbsp;&nbsp;*&nbsp;&nbsp;&nbsp;|@Lang.Winloss|</span>
        }

        if (deductionName.Equals("PSP"))
        {
    <span>&nbsp;&nbsp;&nbsp;* ( @Lang.TotalDeposit * @PercentageDropDownList(percentDeposit, (decimal)0.01, "totaldeposit", disabled)
        + @Lang.TotalWithdrawal * @PercentageDropDownList(percentWithdrawl, (decimal)0.01, "totalwithdrawal", disabled)
        ) </span>
        }
}
