@model Fanex.AffiliateAdmin.Core.Entities.EmailTemplateInfo
<div>
    Kính gửi @(Model.FirstName),<br />
    <br />
    Chúng tôi đã nhận được yêu cầu thanh toán số @(Model.TransId) vào ngày @(Model.WinlostDate.ToString("MM/dd/yyyy")).<br />
    <br />
    Chúng tôi xin thông báo với bạn rằng yêu cầu thanh toán của bạn @(Model.Amount)
    đã được thực hiện và số tiền sẽ được gửi đến bộ phận xử lý thanh toán của bạn.<br />
    <br />
    Đây là lá thư tự động do hệ thống gửi, xin vui lòng không trả lời trực tiếp lá thư
    này.<br />
    Mọi thắc mắc xin liên hệ tới <a href="mailto:@(Model.MailContact)">@(Model.MailContact)</a><br />
    <br />
    Xin chân thành cảm ơn.<br />
    <br />
    Bộ phận liên kết @(Model.SystemName).<br />
    <a href="mailto:@(Model.MailContact)">@(Model.MailContact)</a>
</div>