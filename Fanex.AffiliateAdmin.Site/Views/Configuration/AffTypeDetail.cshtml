@{
    ViewBag.Title = Lang.UpdateAffType;
    Layout = "~/Views/Shared/_LayoutPopup.cshtml";
}
@model AffType
@using (Html.BeginForm("UpdateAffType", "Configuration", FormMethod.Post, new { @class = "form-horizontal form-popup" }))
{
    @Html.ValidationSummary()
    <div class="popup-content">
        @Html.Hidden("ID", Model.TypeID)
        <div class="control-group">
            @Html.LabelFor(m => m.Name, Lang.Name, new { @class = "control-label" })
            <div class="controls">
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                <span class="required">*</span>
            </div>
        </div>
        <div class="control-group">
            @Html.LabelFor(m => m.Description, Lang.Description, new { @class = "control-label" })
            <div class="controls">
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control medium-textarea" })
            </div>
        </div>
    </div>
    <div class="popup-footer">
        <div class="control-group">
            <div class="controls">
                <button type="submit" id="btnUpdate" class="btn">@Lang.Update</button>
                <button type="button" id="btnCancel" class="btn">@Lang.Cancel</button>
            </div>
        </div>
    </div>
}
@section scripts{
    @if (ViewBag.Result != null)
    {
        var result = (Fanex.AffiliateAdmin.Models.ResultViewModel)ViewBag.Result;
        <script type="text/javascript">
            AFFILIATE.showUpdateStatus(@result.ErrorCode, "@result.ErrorMessage", parent.AffType.ReRenderAfterPaged);
        </script>
    }
    @Scripts.Render("~/scripts/afftype")
}
